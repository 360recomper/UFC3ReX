+// UFC 3: shader_cache.bin, the D3D12-only cache the native renderer loads at run time. Game shaders
+// can't ship, so it's built on the player's machine from their own disc files. Little-endian:
+//   header   { char magic[8] = "UFCSHC01"; u32 version = 1; u32 entryCount;
+//              u64 dxilCompressedSize; u64 dxilSize; }
+//   entries  { u64 hash; u32 dxilOffset; u32 dxilSize; u32 specConstantsMask; u32 reserved; }
+//            x entryCount, sorted by hash (XXH3 of the whole container, as the cpp cache)
+//   zstd(all DXIL blobs)
+// Shaders that failed are left out (listed on stderr); the runtime logs them as misses.
+struct BinaryCacheHeader
+{
+    char magic[8];
+    uint32_t version;
+    uint32_t entryCount;
+    uint64_t dxilCompressedSize;
+    uint64_t dxilSize;
+};
+
+struct BinaryCacheEntry
+{
+    uint64_t hash;
+    uint32_t dxilOffset;
+    uint32_t dxilSize;
+    uint32_t specConstantsMask;
+    uint32_t reserved;
+};
+
+static int writeBinaryCache(const char* output, const std::map<XXH64_hash_t, RecompiledShader>& shaders)
+{
+    std::vector<BinaryCacheEntry> entries;
+    std::vector<uint8_t> dxil;
+    for (auto& [hash, shader] : shaders)
+    {
+        if (shader.dxil == nullptr)
+            continue;
+        const auto* data = reinterpret_cast<const uint8_t*>(shader.dxil->GetBufferPointer());
+        entries.push_back({ hash, uint32_t(dxil.size()), uint32_t(shader.dxil->GetBufferSize()), shader.specConstantsMask, 0 });
+        dxil.insert(dxil.end(), data, data + shader.dxil->GetBufferSize());
+    }
+
+    std::vector<uint8_t> compressed(ZSTD_compressBound(dxil.size()));
+    compressed.resize(ZSTD_compress(compressed.data(), compressed.size(), dxil.data(), dxil.size(), ZSTD_maxCLevel()));
+
+    BinaryCacheHeader header = { { 'U', 'F', 'C', 'S', 'H', 'C', '0', '1' }, 1, uint32_t(entries.size()),
+        compressed.size(), dxil.size() };
+    std::vector<uint8_t> file(sizeof(header) + entries.size() * sizeof(BinaryCacheEntry) + compressed.size());
+    memcpy(file.data(), &header, sizeof(header));
+    memcpy(file.data() + sizeof(header), entries.data(), entries.size() * sizeof(BinaryCacheEntry));
+    memcpy(file.data() + sizeof(header) + entries.size() * sizeof(BinaryCacheEntry), compressed.data(), compressed.size());
+    writeAllBytes(output, file.data(), file.size());
+
+    fmt::println("shader_cache.bin: {} of {} shaders, {} -> {} bytes, xxh3 {:016X}", entries.size(), shaders.size(),
+        dxil.size(), compressed.size(), XXH3_64bits(file.data(), file.size()));
+    return 0;
+}
+
