+
+    // UFC 3: both halves of an ALU instruction read the registers as they were before it. The scalar
+    // half is printed after the vector half, so a scalar reading the vector's destination would see
+    // the new value: hold the vector result back until ps is computed.
+    // ufc3_blood_light_fix relies on this (mul_sat r3.xyz + muls r0.x, r3.xy), as do some stock shaders.
+    const bool scalarConstOp = instr.scalarOpcode == AluScalarOpcode::Mulsc0 || instr.scalarOpcode == AluScalarOpcode::Mulsc1 ||
+        instr.scalarOpcode == AluScalarOpcode::Addsc0 || instr.scalarOpcode == AluScalarOpcode::Addsc1 ||
+        instr.scalarOpcode == AluScalarOpcode::Subsc0 || instr.scalarOpcode == AluScalarOpcode::Subsc1;
+    const uint32_t scalarTemp = scalarConstOp
+        ? ((uint32_t(instr.scalarOpcode) & 1) | (instr.src3Select << 1) | (instr.src3Swizzle & 0x3C))
+        : (instr.src3Register & 0x3F);
+    const bool deferVectorWrite = vectorWriteMask != 0 && exportRegister.empty() &&
+        instr.scalarOpcode != AluScalarOpcode::RetainPrev && (scalarConstOp || instr.src3Select) &&
+        scalarTemp == instr.vectorDest;
+    bool vectorWriteDeferred = false;
 
