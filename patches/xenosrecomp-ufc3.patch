+#ifdef REBLUE_RECOMP
+// UFC 3: on the Xenos a vertex shader starts with the vertex index in r0.x, and a vfetch reads at
+// any index a register holds. The crowd's shaders split r0.x into instance + local index and read
+// each vertex's bones at instance * bones + bone. The vfetch's format, stride and offset fields are
+// blank in the container (D3D fills them in from the vertex declaration at run time), so the draw
+// passes them in a table indexed by input location: byte offset, stride, format, stream.
+static constexpr const char* VFETCH_HELPER = R"(
+ByteAddressBuffer g_VfetchStream0 : register(t0, space6);
+ByteAddressBuffer g_VfetchStream1 : register(t1, space6);
+
+uint svrVfetchWord(uint stream, uint address)
+{
+    [branch] if (stream == 0)
+        return g_VfetchStream0.Load(address);
+    return g_VfetchStream1.Load(address);
+}
+
+// Returns what the input assembler returns for the format the declaration maps to, so the semantic
+// wrappers (swapFloats, tfetchR11G11B10, sintTexcoord) apply unchanged. The exceptions are integer
+// formats a float4 input can't take on the input assembler: those return their real values.
+float4 svrVfetch(uint slot, float index, bool rounded)
+{
+    uint4 e = g_VfetchElements[slot];
+    uint format = e.z;
+    [branch] if (format == 0)
+        return 0.0;
+    uint words = format <= 4 ? format : (format >= 13 ? 2 : 1);
+    uint i = min(uint(max(rounded ? floor(index + 0.5) : floor(index), 0.0)), 0xFFFFFFu);
+    uint a = e.x + i * e.y;
+    // Root descriptors have no bounds check.
+    [branch] if (a + words * 4 > g_VfetchStreamBytes[e.w])
+        return 0.0;
+    uint w[4] = { svrVfetchWord(e.w, a), 0, 0, 0 };
+    for (uint k = 1; k < words; ++k)
+        w[k] = svrVfetchWord(e.w, a + k * 4);
+    if (format <= 4)
+        return float4(asfloat(w[0]), asfloat(w[1]), asfloat(w[2]), format == 4 ? asfloat(w[3]) : 1.0);
+    if (format <= 7)
+    {
+        float4 b = float4(w[0] & 255, (w[0] >> 8) & 255, (w[0] >> 16) & 255, w[0] >> 24);
+        return format == 5 ? b / 255.0 : (format == 6 ? b.zyxw / 255.0 : b);
+    }
+    uint4 h = uint4(w[0] & 0xFFFF, w[0] >> 16, w[1] & 0xFFFF, w[1] >> 16);
+    float4 s = float4((int4(h) << 16) >> 16);
+    float4 v = 0.0;
+    switch (format >= 13 ? format - 5 : format)
+    {
+    case 8: v = max(s / 32767.0, -1.0); break;
+    case 9: v = float4(h) / 65535.0; break;
+    case 10: v = f16tof32(h); break;
+    case 11: v = asfloat(h); break;
+    default: v = s; break;
+    }
+    return format >= 13 ? v : float4(v.xy, 0.0, 1.0);
+}
+
+)";
+
+void ShaderRecompiler::analyzeVertexIndexUse(const be<uint32_t>* code, uint32_t size)
+{
+    union
+    {
+        ControlFlowInstruction controlFlow[2];
+        struct
+        {
+            uint32_t code0;
+            uint32_t code1;
+            uint32_t code2;
+            uint32_t code3;
+        };
+    };
+
+    bool indexWritten = false; // r0.x no longer holds the vertex index
+    auto controlFlowCode = code;
+    for (uint32_t instrAddress = 0; instrAddress < size; instrAddress += 12, controlFlowCode += 3)
+    {
+        code0 = controlFlowCode[0];
+        code1 = controlFlowCode[1] & 0xFFFF;
+        code2 = (controlFlowCode[1] >> 16) | (controlFlowCode[2] << 16);
+        code3 = controlFlowCode[2] >> 16;
+
+        for (auto& cfInstr : controlFlow)
+        {
+            switch (cfInstr.opcode)
+            {
+            case ControlFlowOpcode::Exec:
+            case ControlFlowOpcode::ExecEnd:
+            case ControlFlowOpcode::CondExec:
+            case ControlFlowOpcode::CondExecEnd:
+            case ControlFlowOpcode::CondExecPred:
+            case ControlFlowOpcode::CondExecPredEnd:
+            case ControlFlowOpcode::CondExecPredClean:
+            case ControlFlowOpcode::CondExecPredCleanEnd:
+                break;
+            default:
+                continue;
+            }
+
+            const uint32_t address = cfInstr.exec.address;
+            if (address != 0)
+                size = std::min<uint32_t>(size, address * 12);
+
+            uint32_t sequence = cfInstr.exec.sequence;
+            auto instructionCode = code + address * 3;
+            for (uint32_t i = 0; i < cfInstr.exec.count; i++, sequence >>= 2, instructionCode += 3)
+            {
+                union
+                {
+                    VertexFetchInstruction vertexFetch;
+                    TextureFetchInstruction textureFetch;
+                    AluInstruction alu;
+                    struct
+                    {
+                        uint32_t fetch0;
+                        uint32_t fetch1;
+                        uint32_t fetch2;
+                    };
+                };
+                fetch0 = instructionCode[0];
+                fetch1 = instructionCode[1];
+                fetch2 = instructionCode[2];
+
+                if ((sequence & 0x1) != 0)
+                {
+                    uint32_t dstRegister, dstSwizzle;
+                    if (vertexFetch.opcode == FetchOpcode::VertexFetch)
+                    {
+                        if (vertexFetch.srcRegister != 0 || vertexFetch.srcSwizzle != 0 || indexWritten)
+                            computedFetch = true;
+                        dstRegister = vertexFetch.dstRegister;
+                        dstSwizzle = vertexFetch.dstSwizzle;
+                    }
+                    else
+                    {
+                        dstRegister = textureFetch.dstRegister;
+                        dstSwizzle = textureFetch.dstSwizzle;
+                    }
+                    if (dstRegister == 0 && (dstSwizzle & 0x7) != 0x7)
+                        indexWritten = true;
+                }
+                else
+                {
+                    if (!indexWritten)
+                    {
+                        const auto reads = [](uint32_t reg, uint32_t select, uint32_t swizzle)
+                            {
+                                if (select == 0 || (reg & 0x3F) != 0)
+                                    return false;
+                                for (uint32_t k = 0; k < 4; k++)
+                                {
+                                    if ((((swizzle >> (k * 2)) + k) & 0x3) == 0)
+                                        return true;
+                                }
+                                return false;
+                            };
+                        if (reads(alu.src1Register, alu.src1Select, alu.src1Swizzle) ||
+                            reads(alu.src2Register, alu.src2Select, alu.src2Swizzle) ||
+                            reads(alu.src3Register, alu.src3Select, alu.src3Swizzle))
+                            usesVertexId = true;
+                    }
+                    if (!alu.exportData &&
+                        ((alu.vectorDest == 0 && (alu.vectorWriteMask & 1) != 0) ||
+                         (alu.scalarDest == 0 && (alu.scalarWriteMask & 1) != 0)))
+                        indexWritten = true;
+                }
+            }
+        }
+    }
+
+    if (computedFetch)
+        usesVertexId = true;
+}
