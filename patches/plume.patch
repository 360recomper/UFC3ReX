diff --git a/plume_d3d12.cpp b/plume_d3d12.cpp
index dcae4e3..8d7d23d 100644
--- a/plume_d3d12.cpp
+++ b/plume_d3d12.cpp
@@ -484,7 +484,8 @@ namespace plume {
         case RenderHeapType::READBACK:
             return D3D12_HEAP_TYPE_READBACK;
         case RenderHeapType::GPU_UPLOAD:
-            return D3D12_HEAP_TYPE_GPU_UPLOAD;
+            // D3D12_HEAP_TYPE_GPU_UPLOAD, by value: the constant needs Windows SDK 10.0.26100+ headers.
+            return static_cast<D3D12_HEAP_TYPE>(5);
         default:
             assert(false && "Unknown heap type.");
             return D3D12_HEAP_TYPE_DEFAULT;
@@ -1899,7 +1900,12 @@ namespace plume {
         // It's required to reset the sample positions before the command list ends.
         resetSamplePositions();
 
-        d3d->Close();
+        // A list the runtime rejected here only shows up as a removed device at the next present.
+        const HRESULT res = d3d->Close();
+        if (FAILED(res)) {
+            fprintf(stderr, "ID3D12GraphicsCommandList::Close failed with error code 0x%lX.\n", res);
+        }
+
         open = false;
         targetFramebuffer = nullptr;
         targetFramebufferSamplePositionsSet = false;
@@ -2322,7 +2328,12 @@ namespace plume {
 
         const D3D12_TEXTURE_COPY_LOCATION copyDstLocation = toD3D12(dstLocation);
         const D3D12_TEXTURE_COPY_LOCATION copySrcLocation = toD3D12(srcLocation);
-        setSamplePositions(dstLocation.texture);
+        // UFC: a copy into a buffer (a readback) has no destination texture; the source's sample
+        // positions are the ones that count there.
+        const RenderTexture *positionsTexture = (dstLocation.texture != nullptr) ? dstLocation.texture : srcLocation.texture;
+        if (positionsTexture != nullptr) {
+            setSamplePositions(positionsTexture);
+        }
         d3d->CopyTextureRegion(&copyDstLocation, dstX, dstY, dstZ, &copySrcLocation, (srcBox != nullptr) ? &copyBox : nullptr);
         resetSamplePositions();
     }
@@ -2945,6 +2956,8 @@ namespace plume {
         }
 
         poolDesc.MinBlockCount = desc.minBlockCount;
+        poolDesc.BlockSize = desc.blockSize;
+        poolDesc.HeapFlags |= desc.onlyRenderTargets ? (D3D12_HEAP_FLAG_ALLOW_ONLY_RT_DS_TEXTURES | D3D12_HEAP_FLAG_CREATE_NOT_ZEROED) : D3D12_HEAP_FLAG_NONE;
         poolDesc.MaxBlockCount = desc.maxBlockCount;
         poolDesc.Flags |= desc.useLinearAlgorithm ? D3D12MA::POOL_FLAG_ALGORITHM_LINEAR : D3D12MA::POOL_FLAG_NONE;
         poolDesc.HeapFlags |= desc.allowOnlyBuffers ? D3D12_HEAP_FLAG_ALLOW_ONLY_BUFFERS : D3D12_HEAP_FLAG_NONE;
@@ -3153,6 +3166,7 @@ namespace plume {
         psoDesc.DepthStencilState.DepthWriteMask = desc.depthWriteEnabled ? D3D12_DEPTH_WRITE_MASK_ALL : D3D12_DEPTH_WRITE_MASK_ZERO;
         psoDesc.DepthStencilState.DepthFunc = toD3D12(desc.depthFunction);
         psoDesc.DepthStencilState.StencilEnable = desc.stencilEnabled;
+        stencilRef = desc.stencilEnabled ? desc.stencilReference : 0;
         psoDesc.DepthStencilState.StencilReadMask = desc.stencilReadMask;
         psoDesc.DepthStencilState.StencilWriteMask = desc.stencilWriteMask;
         psoDesc.DepthStencilState.FrontFace.StencilFailOp = toD3D12(desc.stencilFrontFace.failOp);
