+struct ResolveLogRange {
+  uint32_t start = 0;
+  uint32_t end = 0;
+};
+
+const ResolveLogRange& GetResolveLogRange() {
+  static const ResolveLogRange range = []() {
+    ResolveLogRange parsed;
+    const std::string& value = REXCVAR_GET(resolve_log_range);
+    size_t dash = value.find('-');
+    if (dash == std::string::npos) {
+      return parsed;
+    }
+    uint32_t start = uint32_t(std::strtoul(value.substr(0, dash).c_str(), nullptr, 16));
+    uint32_t end = uint32_t(std::strtoul(value.substr(dash + 1).c_str(), nullptr, 16));
+    if (end > start) {
+      parsed.start = start;
+      parsed.end = end;
+      REXGPU_INFO("resolve_log_range: logging resolves into {:08X}..{:08X}", start, end);
+    }
+    return parsed;
+  }();
+  return range;
+}
+
+// Unique context lines since the previous resolve, with repeat counts.
+std::mutex resolve_log_range_mutex;
+std::vector<std::pair<std::string, uint32_t>> resolve_log_range_context;
+bool resolve_log_range_context_overflow = false;
+std::atomic<bool> resolve_log_range_last_in_range{false};
+std::atomic<uint32_t> resolve_log_range_resolve_count{0};
+std::atomic<uint32_t> resolve_log_range_context_count{0};
+
+// Called by GetResolveInfo for every resolve: prints the context if the
+// destination overlaps the range, drops it otherwise.
+void ResolveLogRangeOnResolve(uint32_t extent_start, uint32_t extent_end,
+                              const std::string& resolve_line) {
+  const ResolveLogRange& range = GetResolveLogRange();
+  std::vector<std::pair<std::string, uint32_t>> context;
+  bool overflow;
+  {
+    std::lock_guard<std::mutex> lock(resolve_log_range_mutex);
+    context.swap(resolve_log_range_context);
+    overflow = resolve_log_range_context_overflow;
+    resolve_log_range_context_overflow = false;
+  }
+  bool in_range = extent_end > range.start && extent_start < range.end &&
+                  resolve_log_range_resolve_count.fetch_add(1) < 512;
+  resolve_log_range_last_in_range = in_range;
+  if (!in_range) {
+    return;
+  }
+  for (const auto& line : context) {
+    // Bounded across the whole run, the resolve lines themselves are not.
+    if (resolve_log_range_context_count.fetch_add(1) >= 8192) {
+      break;
+    }
+    REXGPU_WARN("Range resolve context: {} (x{})", line.first, line.second);
+  }
+  if (overflow) {
+    REXGPU_WARN("Range resolve context: more than 64 unique lines, rest dropped");
+  }
+  REXGPU_WARN("Range resolve: {}", resolve_line);
+}
+
+}  // namespace
+
+bool IsResolveLogRangeEnabled() { return GetResolveLogRange().end != 0; }
+
+void NoteResolveLogRangeContext(std::string line) {
+  if (!IsResolveLogRangeEnabled()) {
+    return;
+  }
+  std::lock_guard<std::mutex> lock(resolve_log_range_mutex);
+  for (auto& existing : resolve_log_range_context) {
+    if (existing.first == line) {
+      ++existing.second;
+      return;
+    }
+  }
+  if (resolve_log_range_context.size() >= 64) {
+    resolve_log_range_context_overflow = true;
+    return;
+  }
+  resolve_log_range_context.emplace_back(std::move(line), 1);
+}
+
+void NoteResolveLogRangeSource(const std::string& line) {
+  if (!IsResolveLogRangeEnabled() || !resolve_log_range_last_in_range) {
+    return;
+  }
+  REXGPU_WARN("Range resolve source: {}", line);
+}
+
+void NoteResolveLogRangeDraw(const RegisterFile& regs, const Shader* vertex_shader,
+                             const Shader* pixel_shader) {
+  if (!IsResolveLogRangeEnabled()) {
+    return;
+  }
+  auto surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  auto window_scissor_tl = regs.Get<reg::PA_SC_WINDOW_SCISSOR_TL>();
+  auto window_scissor_br = regs.Get<reg::PA_SC_WINDOW_SCISSOR_BR>();
+  auto window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+  auto depth_info = regs.Get<reg::RB_DEPTH_INFO>();
+  auto depth_control = regs.Get<reg::RB_DEPTHCONTROL>();
+  std::string targets;
+  uint32_t color_mask = regs[XE_GPU_REG_RB_COLOR_MASK];
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    if (!((color_mask >> (4 * i)) & 0xF)) {
+      continue;
+    }
+    auto color_info =
+        regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[i]);
+    targets += fmt::format(" color{} base {} format {} mask {:X}", i,
+                           uint32_t(color_info.color_base), uint32_t(color_info.color_format),
+                           (color_mask >> (4 * i)) & 0xF);
+  }
+  std::string textures;
+  if (pixel_shader) {
+    for (const Shader::TextureBinding& binding : pixel_shader->texture_bindings()) {
+      xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(binding.fetch_constant);
+      textures += fmt::format(" tf{} {:08X} {}x{} f{} t{}", binding.fetch_constant,
+                              uint32_t(fetch.base_address) << 12, fetch.size_2d.width + 1,
+                              fetch.size_2d.height + 1, uint32_t(fetch.format),
+                              uint32_t(fetch.tiled));
+    }
+  }
+  NoteResolveLogRangeContext(fmt::format(
+      "Draw: VS {:016X} PS {:016X} edram_mode {} pitch {} msaa {}{} depth base {} format {} "
+      "z/stencil {}{} scissor TL ({}, {}) BR ({}, {}) offset_disable {} window offset ({}, {}) "
+      "textures:{}",
+      vertex_shader ? vertex_shader->ucode_data_hash() : 0,
+      pixel_shader ? pixel_shader->ucode_data_hash() : 0,
+      uint32_t(regs.Get<reg::RB_MODECONTROL>().edram_mode), uint32_t(surface_info.surface_pitch),
+      uint32_t(surface_info.msaa_samples), targets, uint32_t(depth_info.depth_base),
+      uint32_t(depth_info.depth_format), uint32_t(depth_control.z_enable),
+      uint32_t(depth_control.stencil_enable), uint32_t(window_scissor_tl.tl_x),
+      uint32_t(window_scissor_tl.tl_y), uint32_t(window_scissor_br.br_x),
+      uint32_t(window_scissor_br.br_y), uint32_t(window_scissor_tl.window_offset_disable),
+      int32_t(window_offset.window_x_offset), int32_t(window_offset.window_y_offset),
+      textures.empty() ? " none" : textures));
+}
