+void VulkanCommandProcessor::LogBlackFrameDumpResolveValues(uint32_t written_address,
+                                                            uint32_t written_length) {
+  draw_util::BlackFrameDumpResolve resolve;
+  if (!draw_util::IsBlackFrameDumpActive() || !written_length ||
+      !draw_util::GetBlackFrameDumpResolve(resolve) ||
+      !draw_util::IsBlackFrameDumpFloatFormat(resolve.dest_format)) {
+    return;
+  }
+  const FormatInfo* format_info = FormatInfo::Get(resolve.dest_format);
+  uint32_t pixel_size_log2 = 0;
+  while ((uint32_t(8) << pixel_size_log2) < format_info->bits_per_pixel) {
+    ++pixel_size_log2;
+  }
+  // The center sample (no box filter) keeps a lone NaN / Inf texel visible.
+  const char* failure_reason;
+  const uint8_t* data =
+      ReadBackGpuRange(written_address, written_length, pixel_size_log2,
+                       texture_cache_->IsDrawResolutionScaled(), false, failure_reason);
+  if (!data) {
+    draw_util::NoteBlackFrameDumpLine(
+        fmt::format("Float resolve values: dest {:08X} ({} bytes) {}: readback failed ({})",
+                    written_address, written_length, format_info->name,
+                    failure_reason ? failure_reason : "?"));
+    return;
+  }
+  resolve.dest_start = written_address;
+  draw_util::LogBlackFrameDumpFloatCounts(resolve, data, written_length);
+}
+
+void VulkanCommandProcessor::SampleBlackFrame(VkImage image, VkFormat format, uint32_t width,
+                                              uint32_t height) {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+
+  // Read the samples of earlier frames whose submissions have completed, in
+  // frame order.
+  uint64_t completed_submission = GetCompletedSubmission();
+  while (true) {
+    BlackFrameSampleSlot* oldest = nullptr;
+    for (BlackFrameSampleSlot& slot : black_frame_sample_slots_) {
+      if (slot.frame && slot.submission <= completed_submission &&
+          (!oldest || slot.frame < oldest->frame)) {
+        oldest = &slot;
+      }
+    }
+    if (!oldest) {
+      break;
+    }
+    VkMappedMemoryRange range = {};
+    range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+    range.memory = black_frame_sample_memory_;
+    range.offset = 0;
+    range.size = VK_WHOLE_SIZE;
+    dfn.vkInvalidateMappedMemoryRanges(device, 1, &range);
+    const uint32_t* texels = reinterpret_cast<const uint32_t*>(
+        static_cast<const uint8_t*>(black_frame_sample_mapping_) +
+        size_t(oldest - black_frame_sample_slots_) * kBlackFrameSampleSlotSize);
+    float mean = 0.0f;
+    uint32_t black_count = 0;
+    for (uint32_t i = 0; i < kBlackFrameSampleCount; ++i) {
+      uint32_t texel = texels[i];
+      float r, g, b;
+      if (oldest->is_10bpc) {
+        r = float(texel & 0x3FF) / 1023.0f;
+        g = float((texel >> 10) & 0x3FF) / 1023.0f;
+        b = float((texel >> 20) & 0x3FF) / 1023.0f;
+      } else {
+        r = float(texel & 0xFF) / 255.0f;
+        g = float((texel >> 8) & 0xFF) / 255.0f;
+        b = float((texel >> 16) & 0xFF) / 255.0f;
+      }
+      // Symmetric in red and blue, which a BGRA source swaps.
+      float luminance = (r + 2.0f * g + b) * 0.25f;
+      mean += luminance;
+      if (luminance < draw_util::kBlackFrameBlackLuminance) {
+        ++black_count;
+      }
+    }
+    draw_util::OnBlackFrameSample(oldest->frame, mean / float(kBlackFrameSampleCount),
+                                  float(black_count) / float(kBlackFrameSampleCount));
+    oldest->frame = 0;
+  }
+
+  if (image == VK_NULL_HANDLE || !width || !height) {
+    return;
+  }
+  bool is_10bpc;
+  switch (format) {
+    case VK_FORMAT_R8G8B8A8_UNORM:
+    case VK_FORMAT_B8G8R8A8_UNORM:
+    case VK_FORMAT_R8G8B8A8_SRGB:
+    case VK_FORMAT_B8G8R8A8_SRGB:
+      is_10bpc = false;
+      break;
+    case VK_FORMAT_A2B10G10R10_UNORM_PACK32:
+    case VK_FORMAT_A2R10G10B10_UNORM_PACK32:
+      is_10bpc = true;
+      break;
+    default: {
+      static bool unsupported_logged = false;
+      if (!unsupported_logged) {
+        unsupported_logged = true;
+        REXGPU_WARN("black_frame_detect: swap texture host format {} is not sampled",
+                    uint32_t(format));
+      }
+      return;
+    }
+  }
+  if (black_frame_sample_buffer_ == VK_NULL_HANDLE) {
+    if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+            vulkan_device, kBlackFrameSampleSlotSize * kMaxFramesInFlight,
+            VK_BUFFER_USAGE_TRANSFER_DST_BIT, ui::vulkan::util::MemoryPurpose::kReadback,
+            black_frame_sample_buffer_, black_frame_sample_memory_)) {
+      REXGPU_ERROR("black_frame_detect: failed to create the sample buffer");
+      return;
+    }
+    if (dfn.vkMapMemory(device, black_frame_sample_memory_, 0, VK_WHOLE_SIZE, 0,
+                        &black_frame_sample_mapping_) != VK_SUCCESS) {
+      REXGPU_ERROR("black_frame_detect: failed to map the sample buffer");
+      DestroyBlackFrameSampleBuffer();
+      return;
+    }
+    REXGPU_INFO("black_frame_detect: sampling 16x16 texels of each presented frame");
+  }
+  // A slot still in flight (shouldn't happen past kMaxFramesInFlight) drops
+  // this frame's sample.
+  BlackFrameSampleSlot* free_slot = nullptr;
+  for (BlackFrameSampleSlot& slot : black_frame_sample_slots_) {
+    if (!slot.frame) {
+      free_slot = &slot;
+      break;
+    }
+  }
+  if (!free_slot) {
+    return;
+  }
+  uint32_t slot_index = uint32_t(free_slot - black_frame_sample_slots_);
+
+  // RequestSwapTexture left the image in the swap-sampled layout (the barrier
+  // may still be pending).
+  VkImageSubresourceRange subresource_range = ui::vulkan::util::InitializeSubresourceRange();
+  constexpr VkPipelineStageFlags kSwapSampledStages =
+      VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT;
+  PushImageMemoryBarrier(image, subresource_range, kSwapSampledStages,
+                         VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_SHADER_READ_BIT,
+                         VK_ACCESS_TRANSFER_READ_BIT, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+                         VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  SubmitBarriers(true);
+  VkBufferImageCopy* regions = deferred_command_buffer_.CmdCopyImageToBufferEmplace(
+      image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, black_frame_sample_buffer_,
+      kBlackFrameSampleCount);
+  for (uint32_t y = 0; y < kBlackFrameSampleGrid; ++y) {
+    for (uint32_t x = 0; x < kBlackFrameSampleGrid; ++x) {
+      VkBufferImageCopy& region = regions[y * kBlackFrameSampleGrid + x];
+      region = {};
+      region.bufferOffset =
+          VkDeviceSize(slot_index) * kBlackFrameSampleSlotSize +
+          sizeof(uint32_t) * (y * kBlackFrameSampleGrid + x);
+      region.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+      region.imageSubresource.mipLevel = 0;
+      region.imageSubresource.baseArrayLayer = 0;
+      region.imageSubresource.layerCount = 1;
+      region.imageOffset.x = int32_t((2 * x + 1) * width / (2 * kBlackFrameSampleGrid));
+      region.imageOffset.y = int32_t((2 * y + 1) * height / (2 * kBlackFrameSampleGrid));
+      region.imageExtent.width = 1;
+      region.imageExtent.height = 1;
+      region.imageExtent.depth = 1;
+    }
+  }
+  PushImageMemoryBarrier(image, subresource_range, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                         kSwapSampledStages, VK_ACCESS_TRANSFER_READ_BIT,
+                         VK_ACCESS_SHADER_READ_BIT, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                         VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  PushBufferMemoryBarrier(black_frame_sample_buffer_,
+                          VkDeviceSize(slot_index) * kBlackFrameSampleSlotSize,
+                          kBlackFrameSampleSlotSize, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                          VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+                          VK_ACCESS_HOST_READ_BIT);
+  free_slot->frame = frame_current_;
+  free_slot->submission = GetCurrentSubmission();
+  free_slot->is_10bpc = is_10bpc;
+}
+
+void VulkanCommandProcessor::DestroyBlackFrameSampleBuffer() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  if (black_frame_sample_mapping_ && black_frame_sample_memory_ != VK_NULL_HANDLE) {
+    dfn.vkUnmapMemory(device, black_frame_sample_memory_);
+  }
+  black_frame_sample_mapping_ = nullptr;
+  if (black_frame_sample_buffer_ != VK_NULL_HANDLE) {
+    dfn.vkDestroyBuffer(device, black_frame_sample_buffer_, nullptr);
+    black_frame_sample_buffer_ = VK_NULL_HANDLE;
+  }
+  if (black_frame_sample_memory_ != VK_NULL_HANDLE) {
+    dfn.vkFreeMemory(device, black_frame_sample_memory_, nullptr);
+    black_frame_sample_memory_ = VK_NULL_HANDLE;
+  }
+  for (BlackFrameSampleSlot& slot : black_frame_sample_slots_) {
+    slot = {};
+  }
+}
