diff --git a/src/graphics/util/draw_trace.cpp b/src/graphics/util/draw_trace.cpp
new file mode 100644
index 0000000..4786e32
--- /dev/null
+++ b/src/graphics/util/draw_trace.cpp
@@ -0,0 +1,398 @@
+/**
+ * @file        draw_trace.cpp
+ * @brief       trace_draw_ps: per-draw shader constants of chosen pixel shaders.
+ */
+
+#include <rex/graphics/util/draw_trace.h>
+
+#include <algorithm>
+#include <cctype>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include <fmt/format.h>
+
+#include <rex/cvar.h>
+#include <rex/graphics/pipeline/shader/shader.h>
+#include <rex/graphics/registers.h>
+#include <rex/graphics/xenos.h>
+#include <rex/logging.h>
+
+REXCVAR_DEFINE_STRING(trace_draw_ps, "", "GPU",
+                      "Pixel shader hashes or hash prefixes (hex, comma separated, e.g. "
+                      "9796F3AC,7B7BD1AC): during trace_draw_frames frames, log every draw of "
+                      "them (VS / PS hash, indices, index / vertex buffers, textures, the PS and "
+                      "VS float constants and bool constants the shaders read; later draws of a "
+                      "shader in the frame print only the constants that differ from its first "
+                      "draw), then a per-shader summary of the constants that varied");
+
+REXCVAR_DEFINE_INT32(trace_draw_frames, 2, "GPU",
+                     "trace_draw_ps: frames per capture")
+    .range(1, 1000);
+
+REXCVAR_DEFINE_INT32(trace_draw_start, 0, "GPU",
+                     "trace_draw_ps: frames to wait, after a listed shader first draws, before "
+                     "the first capture")
+    .range(0, 1000000);
+
+REXCVAR_DEFINE_INT32(trace_draw_every, 0, "GPU",
+                     "trace_draw_ps: frames from one capture start to the next (0 = one capture)")
+    .range(0, 1000000);
+
+REXCVAR_DEFINE_INT32(trace_draw_captures, 16, "GPU",
+                     "trace_draw_ps: how many captures at most (with trace_draw_every)")
+    .range(1, 100000);
+
+namespace rex::graphics::draw_trace {
+
+namespace {
+
+constexpr uint32_t kFloatConstants = 256;
+
+struct ShaderConstants {
+  uint64_t shader_hash = 0;
+  uint32_t floats[kFloatConstants * 4];
+  uint64_t used[kFloatConstants / 64] = {};
+  uint64_t varied[kFloatConstants / 64] = {};
+};
+
+// The first draw of one pixel shader in the captured frame, and what changed
+// in the later ones.
+struct PsFrameState {
+  uint32_t draws = 0;
+  uint32_t first_draw = 0;
+  ShaderConstants ps;
+  ShaderConstants vs;
+  uint32_t vs_other_hashes = 0;
+  uint32_t bools[8];
+  uint32_t bools_used[8] = {};
+  uint32_t bools_varied[8] = {};
+};
+
+struct Tracer {
+  bool parsed = false;
+  std::vector<std::string> prefixes;
+  std::unordered_map<uint64_t, bool> listed_cache;
+  uint64_t frame = 0;
+  uint64_t first_seen_frame = 0;
+  bool capturing = false;
+  uint32_t capture = 0;
+  uint32_t capture_frame = 0;
+  uint32_t draw_in_frame = 0;
+  uint32_t logged_in_frame = 0;
+  // Pixel shaders in first-draw order.
+  std::vector<uint64_t> frame_order;
+  std::unordered_map<uint64_t, std::unique_ptr<PsFrameState>> frame_states;
+};
+
+Tracer& GetTracer() {
+  static Tracer tracer;
+  return tracer;
+}
+
+void Parse(Tracer& tracer) {
+  if (tracer.parsed) {
+    return;
+  }
+  tracer.parsed = true;
+  const std::string& list = REXCVAR_GET(trace_draw_ps);
+  size_t start = 0;
+  while (start <= list.size()) {
+    size_t end = list.find_first_of(",; ", start);
+    if (end == std::string::npos) {
+      end = list.size();
+    }
+    std::string item = list.substr(start, end - start);
+    if (item.size() > 2 && item[0] == '0' && (item[1] == 'x' || item[1] == 'X')) {
+      item = item.substr(2);
+    }
+    bool valid = !item.empty() && item.size() <= 16;
+    for (char& c : item) {
+      if (!std::isxdigit(uint8_t(c))) {
+        valid = false;
+      }
+      c = char(std::toupper(uint8_t(c)));
+    }
+    if (valid) {
+      tracer.prefixes.push_back(item);
+    } else if (!item.empty()) {
+      REXGPU_WARN("trace_draw_ps: ignoring \"{}\"", item);
+    }
+    start = end + 1;
+  }
+  if (!tracer.prefixes.empty()) {
+    REXGPU_WARN(
+        "trace_draw_ps: {} shader(s), {} frame(s) per capture, start {} frames after the first "
+        "draw, every {} frames, up to {} captures",
+        tracer.prefixes.size(), REXCVAR_GET(trace_draw_frames), REXCVAR_GET(trace_draw_start),
+        REXCVAR_GET(trace_draw_every), REXCVAR_GET(trace_draw_captures));
+  }
+}
+
+bool IsListed(Tracer& tracer, uint64_t hash) {
+  auto it = tracer.listed_cache.find(hash);
+  if (it != tracer.listed_cache.end()) {
+    return it->second;
+  }
+  std::string hex = fmt::format("{:016X}", hash);
+  bool listed = false;
+  for (const std::string& prefix : tracer.prefixes) {
+    if (hex.compare(0, prefix.size(), prefix) == 0) {
+      listed = true;
+      break;
+    }
+  }
+  tracer.listed_cache.emplace(hash, listed);
+  return listed;
+}
+
+float AsFloat(uint32_t value) {
+  float f;
+  std::memcpy(&f, &value, sizeof(f));
+  return f;
+}
+
+std::string FormatFloat4(uint32_t index, const uint32_t* value) {
+  return fmt::format(" c{}=({:.4g},{:.4g},{:.4g},{:.4g})", index, AsFloat(value[0]),
+                     AsFloat(value[1]), AsFloat(value[2]), AsFloat(value[3]));
+}
+
+// Reads the float constants the shader uses from the register file; compares
+// them to the shader's first draw when one is given.
+std::string ReadFloatConstants(const RegisterFile& regs, const Shader& shader, uint32_t base_reg,
+                               ShaderConstants& current, ShaderConstants* first) {
+  const Shader::ConstantRegisterMap& map = shader.constant_register_map();
+  std::string out;
+  for (uint32_t i = 0; i < kFloatConstants; ++i) {
+    if (!(map.float_bitmap[i / 64] & (uint64_t(1) << (i % 64)))) {
+      continue;
+    }
+    current.used[i / 64] |= uint64_t(1) << (i % 64);
+    uint32_t* value = &current.floats[i * 4];
+    std::memcpy(value, &regs.values[base_reg + i * 4], sizeof(uint32_t) * 4);
+    if (first) {
+      if (std::memcmp(value, &first->floats[i * 4], sizeof(uint32_t) * 4) == 0) {
+        continue;
+      }
+      first->varied[i / 64] |= uint64_t(1) << (i % 64);
+    }
+    out += FormatFloat4(i, value);
+  }
+  return out;
+}
+
+std::string FormatIndexList(const uint64_t* bits, uint32_t count) {
+  std::string out;
+  for (uint32_t i = 0; i < count; ++i) {
+    if (bits[i / 64] & (uint64_t(1) << (i % 64))) {
+      out += fmt::format(" c{}", i);
+    }
+  }
+  return out.empty() ? " none" : out;
+}
+
+std::string GetTexturesString(const RegisterFile& regs, const Shader* shader, const char* prefix) {
+  std::string out;
+  if (!shader) {
+    return out;
+  }
+  for (const Shader::TextureBinding& binding : shader->texture_bindings()) {
+    xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(binding.fetch_constant);
+    out += fmt::format(" {}tf{} {:08X} {}x{} fmt {} mip {}-{}", prefix, binding.fetch_constant,
+                       uint32_t(fetch.base_address) << 12, fetch.size_2d.width + 1,
+                       fetch.size_2d.height + 1, uint32_t(fetch.format),
+                       uint32_t(fetch.mip_min_level), uint32_t(fetch.mip_max_level));
+  }
+  return out;
+}
+
+void EndFrame(Tracer& tracer) {
+  for (uint64_t ps_hash : tracer.frame_order) {
+    const PsFrameState& state = *tracer.frame_states[ps_hash];
+    std::string bools;
+    for (uint32_t i = 0; i < 256; ++i) {
+      if (state.bools_varied[i / 32] & (uint32_t(1) << (i % 32))) {
+        bools += fmt::format(" b{}", i);
+      }
+    }
+    REXGPU_WARN(
+        "Draw trace {}.{} summary PS {:016X}: {} draws (first #{}); PS constants that varied:{}; "
+        "VS {:016X} constants that varied:{}{}; bools that varied:{}",
+        tracer.capture, tracer.capture_frame, ps_hash, state.draws, state.first_draw,
+        FormatIndexList(state.ps.varied, kFloatConstants), state.vs.shader_hash,
+        FormatIndexList(state.vs.varied, kFloatConstants),
+        state.vs_other_hashes
+            ? fmt::format(" ({} draws had another VS, not compared)", state.vs_other_hashes)
+            : std::string(),
+        bools.empty() ? " none" : bools);
+  }
+  REXGPU_WARN("Draw trace {}.{} (frame {}): end, {} of {} draws logged", tracer.capture,
+              tracer.capture_frame, tracer.frame, tracer.logged_in_frame, tracer.draw_in_frame);
+  tracer.frame_order.clear();
+  tracer.frame_states.clear();
+}
+
+}  // namespace
+
+void NoteDraw(const RegisterFile& regs, const Shader* vertex_shader, const Shader* pixel_shader) {
+  Tracer& tracer = GetTracer();
+  Parse(tracer);
+  if (tracer.prefixes.empty()) {
+    return;
+  }
+  ++tracer.draw_in_frame;
+  if (!pixel_shader || !vertex_shader) {
+    return;
+  }
+  uint64_t ps_hash = pixel_shader->ucode_data_hash();
+  if (!IsListed(tracer, ps_hash)) {
+    return;
+  }
+  if (!tracer.first_seen_frame) {
+    tracer.first_seen_frame = tracer.frame + 1;
+    REXGPU_WARN("trace_draw_ps: PS {:016X} first drew in frame {}", ps_hash, tracer.frame);
+  }
+  if (!tracer.capturing) {
+    return;
+  }
+  ++tracer.logged_in_frame;
+  uint32_t draw_index = tracer.draw_in_frame - 1;
+
+  std::unique_ptr<PsFrameState>& state_ptr = tracer.frame_states[ps_hash];
+  bool first = !state_ptr;
+  if (first) {
+    state_ptr = std::make_unique<PsFrameState>();
+    state_ptr->first_draw = draw_index;
+    tracer.frame_order.push_back(ps_hash);
+  }
+  PsFrameState& state = *state_ptr;
+  ++state.draws;
+  uint64_t vs_hash = vertex_shader->ucode_data_hash();
+
+  ShaderConstants ps_current;
+  std::string ps_consts = ReadFloatConstants(regs, *pixel_shader, XE_GPU_REG_SHADER_CONSTANT_256_X,
+                                             first ? state.ps : ps_current,
+                                             first ? nullptr : &state.ps);
+  std::string vs_consts;
+  bool vs_compared = first || vs_hash == state.vs.shader_hash;
+  if (first) {
+    state.vs.shader_hash = vs_hash;
+    state.ps.shader_hash = ps_hash;
+  }
+  {
+    ShaderConstants vs_current;
+    vs_consts = ReadFloatConstants(regs, *vertex_shader, XE_GPU_REG_SHADER_CONSTANT_000_X,
+                                   first ? state.vs : vs_current,
+                                   (first || !vs_compared) ? nullptr : &state.vs);
+    if (!vs_compared) {
+      ++state.vs_other_hashes;
+    }
+  }
+
+  // Bool constants either shader reads (one shared 256-bit file).
+  uint32_t bools[8];
+  std::memcpy(bools, &regs.values[XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031], sizeof(bools));
+  std::string bool_string;
+  for (uint32_t i = 0; i < 256; ++i) {
+    uint32_t bit = uint32_t(1) << (i % 32);
+    if (!((vertex_shader->constant_register_map().bool_bitmap[i / 32] |
