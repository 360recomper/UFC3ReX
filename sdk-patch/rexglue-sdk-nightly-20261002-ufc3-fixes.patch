+namespace {
+
+std::string GetTextureFetchesLogString(const RegisterFile& regs, const Shader* shader,
+                                       const char* prefix) {
+  std::string textures;
+  if (!shader) {
+    return textures;
+  }
+  for (const Shader::TextureBinding& binding : shader->texture_bindings()) {
+    xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(binding.fetch_constant);
+    const FormatInfo* format_info = FormatInfo::Get(fetch.format);
+    textures += fmt::format(" {}tf{} {:08X} {}x{} {} tiled {} endian {}", prefix,
+                            binding.fetch_constant, uint32_t(fetch.base_address) << 12,
+                            fetch.size_2d.width + 1, fetch.size_2d.height + 1,
+                            format_info ? format_info->name : "?", uint32_t(fetch.tiled),
+                            uint32_t(fetch.endianness));
+  }
+  return textures;
+}
+
+// Render targets the draw writes (with the shader's static outputs and the
+// color mask), their formats, bases, blend controls and the 0021 clamp.
+std::string GetWrittenRenderTargetsLogString(const RegisterFile& regs, const Shader* pixel_shader,
+                                             bool host_rt_path, bool with_bases,
+                                             uint32_t* clamped_mask_out) {
+  uint32_t color_mask =
+      GetNormalizedColorMask(regs, pixel_shader ? pixel_shader->writes_color_targets() : 0);
+  bool clamp_enabled = host_rt_path && IsHostRtOutputClampEnabled();
+  std::string targets;
+  uint32_t clamped_mask = 0;
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    uint32_t rt_mask = (color_mask >> (4 * i)) & 0xF;
+    if (!rt_mask) {
+      continue;
+    }
+    auto color_info = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[i]);
+    uint32_t blend_control = regs[reg::RB_BLENDCONTROL::rt_register_indices[i]] & 0x1FFF1FFF;
+    bool clamped = false;
+    if (clamp_enabled) {
+      float clamp[4];
+      clamped = RenderTargetCache::GetHostOutputClamp(color_info.color_format, blend_control,
+                                                      clamp) != 0;
+    }
+    if (clamped) {
+      clamped_mask |= uint32_t(1) << i;
+    }
+    if (with_bases) {
+      targets += fmt::format(" rt{} base {} {} mask {:X} blend {:08X} clamp {}", i,
+                             uint32_t(color_info.color_base),
+                             xenos::GetColorRenderTargetFormatName(color_info.color_format),
+                             rt_mask, blend_control, clamped ? 1 : 0);
+    } else {
+      targets += fmt::format(" rt{} {} blend {:08X}", i,
+                             xenos::GetColorRenderTargetFormatName(color_info.color_format),
+                             blend_control);
+    }
+  }
+  if (clamped_mask_out) {
+    *clamped_mask_out = clamped_mask;
+  }
+  return targets;
+}
+
+std::string GetDepthLogString(const RegisterFile& regs, bool with_base) {
+  reg::RB_DEPTHCONTROL depth_control = GetNormalizedDepthControl(regs);
+  if (!depth_control.z_enable && !depth_control.stencil_enable) {
+    return " depth off";
+  }
+  auto depth_info = regs.Get<reg::RB_DEPTH_INFO>();
+  const char* format_name =
+      xenos::GetDepthRenderTargetFormatName(xenos::DepthRenderTargetFormat(depth_info.depth_format));
+  if (with_base) {
+    return fmt::format(" depth base {} {} z {}/{} stencil {}", uint32_t(depth_info.depth_base),
+                       format_name, uint32_t(depth_control.z_enable),
+                       uint32_t(depth_control.z_write_enable),
+                       uint32_t(depth_control.stencil_enable));
+  }
+  return fmt::format(" depth {}", format_name);
+}
