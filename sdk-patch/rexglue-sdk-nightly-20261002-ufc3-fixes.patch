+void NoteBlackFrameDumpResolve(const BlackFrameDumpResolve& resolve) {
+  BlackFrameDetector& detector = GetBlackFrameDetector();
+  std::lock_guard<std::mutex> lock(detector.mutex);
+  detector.resolve = resolve;
+  detector.resolve_valid = true;
+}
+
+}  // namespace
+
+bool GetBlackFrameDumpResolve(BlackFrameDumpResolve& resolve_out) {
+  BlackFrameDetector& detector = GetBlackFrameDetector();
+  std::lock_guard<std::mutex> lock(detector.mutex);
+  if (!detector.dump_active || !detector.resolve_valid) {
+    return false;
+  }
+  detector.resolve_valid = false;
+  // Bounded: each one waits for the GPU.
+  if (detector.dump_float_readbacks.fetch_add(1) >= 64) {
+    return false;
+  }
+  resolve_out = detector.resolve;
+  return true;
+}
+
+bool IsBlackFrameDumpFloatFormat(xenos::TextureFormat format) {
+  switch (format) {
+    case xenos::TextureFormat::k_16_FLOAT:
+    case xenos::TextureFormat::k_16_16_FLOAT:
+    case xenos::TextureFormat::k_16_16_16_16_FLOAT:
+    case xenos::TextureFormat::k_32_FLOAT:
+    case xenos::TextureFormat::k_32_32_FLOAT:
+    case xenos::TextureFormat::k_32_32_32_32_FLOAT:
+      return true;
+    default:
+      return false;
+  }
+}
+
+void LogBlackFrameDumpFloatCounts(const BlackFrameDumpResolve& resolve, const uint8_t* data,
+                                  uint32_t length) {
+  bool is_half = resolve.dest_format == xenos::TextureFormat::k_16_FLOAT ||
+                 resolve.dest_format == xenos::TextureFormat::k_16_16_FLOAT ||
+                 resolve.dest_format == xenos::TextureFormat::k_16_16_16_16_FLOAT;
+  // A 64/128-bit byte swap is the 8-bit swap of each element plus a reorder of
+  // the elements, which doesn't change the counts.
+  xenos::Endian endian = xenos::Endian::kNone;
+  switch (resolve.dest_endian) {
+    case xenos::Endian128::k8in16:
+      endian = xenos::Endian::k8in16;
+      break;
+    case xenos::Endian128::k8in32:
+      endian = xenos::Endian::k8in32;
+      break;
+    case xenos::Endian128::k16in32:
+      endian = xenos::Endian::k16in32;
+      break;
+    case xenos::Endian128::k8in64:
+    case xenos::Endian128::k8in128:
+      endian = is_half ? xenos::Endian::k8in16 : xenos::Endian::k8in32;
+      break;
+    default:
+      break;
+  }
+  uint64_t nan_count = 0, inf_count = 0, negative_count = 0, total = 0;
+  float max_value = 0.0f;
+  uint32_t dword_count = length >> 2;
+  for (uint32_t i = 0; i < dword_count; ++i) {
+    uint32_t dword;
+    std::memcpy(&dword, data + i * 4, sizeof(dword));
+    dword = xenos::GpuSwap(dword, endian);
+    if (is_half) {
+      for (uint32_t half_index = 0; half_index < 2; ++half_index) {
+        uint32_t half = (dword >> (16 * half_index)) & 0xFFFF;
+        ++total;
+        if ((half & 0x7C00) == 0x7C00) {
+          if (half & 0x3FF) {
+            ++nan_count;
+          } else {
+            ++inf_count;
+          }
+        } else {
+          if ((half & 0x8000) && (half & 0x7FFF)) {
+            ++negative_count;
+          }
+          float value = std::ldexp(float((half & 0x3FF) | ((half & 0x7C00) ? 0x400 : 0)),
+                                   int((half >> 10) & 0x1F) - ((half & 0x7C00) ? 25 : 24));
+          max_value = std::max(max_value, value);
+        }
+      }
+    } else {
+      ++total;
+      if ((dword & 0x7F800000) == 0x7F800000) {
+        if (dword & 0x7FFFFF) {
+          ++nan_count;
+        } else {
+          ++inf_count;
+        }
+      } else {
+        if ((dword & 0x80000000) && (dword & 0x7FFFFFFF)) {
+          ++negative_count;
+        }
+        float value;
+        std::memcpy(&value, &dword, sizeof(value));
+        max_value = std::max(max_value, std::abs(value));
+      }
+    }
+  }
+  const FormatInfo* format_info = FormatInfo::Get(resolve.dest_format);
+  NoteBlackFrameDumpLine(fmt::format(
+      "Float resolve values: dest {:08X} ({} bytes) {} endian {}: {} values, {} NaN, {} Inf, "
+      "{} negative, largest finite magnitude {}",
+      resolve.dest_start, length, format_info ? format_info->name : "?",
+      uint32_t(resolve.dest_endian), total, nan_count, inf_count, negative_count, max_value));
+}
