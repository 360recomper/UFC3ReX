+}  // namespace
+
+void LogRenderTargetFormatCensus(const RegisterFile& regs, const Shader* vertex_shader,
+                                 const Shader* pixel_shader, bool host_rt_path) {
+  if (!REXCVAR_GET(rt_format_census)) {
+    return;
+  }
+  constexpr size_t kMaxLogged = 1024;
+  static std::mutex logged_mutex;
+  static std::unordered_set<std::string> logged;
+  static bool cap_logged = false;
+  std::string key = fmt::format(
+      "{:016X}/{:016X}{}{}", vertex_shader ? vertex_shader->ucode_data_hash() : 0,
+      pixel_shader ? pixel_shader->ucode_data_hash() : 0,
+      GetWrittenRenderTargetsLogString(regs, pixel_shader, host_rt_path, false, nullptr),
+      GetDepthLogString(regs, false));
+  {
+    std::lock_guard<std::mutex> lock(logged_mutex);
+    if (logged.size() >= kMaxLogged) {
+      if (!cap_logged) {
+        cap_logged = true;
+        REXGPU_WARN("RT census: {} combinations logged, the rest are not", kMaxLogged);
+      }
+      return;
+    }
+    if (!logged.insert(key).second) {
+      return;
+    }
+  }
+  auto surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  uint32_t clamped_mask = 0;
+  std::string targets =
+      GetWrittenRenderTargetsLogString(regs, pixel_shader, host_rt_path, true, &clamped_mask);
+  REXGPU_WARN(
+      "RT census: VS {:016X} PS {:016X} edram_mode {} pitch {} msaa {}{}{} host_rt_output_clamp "
+      "{} textures:{}{}",
+      vertex_shader ? vertex_shader->ucode_data_hash() : 0,
+      pixel_shader ? pixel_shader->ucode_data_hash() : 0,
+      uint32_t(regs.Get<reg::RB_MODECONTROL>().edram_mode), uint32_t(surface_info.surface_pitch),
+      uint32_t(surface_info.msaa_samples), targets.empty() ? " no color" : targets,
+      GetDepthLogString(regs, true),
+      !host_rt_path ? "n/a (fsi/rov)"
+                    : (clamped_mask ? fmt::format("applied (rt mask {:X})", clamped_mask)
+                                    : std::string(IsHostRtOutputClampEnabled() ? "no float rt"
+                                                                               : "off")),
+      GetTextureFetchesLogString(regs, vertex_shader, "vs "),
+      GetTextureFetchesLogString(regs, pixel_shader, ""));
+}
