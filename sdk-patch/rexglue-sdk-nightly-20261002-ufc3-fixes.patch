+      continue;
+    }
+    bool value = (bools[i / 32] & bit) != 0;
+    if (first) {
+      state.bools_used[i / 32] |= bit;
+    } else {
+      if (((state.bools[i / 32] & bit) != 0) == value) {
+        continue;
+      }
+      state.bools_varied[i / 32] |= bit;
+    }
+    bool_string += fmt::format(" b{}={}", i, value ? 1 : 0);
+  }
+  if (first) {
+    std::memcpy(state.bools, bools, sizeof(bools));
+  }
+
+  auto draw_initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  std::string index_string;
+  if (draw_initiator.source_select == xenos::SourceSelect::kDMA) {
+    index_string = fmt::format(" ib {:08X} {}-bit", regs[XE_GPU_REG_VGT_DMA_BASE],
+                               draw_initiator.index_size == xenos::IndexFormat::kInt32 ? 32 : 16);
+  } else {
+    index_string = draw_initiator.source_select == xenos::SourceSelect::kAutoIndex ? " auto"
+                                                                                   : " immediate";
+  }
+  std::string vertex_string;
+  for (const Shader::VertexBinding& binding : vertex_shader->vertex_bindings()) {
+    xenos::xe_gpu_vertex_fetch_t fetch = regs.GetVertexFetch(binding.fetch_constant);
+    vertex_string += fmt::format(" vf{} {:08X} {}B stride {}", binding.fetch_constant,
+                                 uint32_t(fetch.address) << 2, uint32_t(fetch.size) << 2,
+                                 binding.stride_words * 4);
+  }
+
+  const char* kind = first ? "all" : "diff from first";
+  REXGPU_WARN(
+      "Draw trace {}.{} #{} VS {:016X} PS {:016X} prim {} indices {}{} indx_offset {} min/max "
+      "{}/{}{} textures:{}{}",
+      tracer.capture, tracer.capture_frame, draw_index, vs_hash, ps_hash,
+      uint32_t(draw_initiator.prim_type), uint32_t(draw_initiator.num_indices), index_string,
+      uint32_t(regs.Get<reg::VGT_INDX_OFFSET>().indx_offset),
+      uint32_t(regs.Get<reg::VGT_MIN_VTX_INDX>().min_indx),
+      uint32_t(regs.Get<reg::VGT_MAX_VTX_INDX>().max_indx), vertex_string,
+      GetTexturesString(regs, vertex_shader, "vs "), GetTexturesString(regs, pixel_shader, ""));
+  REXGPU_WARN("Draw trace {}.{} #{} ps {}:{}", tracer.capture, tracer.capture_frame, draw_index,
+              kind, ps_consts.empty() ? " same" : ps_consts);
+  REXGPU_WARN("Draw trace {}.{} #{} vs {}:{}", tracer.capture, tracer.capture_frame, draw_index,
+              vs_compared ? kind : "all (another VS than the first draw's)",
+              vs_consts.empty() ? " same" : vs_consts);
+  if (!bool_string.empty() || first) {
+    REXGPU_WARN("Draw trace {}.{} #{} bools {}:{}", tracer.capture, tracer.capture_frame,
+                draw_index, kind, bool_string.empty() ? " none" : bool_string);
+  }
+}
+
+void OnFrame() {
+  Tracer& tracer = GetTracer();
+  if (!tracer.parsed || tracer.prefixes.empty()) {
+    return;
+  }
+  if (tracer.capturing) {
+    EndFrame(tracer);
+  }
+  ++tracer.frame;
+  tracer.draw_in_frame = 0;
+  tracer.logged_in_frame = 0;
+  tracer.capturing = false;
+  if (!tracer.first_seen_frame) {
+    return;
+  }
+  int64_t relative =
+      int64_t(tracer.frame) - int64_t(tracer.first_seen_frame) - REXCVAR_GET(trace_draw_start);
+  if (relative < 0) {
+    return;
+  }
+  int64_t frames = REXCVAR_GET(trace_draw_frames);
+  int64_t every = REXCVAR_GET(trace_draw_every);
+  int64_t capture = 0;
+  int64_t capture_frame = relative;
+  if (every > 0) {
+    capture = relative / every;
+    capture_frame = relative % every;
+  }
+  if (capture_frame >= frames || capture >= REXCVAR_GET(trace_draw_captures)) {
+    return;
+  }
+  tracer.capturing = true;
+  tracer.capture = uint32_t(capture);
+  tracer.capture_frame = uint32_t(capture_frame);
+  if (!capture_frame) {
+    REXGPU_WARN("Draw trace {}: begin at frame {}", tracer.capture, tracer.frame);
+  }
+}
+
+}  // namespace rex::graphics::draw_trace
diff --git a/src/graphics/util/perf_summary.cpp b/src/graphics/util/perf_summary.cpp
new file mode 100644
index 0000000..d36fdb6
--- /dev/null
+++ b/src/graphics/util/perf_summary.cpp
@@ -0,0 +1,274 @@
+/**
+ * @file        perf_summary.cpp
+ * @brief       perf_second_summary: per-second and slow-frame timing lines.
+ */
+
+#include <rex/graphics/util/perf_summary.h>
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <string_view>
+
+#include <fmt/format.h>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+REXCVAR_DEFINE_BOOL(perf_second_summary, false, "GPU",
+                    "Log once per second where the GPU thread's time went (frames, slowest "
+                    "frame, ms and count per path: on-demand readback and the guest threads it "
+                    "stopped, upscale, downscale, memexport readback, texture loads, pipeline "
+                    "creation, RT transfers, resolves, swap, full GPU waits by caller), plus a "
+                    "line for every frame slower than perf_slow_frame_ms")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+REXCVAR_DEFINE_INT32(perf_slow_frame_ms, 100, "GPU",
+                     "perf_second_summary: log a line for every frame (guest swap to swap) "
+                     "slower than this")
+    .range(1, 100000)
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+namespace rex::graphics::perf {
+
+namespace {
+
+constexpr const char* kBucketNames[size_t(Bucket::kCount)] = {
+    "ondemand readback", "guest stopped", "ahead wait",       "upscale",
+    "downscale",         "memexport rb",  "texture load",     "pipeline create",
+    "RT transfer",       "resolve",       "swap",             "GPU drain",
+};
+
+struct BucketTotals {
+  std::atomic<uint64_t> ns{0};
+  std::atomic<uint64_t> count{0};
+  // Slowest since the last summary.
+  std::atomic<uint64_t> max_ns{0};
+};
+std::array<BucketTotals, size_t(Bucket::kCount)> bucket_totals;
+
+void UpdateMax(std::atomic<uint64_t>& max, uint64_t value) {
+  uint64_t current = max.load(std::memory_order_relaxed);
+  while (value > current &&
+         !max.compare_exchange_weak(current, value, std::memory_order_relaxed)) {
+  }
+}
+
+struct AwaitCaller {
+  const char* file = nullptr;
+  uint32_t line = 0;
+  uint64_t second_ns = 0;
+  uint64_t second_count = 0;
+  uint64_t second_max_ns = 0;
+  uint64_t frame_ns = 0;
+  uint64_t frame_count = 0;
+};
+std::mutex await_mutex;
+std::array<AwaitCaller, 48> await_callers;
+size_t await_caller_count = 0;
+uint64_t await_dropped = 0;
+
+// Command processor thread only (OnFrame).
+struct Snapshot {
+  uint64_t ns[size_t(Bucket::kCount)] = {};
+  uint64_t count[size_t(Bucket::kCount)] = {};
+};
+Snapshot frame_snapshot;
+Snapshot second_snapshot;
+bool started = false;
+std::chrono::steady_clock::time_point last_frame;
+std::chrono::steady_clock::time_point second_start;
+uint64_t frame_number = 0;
+uint32_t second_frames = 0;
+double second_slowest_ms = 0.0;
+uint64_t second_slowest_frame = 0;
+uint32_t second_slow_frames = 0;
+
+Snapshot TakeSnapshot() {
+  Snapshot snapshot;
+  for (size_t i = 0; i < size_t(Bucket::kCount); ++i) {
+    snapshot.ns[i] = bucket_totals[i].ns.load(std::memory_order_relaxed);
+    snapshot.count[i] = bucket_totals[i].count.load(std::memory_order_relaxed);
+  }
+  return snapshot;
+}
+
+// "vulkan/command_processor.cpp" from a full path.
+std::string_view ShortFileName(const char* file) {
+  std::string_view path(file ? file : "?");
+  size_t last = path.find_last_of("/\\");
+  if (last == std::string_view::npos || !last) {
+    return path;
+  }
+  size_t parent = path.find_last_of("/\\", last - 1);
+  return parent == std::string_view::npos ? path : path.substr(parent + 1);
+}
+
+void AppendBuckets(std::string& line, const Snapshot& from, const Snapshot& to, bool with_max) {
+  for (size_t i = 0; i < size_t(Bucket::kCount); ++i) {
+    uint64_t count = to.count[i] - from.count[i];
+    if (!count) {
+      continue;
+    }
+    double ms = double(to.ns[i] - from.ns[i]) / 1.0e6;
+    if (with_max) {
+      double max_ms =
+          double(bucket_totals[i].max_ns.exchange(0, std::memory_order_relaxed)) / 1.0e6;
+      fmt::format_to(std::back_inserter(line), "; {} {}x {:.1f} ms (max {:.1f})", kBucketNames[i],
+                     count, ms, max_ms);
+    } else {
+      fmt::format_to(std::back_inserter(line), "; {} {}x {:.1f} ms", kBucketNames[i], count, ms);
+    }
+  }
+}
+
+}  // namespace
+
+bool IsEnabled() { return REXCVAR_GET(perf_second_summary); }
+
+void Add(Bucket bucket, std::chrono::steady_clock::duration duration) {
+  // Some callers time paths for their own logs and add unconditionally.
+  if (!IsEnabled()) {
+    return;
+  }
+  uint64_t ns = uint64_t(std::max<int64_t>(
+      0, std::chrono::duration_cast<std::chrono::nanoseconds>(duration).count()));
+  BucketTotals& totals = bucket_totals[size_t(bucket)];
+  totals.ns.fetch_add(ns, std::memory_order_relaxed);
+  totals.count.fetch_add(1, std::memory_order_relaxed);
+  UpdateMax(totals.max_ns, ns);
+}
+
+void AddAwaitAll(const std::source_location& caller,
+                 std::chrono::steady_clock::duration duration) {
+  Add(Bucket::kAwaitAll, duration);
+  uint64_t ns = uint64_t(std::max<int64_t>(
+      0, std::chrono::duration_cast<std::chrono::nanoseconds>(duration).count()));
+  std::lock_guard<std::mutex> lock(await_mutex);
+  AwaitCaller* entry = nullptr;
+  for (size_t i = 0; i < await_caller_count; ++i) {
+    if (await_callers[i].line == caller.line() &&
+        !std::strcmp(await_callers[i].file, caller.file_name())) {
+      entry = &await_callers[i];
+      break;
+    }
+  }
+  if (!entry) {
+    if (await_caller_count >= await_callers.size()) {
+      ++await_dropped;
+      return;
+    }
+    entry = &await_callers[await_caller_count++];
+    entry->file = caller.file_name();
+    entry->line = caller.line();
+  }
+  entry->second_ns += ns;
+  ++entry->second_count;
+  entry->second_max_ns = std::max(entry->second_max_ns, ns);
+  entry->frame_ns += ns;
+  ++entry->frame_count;
+}
+
+void OnFrame() {
+  if (!IsEnabled()) {
+    started = false;
+    return;
+  }
+  const auto now = std::chrono::steady_clock::now();
+  Snapshot snapshot = TakeSnapshot();
+  ++frame_number;
+  if (!started) {
+    started = true;
+    last_frame = now;
+    second_start = now;
+    frame_snapshot = snapshot;
+    second_snapshot = snapshot;
+    second_frames = 0;
+    second_slowest_ms = 0.0;
+    second_slow_frames = 0;
+    std::lock_guard<std::mutex> lock(await_mutex);
+    for (size_t i = 0; i < await_caller_count; ++i) {
+      AwaitCaller& entry = await_callers[i];
+      entry.second_ns = entry.second_count = entry.second_max_ns = 0;
+      entry.frame_ns = entry.frame_count = 0;
+    }
+    return;
+  }
+
+  const double frame_ms = std::chrono::duration<double, std::milli>(now - last_frame).count();
+  last_frame = now;
+  ++second_frames;
+  if (frame_ms > second_slowest_ms) {
+    second_slowest_ms = frame_ms;
+    second_slowest_frame = frame_number;
+  }
+  const bool slow = frame_ms > double(REXCVAR_GET(perf_slow_frame_ms));
+  if (slow) {
+    ++second_slow_frames;
+    std::string line = fmt::format("Perf slow frame {}: {:.1f} ms", frame_number, frame_ms);
+    AppendBuckets(line, frame_snapshot, snapshot, false);
+    std::lock_guard<std::mutex> lock(await_mutex);
+    for (size_t i = 0; i < await_caller_count; ++i) {
+      const AwaitCaller& entry = await_callers[i];
+      if (entry.frame_count) {
+        fmt::format_to(std::back_inserter(line), "; drain {}:{} {}x {:.1f} ms",
+                       ShortFileName(entry.file), entry.line, entry.frame_count,
+                       double(entry.frame_ns) / 1.0e6);
+      }
+    }
+    REXGPU_INFO("{}", line);
+  }
+  frame_snapshot = snapshot;
+  {
+    std::lock_guard<std::mutex> lock(await_mutex);
+    for (size_t i = 0; i < await_caller_count; ++i) {
+      await_callers[i].frame_ns = await_callers[i].frame_count = 0;
+    }
+  }
+
+  if (now - second_start < std::chrono::seconds(1)) {
+    return;
+  }
+  const double second_ms = std::chrono::duration<double, std::milli>(now - second_start).count();
+  std::string line = fmt::format(
+      "Perf {:.0f} ms: {} frames, slowest {:.1f} ms (frame {}), {} over {} ms", second_ms,
+      second_frames, second_slowest_ms, second_slowest_frame, second_slow_frames,
+      REXCVAR_GET(perf_slow_frame_ms));
+  AppendBuckets(line, second_snapshot, snapshot, true);
+  {
+    std::lock_guard<std::mutex> lock(await_mutex);
+    // Slowest callers first.
+    std::array<AwaitCaller*, 48> sorted;
+    size_t sorted_count = 0;
+    for (size_t i = 0; i < await_caller_count; ++i) {
+      if (await_callers[i].second_count) {
+        sorted[sorted_count++] = &await_callers[i];
+      }
+    }
+    std::sort(sorted.begin(), sorted.begin() + sorted_count,
+              [](const AwaitCaller* a, const AwaitCaller* b) { return a->second_ns > b->second_ns; });
+    for (size_t i = 0; i < sorted_count; ++i) {
+      AwaitCaller& entry = *sorted[i];
+      fmt::format_to(std::back_inserter(line), "; drain {}:{} {}x {:.1f} ms (max {:.1f})",
+                     ShortFileName(entry.file), entry.line, entry.second_count,
+                     double(entry.second_ns) / 1.0e6, double(entry.second_max_ns) / 1.0e6);
+      entry.second_ns = entry.second_count = entry.second_max_ns = 0;
+    }
+    if (await_dropped) {
+      fmt::format_to(std::back_inserter(line), "; {} drains from untracked callers",
+                     await_dropped);
+      await_dropped = 0;
+    }
+  }
+  REXGPU_INFO("{}", line);
+  second_snapshot = snapshot;
+  second_start = now;
+  second_frames = 0;
+  second_slowest_ms = 0.0;
+  second_slow_frames = 0;
+}
+
+}  // namespace rex::graphics::perf
