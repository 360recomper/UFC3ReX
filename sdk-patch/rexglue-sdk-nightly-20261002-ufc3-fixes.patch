+// Writes to guest physical memory through the host physical view, giving
+// pages the guest made read-only write access just for the copy.
+void WriteGuestPhysical(uint8_t* dest, const uint8_t* source, uint32_t length) {
+  const uintptr_t host_page_mask = uintptr_t(rex::memory::page_size() - 1);
+  uint32_t offset = 0;
+  while (offset < length) {
+    uint8_t* const run_dest = dest + offset;
+    rex::memory::PageAccess access;
+    size_t region_length;
+    if (!rex::memory::QueryProtect(run_dest, region_length, access)) {
+      return;
+    }
+    const uint32_t run_length = uint32_t(
+        std::min(uint64_t(region_length - (reinterpret_cast<uintptr_t>(run_dest) & host_page_mask)),
+                 uint64_t(length - offset)));
+    if (access == rex::memory::PageAccess::kReadWrite ||
+        access == rex::memory::PageAccess::kExecuteReadWrite) {
+      std::memcpy(run_dest, source + offset, run_length);
+    } else {
+      rex::memory::PageAccess old_access;
+      if (rex::memory::Protect(run_dest, run_length, rex::memory::PageAccess::kReadWrite,
+                               &old_access)) {
+        std::memcpy(run_dest, source + offset, run_length);
+        rex::memory::Protect(run_dest, run_length, old_access);
+      }
+    }
+    offset += run_length;
+  }
+}
+
+// Copies the dwords of source that differ from before (all of them without
+// before). Returns the bytes written; changed_end becomes the end offset of the
+// last write, relative to base_offset.
+uint32_t CopyChangedDwords(uint8_t* dest, const uint8_t* source, const uint8_t* before,
+                           uint32_t length, uint32_t base_offset, uint32_t& changed_end) {
+  if (!before) {
+    std::memcpy(dest, source, length);
+    if (length) {
+      changed_end = base_offset + length;
+    }
+    return length;
+  }
+  constexpr uint32_t kBlock = 64;
+  uint32_t written = 0;
+  uint32_t i = 0;
+  while (i < length) {
+    const uint32_t block_length = std::min(kBlock, length - i);
+    if (!std::memcmp(source + i, before + i, block_length)) {
+      i += block_length;
+      continue;
+    }
+    const uint32_t block_end = i + block_length;
+    for (; i + 4 <= block_end; i += 4) {
+      uint32_t source_dword, before_dword;
+      std::memcpy(&source_dword, source + i, 4);
+      std::memcpy(&before_dword, before + i, 4);
+      if (source_dword != before_dword) {
+        std::memcpy(dest + i, &source_dword, 4);
+        written += 4;
+        changed_end = base_offset + i + 4;
+      }
+    }
+    for (; i < block_end; ++i) {
+      if (source[i] != before[i]) {
+        dest[i] = source[i];
+        ++written;
+        changed_end = base_offset + i + 1;
+      }
+    }
+  }
+  return written;
+}
