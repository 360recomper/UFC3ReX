+    REXGPU_WARN(
+        "Integer fetch: {} shader {:016X} tf{} format {} ({}) sign {}{}{}{} dim {} {}x{}x{} "
+        "base {:08X} mip {:08X} tiled {} endian {} swizzle {:03X} exp_adjust {} "
+        "filter {}/{} instr {} filter {}/{} unnorm_coords {} offset {},{} host scale {}",
+        shader.type() == xenos::ShaderType::kVertex ? "vertex" : "pixel",
+        shader.ucode_data_hash(), binding.fetch_constant, format,
+        format_info ? format_info->name : "?", uint32_t(fetch.sign_x), uint32_t(fetch.sign_y),
+        uint32_t(fetch.sign_z), uint32_t(fetch.sign_w), uint32_t(fetch.dimension), width,
+        height, depth, uint32_t(fetch.base_address) << 12, uint32_t(fetch.mip_address) << 12,
+        uint32_t(fetch.tiled), uint32_t(fetch.endianness), uint32_t(fetch.swizzle),
+        int32_t(fetch.exp_adjust), uint32_t(fetch.mag_filter), uint32_t(fetch.min_filter),
+        binding.fetch_instr.opcode_name ? binding.fetch_instr.opcode_name : "?",
+        uint32_t(binding.fetch_instr.attributes.mag_filter),
+        uint32_t(binding.fetch_instr.attributes.min_filter),
+        binding.fetch_instr.attributes.unnormalized_coordinates ? 1 : 0,
+        binding.fetch_instr.attributes.offset_x, binding.fetch_instr.attributes.offset_y, scale);
+  }
