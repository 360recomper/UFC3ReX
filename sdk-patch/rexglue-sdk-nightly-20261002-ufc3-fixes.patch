+  uint scale_area = xe_downscale_scale_x * xe_downscale_scale_y;
+  uint source_byte = pixel * scale_area * 4u;
+  uint4 sum = uint4(0u, 0u, 0u, 0u);
+  [loop] for (uint i = 0u; i < scale_area; ++i) {
+    sum += (xe_resolve_source.Load(source_byte + i * 4u).xxxx >> uint4(0u, 8u, 16u, 24u)) & 0xFFu;
+  }
+  uint4 average = (sum + (scale_area >> 1u)) / scale_area;
+  xe_resolve_dest.Store(pixel << 2u,
+                        average.x | (average.y << 8u) | (average.z << 16u) | (average.w << 24u));
+}
diff --git a/src/graphics/shaders/resolve_upscale.cs.glsl b/src/graphics/shaders/resolve_upscale.cs.glsl
new file mode 100644
index 0000000..1ff4acf
--- /dev/null
+++ b/src/graphics/shaders/resolve_upscale.cs.glsl
@@ -0,0 +1,151 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2025 Ben Vanik. All rights reserved.                             *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+#version 450
+
+// Reference source: the build doesn't compile it - vulkan/texture_cache.cpp
+// holds a copy that is compiled at runtime with glslang.
+//
+// Compute shader to upscale 1x guest data into the scaled resolve buffer, the
+// inverse of resolve_downscale. In the scaled resolve buffer, the host pixels
+// of each guest pixel are stored contiguously, so the guest pixel at byte
+// offset p goes to p * scale_area + sub * pixel_size for every sub-pixel.
+// Every host pixel gets the value of its guest pixel, or, with
+// xe_upscale_filter (32bpp 8-bit-per-channel surfaces), a bilinear sample of
+// the guest surface at the host pixel center, like a 1x texture is sampled.
+// Each thread writes one destination dword.
+
+layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+layout(push_constant) uniform ResolveUpscaleConstants {
+  uint xe_upscale_scale_area;
+  uint xe_upscale_pixel_size_log2;
+  uint xe_upscale_dest_dword_first;
+  uint xe_upscale_dest_dword_count;
+  uint xe_upscale_source_offset_bytes;
+  uint xe_upscale_filter;
+  uint xe_upscale_scale_x;
+  uint xe_upscale_scale_y;
+  int xe_upscale_surface_offset_bytes;
+  uint xe_upscale_surface_pitch;
+  uint xe_upscale_surface_width;
+  uint xe_upscale_surface_height;
+  uint xe_upscale_surface_tiled;
+  uint xe_upscale_valid_first;
+  uint xe_upscale_valid_end;
+};
+layout(std430, set = 0, binding = 0) readonly buffer SourceBuffer {
+  uint data[];
+} xe_upscale_source;
+layout(std430, set = 0, binding = 1) writeonly buffer DestBuffer {
+  uint data[];
+} xe_upscale_dest;
+// 32bpp 2D tiled offset, as texture_util::GetTiledOffset2D.
+uint XeUpscaleTiledOffset(uint x, uint y) {
+  uint macro_offset = ((x >> 5u) + (y >> 5u) * (xe_upscale_surface_pitch >> 5u)) << 9u;
+  uint micro = ((x & 7u) + ((y & 0xEu) << 2u)) << 2u;
+  uint offset = macro_offset + ((micro & ~0xFu) << 1u) + (micro & 0xFu) + ((y & 1u) << 4u);
+  return ((offset & ~0x1FFu) << 3u) + ((y & 16u) << 7u) + ((offset & 0x1C0u) << 2u) +
+         (((((y & 8u) >> 2u) + (x >> 3u)) & 3u) << 6u) + (offset & 0x3Fu);
+}
+// The inverse: coordinates of the 32bpp pixel at a tiled offset.
+uvec2 XeUpscaleTiledCoords(uint r) {
+  uint offset = (r & 0x3Fu) | (((r >> 8u) & 7u) << 6u) | ((r >> 12u) << 9u);
+  uint m = ((offset & 0xFu) | (((offset >> 5u) & 0xFu) << 4u)) >> 2u;
+  uint tile = offset >> 9u;
+  uint pitch_tiles = xe_upscale_surface_pitch >> 5u;
+  uint y = (tile / pitch_tiles) * 32u + ((r >> 11u) & 1u) * 16u + (((m >> 3u) & 7u) << 1u) +
+           ((offset >> 4u) & 1u);
+  uint x = (tile % pitch_tiles) * 32u +
+           (((((r >> 6u) & 3u) + 4u - (((y >> 3u) & 1u) << 1u)) & 3u) << 3u) + (m & 7u);
+  return uvec2(x, y);
+}
+vec4 XeUpscaleUnpack(uint value) {
+  return vec4((uvec4(value) >> uvec4(0u, 8u, 16u, 24u)) & 0xFFu) * (1.0 / 255.0);
+}
+uint XeUpscalePack(vec4 value) {
+  uvec4 bytes = uvec4(round(clamp(value, 0.0, 1.0) * 255.0));
+  return bytes.x | (bytes.y << 8u) | (bytes.z << 16u) | (bytes.w << 24u);
+}
+// Each byte is one channel whatever the endianness, so channels are filtered
+// as raw bytes. Pixels whose data isn't current are replaced by the center.
+vec4 XeUpscaleLoad(ivec2 xy, vec4 center) {
+  uint surface_offset = xe_upscale_surface_tiled != 0u
+                            ? XeUpscaleTiledOffset(uint(xy.x), uint(xy.y))
+                            : uint(xy.y) * xe_upscale_surface_pitch + (uint(xy.x) << 2u);
+  int source_byte = xe_upscale_surface_offset_bytes + int(surface_offset);
+  vec4 texel = center;
+  if (source_byte >= int(xe_upscale_valid_first) && source_byte < int(xe_upscale_valid_end)) {
+    texel = XeUpscaleUnpack(xe_upscale_source.data[uint(source_byte) >> 2u]);
+  }
+  return texel;
+}
+void main() {
+  uint dest_dword = xe_upscale_dest_dword_first + gl_GlobalInvocationID.x;
+  if (dest_dword >= xe_upscale_dest_dword_count) {
+    return;
+  }
+  uint dest_byte = dest_dword << 2u;
+  uint value;
+  if (xe_upscale_filter != 0u) {
+    // 32bpp - one host pixel per dword.
+    uint guest_pixel = dest_dword / xe_upscale_scale_area;
+    uint host_in_guest = dest_dword - guest_pixel * xe_upscale_scale_area;
+    uint source_byte = xe_upscale_source_offset_bytes + (guest_pixel << 2u);
+    value = xe_upscale_source.data[source_byte >> 2u];
+    int surface_byte = int(source_byte) - xe_upscale_surface_offset_bytes;
+    if (surface_byte >= 0) {
+      uvec2 xy = xe_upscale_surface_tiled != 0u
+                     ? XeUpscaleTiledCoords(uint(surface_byte))
+                     : uvec2((uint(surface_byte) % xe_upscale_surface_pitch) >> 2u,
+                             uint(surface_byte) / xe_upscale_surface_pitch);
+      if (xy.x < xe_upscale_surface_width && xy.y < xe_upscale_surface_height) {
+        // Host pixel center in guest pixels, like a 1x texture is sampled.
+        uvec2 host_xy = uvec2(host_in_guest % xe_upscale_scale_x,
+                              host_in_guest / xe_upscale_scale_x);
+        vec2 position = vec2(xy) +
+                        (vec2(host_xy) + 0.5) / vec2(xe_upscale_scale_x, xe_upscale_scale_y) -
+                        0.5;
+        vec2 position_floor = floor(position);
+        vec2 weight = position - position_floor;
+        ivec2 coords_max =
+            ivec2(xe_upscale_surface_width, xe_upscale_surface_height) - ivec2(1);
+        ivec2 coords_0 = clamp(ivec2(position_floor), ivec2(0), coords_max);
+        ivec2 coords_1 = clamp(ivec2(position_floor) + ivec2(1), ivec2(0), coords_max);
+        vec4 center = XeUpscaleUnpack(value);
+        vec4 top = mix(XeUpscaleLoad(coords_0, center),
+                       XeUpscaleLoad(ivec2(coords_1.x, coords_0.y), center), weight.x);
+        vec4 bottom = mix(XeUpscaleLoad(ivec2(coords_0.x, coords_1.y), center),
+                          XeUpscaleLoad(coords_1, center), weight.x);
+        value = XeUpscalePack(mix(top, bottom, weight.y));
+      }
+    }
+  } else if (xe_upscale_pixel_size_log2 >= 2u) {
+    uint host_pixel = dest_byte >> xe_upscale_pixel_size_log2;
+    uint byte_in_pixel = dest_byte & ((1u << xe_upscale_pixel_size_log2) - 1u);
+    uint source_byte = xe_upscale_source_offset_bytes +
+                       ((host_pixel / xe_upscale_scale_area) << xe_upscale_pixel_size_log2) +
+                       byte_in_pixel;
+    value = xe_upscale_source.data[source_byte >> 2u];
+  } else {
+    uint pixel_bits = 8u << xe_upscale_pixel_size_log2;
+    uint pixels_per_dword = 4u >> xe_upscale_pixel_size_log2;
+    uint pixel_mask = (1u << pixel_bits) - 1u;
+    uint host_pixel_first = dest_byte >> xe_upscale_pixel_size_log2;
+    value = 0u;
+    for (uint i = 0u; i < pixels_per_dword; ++i) {
+      uint source_byte = xe_upscale_source_offset_bytes +
+                         (((host_pixel_first + i) / xe_upscale_scale_area)
+                          << xe_upscale_pixel_size_log2);
+      uint source_value =
+          (xe_upscale_source.data[source_byte >> 2u] >> ((source_byte & 3u) << 3u)) & pixel_mask;
+      value |= source_value << (i * pixel_bits);
+    }
+  }
+  xe_upscale_dest.data[dest_dword] = value;
+}
