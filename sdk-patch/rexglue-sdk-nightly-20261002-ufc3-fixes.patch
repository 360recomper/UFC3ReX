+
+bool IsGuestPixelCenterPixelShader(uint64_t ucode_data_hash) {
+  static const std::unordered_set<uint64_t> hashes = []() {
+    std::unordered_set<uint64_t> parsed;
+    const std::string& list = REXCVAR_GET(guest_pixel_center_pixel_shaders);
+    size_t start = 0;
+    while (start < list.size()) {
+      size_t end = list.find(',', start);
+      if (end == std::string::npos) {
+        end = list.size();
+      }
+      std::string item = list.substr(start, end - start);
+      item.erase(0, item.find_first_not_of(" \t"));
+      item.erase(item.find_last_not_of(" \t") + 1);
+      if (!item.empty()) {
+        char* parse_end = nullptr;
+        uint64_t hash = std::strtoull(item.c_str(), &parse_end, 16);
+        if (parse_end && !*parse_end) {
+          parsed.insert(hash);
+        } else {
+          REXLOG_WARN("guest_pixel_center_pixel_shaders: ignoring \"{}\"", item);
+        }
+      }
+      start = end + 1;
+    }
+    return parsed;
+  }();
+  if (hashes.empty() || hashes.find(ucode_data_hash) == hashes.end()) {
+    return false;
+  }
+  static std::mutex logged_mutex;
+  static std::unordered_set<uint64_t> logged;
+  std::lock_guard<std::mutex> lock(logged_mutex);
+  if (logged.insert(ucode_data_hash).second) {
+    REXLOG_INFO("Pixel shader {:016X}: interpolating at guest pixel centers", ucode_data_hash);
+  }
+  return true;
+}
 
