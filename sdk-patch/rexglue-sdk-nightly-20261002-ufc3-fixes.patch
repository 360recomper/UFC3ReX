+bool D3D12TextureCache::UpscaleRangeImpl(uint32_t start_unscaled, uint32_t length_unscaled,
+                                         uint32_t pixel_size_log2, const UpscaleSegment* segments,
+                                         uint32_t segment_count, uint32_t valid_start,
+                                         uint32_t valid_length) {
+  if (!resolve_upscale_pipeline_ || !resolve_upscale_root_signature_) {
+    return false;
+  }
+  if (!MakeScaledResolveRangeCurrent(start_unscaled, length_unscaled)) {
+    return false;
+  }
+  uint32_t dest_dword_count = uint32_t(scaled_resolve_current_range_length_scaled_ >> 2);
+  if (!dest_dword_count) {
+    return true;
+  }
+  ui::d3d12::util::DescriptorCpuGpuHandlePair descriptors[2];
+  if (!command_processor_.RequestOneUseSingleViewDescriptors(2, descriptors)) {
+    return false;
+  }
+  D3D12SharedMemory& d3d12_shared_memory = static_cast<D3D12SharedMemory&>(shared_memory());
+  d3d12_shared_memory.WriteRawSRVDescriptor(descriptors[0].first);
+  CreateCurrentScaledResolveRangeUintPow2UAV(descriptors[1].first, 2);
+
+  d3d12_shared_memory.UseForReading();
+  ID3D12Resource* scaled_resolve_buffer = GetCurrentScaledResolveBuffer().resource();
+  // Ordered after earlier resolves writing the buffer as a UAV.
+  command_processor_.PushUAVBarrier(scaled_resolve_buffer);
+  TransitionCurrentScaledResolveRange(D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+
+  DeferredCommandList& command_list = command_processor_.GetDeferredCommandList();
+  command_processor_.SetExternalPipeline(resolve_upscale_pipeline_.Get());
+  command_list.D3DSetComputeRootSignature(resolve_upscale_root_signature_.Get());
+  command_list.D3DSetComputeRootDescriptorTable(1, descriptors[0].second);
+  command_list.D3DSetComputeRootDescriptorTable(2, descriptors[1].second);
+  // The source is the whole shared memory.
+  ResolveUpscaleConstants constants = {};
+  constants.scale_area = draw_resolution_scale_x() * draw_resolution_scale_y();
+  constants.pixel_size_log2 = pixel_size_log2;
+  constants.source_offset_bytes = start_unscaled;
+  constants.scale_x = draw_resolution_scale_x();
+  constants.scale_y = draw_resolution_scale_y();
+  constants.valid_first = valid_start;
+  constants.valid_end = valid_start + valid_length;
+  command_processor_.SubmitBarriers();
+  constexpr uint32_t kGroupSize = 64;
+  constexpr uint32_t kMaxGroupCount = 65535;
+  // The segments write disjoint dwords, no barriers needed between them.
+  for (uint32_t i = 0; i < segment_count; ++i) {
+    const UpscaleSegment& segment = segments[i];
+    uint32_t dword_begin =
+        uint32_t((uint64_t(segment.start - start_unscaled) * constants.scale_area) >> 2);
+    uint32_t dword_end = std::min(
+        dest_dword_count,
+        uint32_t((uint64_t(segment.start + segment.length - start_unscaled) *
+                  constants.scale_area) >>
+                 2));
+    constants.dest_dword_count = dword_end;
+    constants.filter = segment.surface ? 1 : 0;
+    if (segment.surface) {
+      constants.surface_offset_bytes = int32_t(segment.surface->base);
+      constants.surface_pitch = segment.surface->pitch;
+      constants.surface_width = segment.surface->width;
+      constants.surface_height = segment.surface->height;
+      constants.surface_tiled = segment.surface->tiled ? 1 : 0;
+    }
+    for (uint32_t dword_first = dword_begin; dword_first < dword_end;
+         dword_first += kGroupSize * kMaxGroupCount) {
+      constants.dest_dword_first = dword_first;
+      command_list.D3DSetComputeRoot32BitConstants(0, sizeof(constants) / sizeof(uint32_t),
+                                                   &constants, 0);
+      command_list.D3DDispatch(
+          std::min((dword_end - dword_first + (kGroupSize - 1)) / kGroupSize, kMaxGroupCount), 1,
+          1);
+    }
+  }
+  // Ordered before the resolve or the texture load using the data.
+  MarkCurrentScaledResolveRangeUAVWritesCommitNeeded();
+  command_processor_.PushUAVBarrier(scaled_resolve_buffer);
+  return true;
+}
