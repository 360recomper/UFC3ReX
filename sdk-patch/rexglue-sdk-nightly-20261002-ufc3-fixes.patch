+void VulkanSharedMemory::RecordHoistedUploads(VkCommandBuffer command_buffer) {
+  if (hoisted_copies_.empty()) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice::Functions& dfn = command_processor_.GetVulkanDevice()->functions();
+  VkMemoryBarrier barrier;
+  barrier.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
+  barrier.pNext = nullptr;
+  barrier.srcAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+  barrier.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+  dfn.vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                           VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 1, &barrier, 0, nullptr, 0, nullptr);
+  upload_regions_.clear();
+  for (size_t i = 0; i < hoisted_copies_.size(); ++i) {
+    upload_regions_.push_back(hoisted_copies_[i].region);
+    if (i + 1 == hoisted_copies_.size() ||
+        hoisted_copies_[i + 1].source != hoisted_copies_[i].source) {
+      dfn.vkCmdCopyBuffer(command_buffer, hoisted_copies_[i].source, buffer_,
+                          uint32_t(upload_regions_.size()), upload_regions_.data());
+      upload_regions_.clear();
+    }
+  }
+  barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+  barrier.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+  dfn.vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                           VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &barrier, 0, nullptr, 0,
+                           nullptr);
+  hoisted_copies_.clear();
+}
