+// Textures written by resolves rebased by resolve_negative_origin, for
+// resolve_texture_log.
+struct RebasedResolveTexture {
+  uint32_t start;
+  uint32_t end;
+  uint32_t guest_dest_base;
+};
+std::mutex rebased_resolve_textures_mutex;
+std::vector<RebasedResolveTexture> rebased_resolve_textures;
+
+void NoteRebasedResolveTexture(uint32_t start, uint32_t end, uint32_t guest_dest_base) {
+  constexpr size_t kMaxTextures = 16;
+  std::lock_guard<std::mutex> lock(rebased_resolve_textures_mutex);
+  for (const RebasedResolveTexture& texture : rebased_resolve_textures) {
+    if (texture.start == start && texture.end == end) {
+      return;
+    }
+  }
+  if (rebased_resolve_textures.size() < kMaxTextures) {
+    rebased_resolve_textures.push_back({start, end, guest_dest_base});
+  }
+}
+
+}  // namespace
+
+void LogRebasedResolveTextureFetches(const RegisterFile& regs, const Shader& shader) {
+  if (!REXCVAR_GET(resolve_texture_log)) {
+    return;
+  }
+  constexpr size_t kMaxLogged = 256;
+  static std::mutex logged_mutex;
+  static std::unordered_set<std::string> logged;
+  for (const Shader::TextureBinding& binding : shader.texture_bindings()) {
+    xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(binding.fetch_constant);
+    uint32_t base = uint32_t(fetch.base_address) << 12;
+    RebasedResolveTexture texture = {};
+    {
+      std::lock_guard<std::mutex> lock(rebased_resolve_textures_mutex);
+      for (const RebasedResolveTexture& rebased : rebased_resolve_textures) {
+        if (base >= rebased.start && base < rebased.end) {
+          texture = rebased;
+          break;
+        }
+      }
+    }
+    if (!texture.end) {
+      continue;
+    }
+    uint32_t width = fetch.size_2d.width + 1;
+    uint32_t height = fetch.size_2d.height + 1;
+    std::string key = fmt::format("{:016X}/{}/{:08X}/{}x{}", shader.ucode_data_hash(),
+                                  binding.fetch_constant, base, width, height);
+    {
+      std::lock_guard<std::mutex> lock(logged_mutex);
+      if (logged.size() >= kMaxLogged || !logged.insert(key).second) {
+        continue;
+      }
+    }
+    const FormatInfo* format_info = FormatInfo::Get(fetch.format);
+    REXGPU_WARN(
+        "Rebased resolve texture fetch: {} shader {:016X} tf{} base {:08X} (resolved texture "
+        "{:08X}..{:08X}, guest dest base {:08X}) mip {:08X} dim {} {}x{} pitch {} tiled {} "
+        "format {} ({}) endian {} swizzle {:03X} packed_mips {} mip levels {}..{}",
+        shader.type() == xenos::ShaderType::kVertex ? "vertex" : "pixel", shader.ucode_data_hash(),
+        binding.fetch_constant, base, texture.start, texture.end, texture.guest_dest_base,
+        uint32_t(fetch.mip_address) << 12, uint32_t(fetch.dimension), width, height,
+        uint32_t(fetch.pitch) << 5, uint32_t(fetch.tiled), uint32_t(fetch.format),
+        format_info ? format_info->name : "?", uint32_t(fetch.endianness),
+        uint32_t(fetch.swizzle), uint32_t(fetch.packed_mips), uint32_t(fetch.mip_min_level),
+        uint32_t(fetch.mip_max_level));
+  }
+}
