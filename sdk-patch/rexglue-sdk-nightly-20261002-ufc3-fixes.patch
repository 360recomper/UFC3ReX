+void CommandProcessor::ReadMemexportGuestBytes(uint32_t physical_address, uint32_t size,
+                                               uint8_t* out) const {
+  constexpr uint64_t kPhysicalMemorySize = 0x20000000;
+  physical_address &= 0x1FFFFFFF;
+  const uint32_t length = uint32_t(
+      std::min(uint64_t(physical_address) + size, kPhysicalMemorySize) - physical_address);
+  std::memset(out + length, 0, size - length);
+  const uint8_t* const source = memory_->TranslatePhysical(physical_address);
+  const uintptr_t host_page_mask = uintptr_t(memory::page_size() - 1);
+  uint32_t offset = 0;
+  while (offset < length) {
+    const uint8_t* const run_source = source + offset;
+    memory::PageAccess access;
+    size_t region_length;
+    if (!memory::QueryProtect(const_cast<uint8_t*>(run_source), region_length, access)) {
+      std::memset(out + offset, 0, length - offset);
+      break;
+    }
+    const uint32_t run_length = uint32_t(std::min(
+        uint64_t(region_length - (reinterpret_cast<uintptr_t>(run_source) & host_page_mask)),
+        uint64_t(length - offset)));
+    if (access == memory::PageAccess::kNoAccess) {
+      std::memset(out + offset, 0, run_length);
+    } else {
+      std::memcpy(out + offset, run_source, run_length);
+    }
+    offset += run_length;
+  }
+}
