+TextureCache* VulkanCommandProcessor::GetReadbackTextureCache() { return texture_cache_.get(); }
+
+const uint8_t* VulkanCommandProcessor::ReadBackGpuRange(uint32_t address, uint32_t length,
+                                                        uint32_t pixel_size_log2, bool scaled,
+                                                        bool box_format,
+                                                        const char*& failure_reason) {
+  failure_reason = nullptr;
+  if (!BeginSubmission(false)) {
+    failure_reason = "couldn't begin a submission";
+    return nullptr;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+
+  uint32_t size = AlignReadbackBufferSize(length);
+  if (size > ondemand_readback_buffer_size_) {
+    // The previous readback was awaited, so the old buffer is idle.
+    DestroyOnDemandReadbackBuffer();
+    if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+            vulkan_device, size, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+            ui::vulkan::util::MemoryPurpose::kReadback, ondemand_readback_buffer_,
+            ondemand_readback_memory_)) {
+      REXGPU_ERROR("Failed to create a {} MB Vulkan on-demand resolve readback buffer",
+                   size >> 20);
+      failure_reason = "couldn't create the readback buffer";
+      return nullptr;
+    }
+    if (dfn.vkMapMemory(device, ondemand_readback_memory_, 0, VK_WHOLE_SIZE, 0,
+                        &ondemand_readback_mapping_) != VK_SUCCESS) {
+      REXGPU_ERROR("Failed to map the Vulkan on-demand resolve readback buffer");
+      ondemand_readback_mapping_ = nullptr;
+      DestroyOnDemandReadbackBuffer();
+      failure_reason = "couldn't map the readback buffer";
+      return nullptr;
+    }
+    ondemand_readback_buffer_size_ = size;
+  }
+
+  if (!RecordGpuRangeReadback(address, length, pixel_size_log2, scaled, box_format,
+                              ondemand_readback_buffer_, failure_reason)) {
+    return nullptr;
+  }
+  if (!AwaitAllQueueOperationsCompletion()) {
+    failure_reason = "couldn't await the GPU";
+    return nullptr;
+  }
+  VkMappedMemoryRange readback_memory_range = {};
+  readback_memory_range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+  readback_memory_range.memory = ondemand_readback_memory_;
+  readback_memory_range.offset = 0;
+  readback_memory_range.size = VK_WHOLE_SIZE;
+  dfn.vkInvalidateMappedMemoryRanges(device, 1, &readback_memory_range);
+  return static_cast<const uint8_t*>(ondemand_readback_mapping_);
+}
+
+uint32_t VulkanCommandProcessor::RecordReadbackAhead(uint32_t address, uint32_t length,
+                                                     uint32_t pixel_size_log2, bool scaled,
+                                                     bool box_format) {
+  // Small enough to never matter for memory, large enough for a few copies
+  // of each picture in flight (a released slot is reused once its submission
+  // has completed).
+  constexpr size_t kMaxSlots = 64;
+  constexpr uint64_t kMaxTotalSize = 64 * 1024 * 1024;
+  if (!BeginSubmission(false)) {
+    return 0;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  const uint32_t size = AlignReadbackBufferSize(length);
+  const uint64_t completed_submission = GetCompletedSubmission();
+
+  // The smallest idle slot that fits, else a new one.
+  ReadbackAheadSlot* slot = nullptr;
+  for (ReadbackAheadSlot& candidate : readback_ahead_slots_) {
+    if (!candidate.in_use && candidate.submission <= completed_submission &&
+        candidate.size >= size && (!slot || candidate.size < slot->size)) {
+      slot = &candidate;
+    }
+  }
+  if (!slot) {
+    if (readback_ahead_slots_.size() >= kMaxSlots ||
+        readback_ahead_total_size_ + size > kMaxTotalSize) {
+      return 0;
+    }
+    ReadbackAheadSlot new_slot;
+    if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+            vulkan_device, size, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+            ui::vulkan::util::MemoryPurpose::kReadback, new_slot.buffer, new_slot.memory)) {
+      return 0;
+    }
+    if (dfn.vkMapMemory(device, new_slot.memory, 0, VK_WHOLE_SIZE, 0, &new_slot.mapping) !=
+        VK_SUCCESS) {
+      dfn.vkDestroyBuffer(device, new_slot.buffer, nullptr);
+      dfn.vkFreeMemory(device, new_slot.memory, nullptr);
+      return 0;
+    }
+    new_slot.size = size;
+    readback_ahead_total_size_ += size;
+    readback_ahead_slots_.push_back(new_slot);
+    slot = &readback_ahead_slots_.back();
+  }
+
+  const uint32_t box_bytes_before = readback_box_bytes_;
+  readback_box_bytes_ = 0;
+  const char* failure_reason = nullptr;
+  bool recorded = RecordGpuRangeReadback(address, length, pixel_size_log2, scaled, box_format,
+                                         slot->buffer, failure_reason);
+  const uint32_t box_bytes = readback_box_bytes_;
+  readback_box_bytes_ = box_bytes_before;
+  if (!recorded) {
+    return 0;
+  }
+  // RecordGpuRangeReadback may have awaited the GPU (growing the downscale
+  // buffer), which doesn't move the slot.
+  slot->submission = GetCurrentSubmission();
+  slot->box_bytes = box_bytes;
+  slot->in_use = true;
+  return uint32_t(slot - readback_ahead_slots_.data()) + 1;
+}
+
+const uint8_t* VulkanCommandProcessor::AwaitReadbackAhead(uint32_t slot_index,
+                                                          uint32_t& box_bytes, bool& waited,
+                                                          const char*& failure_reason) {
+  failure_reason = nullptr;
+  waited = false;
+  if (!slot_index || slot_index > readback_ahead_slots_.size()) {
+    failure_reason = "no such slot";
+    return nullptr;
+  }
+  ReadbackAheadSlot& slot = readback_ahead_slots_[slot_index - 1];
+  // Refresh how far the GPU is without waiting.
+  CheckSubmissionFenceAndDeviceLoss(0);
+  if (GetCompletedSubmission() < slot.submission) {
+    // Only up to the copy's submission (ends it if it is the open one).
+    waited = true;
+    CheckSubmissionFenceAndDeviceLoss(slot.submission);
+    if (GetCompletedSubmission() < slot.submission) {
+      failure_reason = "couldn't await the copy's submission";
+      return nullptr;
+    }
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  VkMappedMemoryRange range = {};
+  range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+  range.memory = slot.memory;
+  range.offset = 0;
+  range.size = VK_WHOLE_SIZE;
+  vulkan_device->functions().vkInvalidateMappedMemoryRanges(vulkan_device->device(), 1, &range);
+  box_bytes = slot.box_bytes;
+  return static_cast<const uint8_t*>(slot.mapping);
+}
+
+void VulkanCommandProcessor::ReleaseReadbackAhead(uint32_t slot_index) {
+  if (slot_index && slot_index <= readback_ahead_slots_.size()) {
+    readback_ahead_slots_[slot_index - 1].in_use = false;
+  }
+}
+
+void VulkanCommandProcessor::DestroyReadbackAheadSlots() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  for (ReadbackAheadSlot& slot : readback_ahead_slots_) {
+    if (slot.mapping) {
+      dfn.vkUnmapMemory(device, slot.memory);
+    }
+    if (slot.buffer != VK_NULL_HANDLE) {
+      dfn.vkDestroyBuffer(device, slot.buffer, nullptr);
+    }
+    if (slot.memory != VK_NULL_HANDLE) {
+      dfn.vkFreeMemory(device, slot.memory, nullptr);
+    }
+  }
+  readback_ahead_slots_.clear();
+  readback_ahead_total_size_ = 0;
+}
+
+bool VulkanCommandProcessor::RecordGpuRangeReadback(uint32_t address, uint32_t length,
+                                                    uint32_t pixel_size_log2, bool scaled,
+                                                    bool box_format, VkBuffer dest_buffer,
+                                                    const char*& failure_reason) {
+  failure_reason = nullptr;
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  const uint32_t size = AlignReadbackBufferSize(length);
+
+  if (scaled) {
+    if (!resolve_downscale_pipeline_ || !resolve_downscale_pipeline_layout_) {
+      failure_reason = "no downscale pipeline";
+      return false;
+    }
+    uint32_t tile_count = length >> (10 + pixel_size_log2);
+    if (!tile_count) {
+      failure_reason = "shorter than one 32x32 tile";
+      return false;
+    }
+    // Tiles rendered at the scale are averaged, the rest (upscaled 1x data)
+    // takes the center sample.
+    std::vector<TextureCache::DownscaleSegment> segments;
+    texture_cache_->GetDownscaleSegments(address, length, pixel_size_log2, box_format, segments);
+    if (segments.empty()) {
+      failure_reason = "shorter than one 32x32 tile";
+      return false;
+    }
+
+    if (size > resolve_downscale_buffer_size_) {
+      VkBuffer new_buffer = VK_NULL_HANDLE;
+      VkDeviceMemory new_memory = VK_NULL_HANDLE;
+      if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+              vulkan_device, size,
+              VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT,
+              ui::vulkan::util::MemoryPurpose::kDeviceLocal, new_buffer, new_memory)) {
+        REXGPU_ERROR("Failed to create a {} MB Vulkan resolve downscale buffer", size >> 20);
+        failure_reason = "couldn't create the downscale buffer";
+        return false;
+      }
+      if (resolve_downscale_buffer_ != VK_NULL_HANDLE ||
+          resolve_downscale_buffer_memory_ != VK_NULL_HANDLE) {
+        if (!AwaitAllQueueOperationsCompletion()) {
+          dfn.vkDestroyBuffer(device, new_buffer, nullptr);
+          dfn.vkFreeMemory(device, new_memory, nullptr);
+          failure_reason = "couldn't await the GPU to replace the downscale buffer";
+          return false;
+        }
+        if (resolve_downscale_buffer_ != VK_NULL_HANDLE) {
+          dfn.vkDestroyBuffer(device, resolve_downscale_buffer_, nullptr);
+        }
+        if (resolve_downscale_buffer_memory_ != VK_NULL_HANDLE) {
+          dfn.vkFreeMemory(device, resolve_downscale_buffer_memory_, nullptr);
+        }
+        // Awaiting ended the submission.
+        if (!BeginSubmission(false)) {
+          dfn.vkDestroyBuffer(device, new_buffer, nullptr);
+          dfn.vkFreeMemory(device, new_memory, nullptr);
+          resolve_downscale_buffer_ = VK_NULL_HANDLE;
+          resolve_downscale_buffer_memory_ = VK_NULL_HANDLE;
+          resolve_downscale_buffer_size_ = 0;
+          failure_reason = "couldn't begin a submission";
+          return false;
+        }
+      }
+      resolve_downscale_buffer_ = new_buffer;
+      resolve_downscale_buffer_memory_ = new_memory;
+      resolve_downscale_buffer_size_ = size;
+    }
+
+    texture_cache_->UseScaledResolveBufferForRead();
+    SubmitBarriers(true);
+
+    VkBufferMemoryBarrier pre_barrier = {};
+    pre_barrier.sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER;
+    pre_barrier.srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+    pre_barrier.dstAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+    pre_barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    pre_barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    pre_barrier.buffer = resolve_downscale_buffer_;
+    pre_barrier.offset = 0;
+    pre_barrier.size = length;
+    deferred_command_buffer_.CmdVkPipelineBarrier(
+        VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+        VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 0, nullptr, 1, &pre_barrier, 0, nullptr);
+
+    bool half_pixel_offset =
+        REXCVAR_GET(readback_resolve_half_pixel_offset) &&
+        (texture_cache_->draw_resolution_scale_x() > 1 ||
+         texture_cache_->draw_resolution_scale_y() > 1);
+    // The segments write disjoint parts of the downscale buffer.
+    for (const TextureCache::DownscaleSegment& segment : segments) {
+      bool segment_box;
+      if (!RecordResolveDownscale(address + segment.offset, segment.length, pixel_size_log2,
+                                  segment.box, resolve_downscale_buffer_, segment.offset,
+                                  half_pixel_offset, segment_box, failure_reason)) {
+        return false;
+      }
+      if (segment_box) {
+        readback_box_bytes_ += segment.length;
+      }
+    }
+
+    VkBufferMemoryBarrier downscale_barrier = {};
+    downscale_barrier.sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER;
+    downscale_barrier.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+    downscale_barrier.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+    downscale_barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    downscale_barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    downscale_barrier.buffer = resolve_downscale_buffer_;
+    downscale_barrier.offset = 0;
+    downscale_barrier.size = length;
+    deferred_command_buffer_.CmdVkPipelineBarrier(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                                                  VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 1,
+                                                  &downscale_barrier, 0, nullptr);
+
+    VkBufferCopy readback_region = {};
+    readback_region.size = length;
+    deferred_command_buffer_.CmdVkCopyBuffer(resolve_downscale_buffer_, dest_buffer, 1,
+                                             &readback_region);
+  } else {
+    shared_memory_->Use(VulkanSharedMemory::Usage::kRead);
+    SubmitBarriers(true);
+    VkBufferCopy readback_region = {};
+    readback_region.srcOffset = address;
+    readback_region.size = length;
+    deferred_command_buffer_.CmdVkCopyBuffer(shared_memory_->buffer(), dest_buffer, 1,
+                                             &readback_region);
+  }
+
+  PushBufferMemoryBarrier(dest_buffer, 0, length, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                          VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+                          VK_ACCESS_HOST_READ_BIT);
+  return true;
+}
+
+bool VulkanCommandProcessor::DownscaleScaledRangeToSharedMemory(uint32_t address,
+                                                                uint32_t length,
+                                                                uint32_t pixel_size_log2, bool box,
+                                                                const char*& failure_reason) {
+  perf::Scope perf_scope(perf::Bucket::kDownscale);
+  failure_reason = nullptr;
+  if (!resolve_downscale_pipeline_ || !resolve_downscale_pipeline_layout_) {
+    failure_reason = "no downscale pipeline";
+    return false;
+  }
+  uint32_t tile_size_log2 = 10 + pixel_size_log2;
+  uint32_t tile_count = length >> tile_size_log2;
+  if (!tile_count || (length & ((UINT32_C(1) << tile_size_log2) - 1))) {
+    failure_reason = "not whole 32x32 tiles";
+    return false;
+  }
+  if (!BeginSubmission(false)) {
+    failure_reason = "couldn't begin a submission";
+    return false;
+  }
+  // Ordered after the resolves writing the scaled buffer, and the texture load
+  // after this (shared memory kRead) is ordered after the write.
+  texture_cache_->UseScaledResolveBufferForRead();
+  shared_memory_->Use(VulkanSharedMemory::Usage::kComputeWrite,
+                      std::pair<uint32_t, uint32_t>(address, length));
+  SubmitBarriers(true);
+  // The same host pixel the CPU readback picks, so the 1x texture matches what
+  // the guest CPU sees there. The address is page-aligned, more than
+  // minStorageBufferOffsetAlignment can be.
+  bool box_used;
+  return RecordResolveDownscale(address, length, pixel_size_log2, box, shared_memory_->buffer(),
+                                address, REXCVAR_GET(readback_resolve_half_pixel_offset),
+                                box_used, failure_reason);
+}
+
+bool VulkanCommandProcessor::RecordResolveDownscale(uint32_t address, uint32_t length,
+                                                    uint32_t pixel_size_log2, bool box,
+                                                    VkBuffer dest_buffer, VkDeviceSize dest_offset,
+                                                    bool half_pixel_offset, bool& box_out,
+                                                    const char*& failure_reason) {
+  box_out = false;
+  uint32_t tile_count = length >> (10 + pixel_size_log2);
+  if (!tile_count) {
+    failure_reason = "shorter than one 32x32 tile";
+    return false;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  uint64_t scaled_start = 0, scaled_length = 0;
+  if (!texture_cache_->GetScaledResolveRange(address, length, 0, scaled_start, scaled_length) ||
+      !scaled_length) {
+    failure_reason = "outside the scaled resolve buffer";
+    return false;
+  }
+  VkBuffer scaled_resolve_buffer = texture_cache_->scaled_resolve_buffer();
+  if (scaled_resolve_buffer == VK_NULL_HANDLE) {
+    failure_reason = "no scaled resolve buffer";
+    return false;
+  }
+  VkDeviceSize source_offset, source_range;
+  uint32_t source_offset_bytes;
+  if (!GetScaledResolveSourceBinding(scaled_start, scaled_length, source_offset, source_range,
+                                     source_offset_bytes) ||
+      length > vulkan_device->properties().maxStorageBufferRange) {
+    failure_reason = "range exceeds maxStorageBufferRange";
+    return false;
+  }
+  VkDescriptorSet descriptor_set = AllocateSingleTransientDescriptor(
+      SingleTransientDescriptorLayout::kStorageBufferPairCompute);
+  if (descriptor_set == VK_NULL_HANDLE) {
+    failure_reason = "no transient descriptor";
+    return false;
+  }
+  // The source descriptor starts at the range: at 3x and above, scaled
+  // offsets of the top of physical memory are past 4 GB, more than the
+  // shader's 32-bit offset holds. Destination offsets are whole tiles.
+  VkDescriptorBufferInfo buffer_infos[2] = {};
+  buffer_infos[0].buffer = scaled_resolve_buffer;
+  buffer_infos[0].offset = source_offset;
+  buffer_infos[0].range = source_range;
+  buffer_infos[1].buffer = dest_buffer;
+  buffer_infos[1].offset = dest_offset;
+  buffer_infos[1].range = length;
+  VkWriteDescriptorSet descriptor_writes[2] = {};
+  for (uint32_t i = 0; i < 2; ++i) {
+    descriptor_writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    descriptor_writes[i].dstSet = descriptor_set;
+    descriptor_writes[i].dstBinding = i;
+    descriptor_writes[i].descriptorCount = 1;
+    descriptor_writes[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+    descriptor_writes[i].pBufferInfo = &buffer_infos[i];
+  }
+  dfn.vkUpdateDescriptorSets(device, 2, descriptor_writes, 0, nullptr);
+
+  box_out = box && pixel_size_log2 == 2 && resolve_downscale_box_pipeline_ != VK_NULL_HANDLE;
+  BindExternalComputePipeline(box_out ? resolve_downscale_box_pipeline_
+                                      : resolve_downscale_pipeline_);
+  ResolveDownscaleConstants constants;
+  constants.scale_x = texture_cache_->draw_resolution_scale_x();
+  constants.scale_y = texture_cache_->draw_resolution_scale_y();
+  constants.pixel_size_log2 = pixel_size_log2;
+  constants.tile_count = tile_count;
+  constants.source_offset_bytes = source_offset_bytes;
+  constants.half_pixel_offset = half_pixel_offset ? 1u : 0u;
+  deferred_command_buffer_.CmdVkPushConstants(resolve_downscale_pipeline_layout_,
+                                              VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(constants),
+                                              &constants);
+  deferred_command_buffer_.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                                   resolve_downscale_pipeline_layout_, 0, 1,
+                                                   &descriptor_set, 0, nullptr);
+  deferred_command_buffer_.CmdVkDispatch(tile_count, 1, 1);
+  return true;
+}
+
+bool VulkanCommandProcessor::GetScaledResolveSourceBinding(uint64_t scaled_start,
+                                                           uint64_t scaled_length,
+                                                           VkDeviceSize& offset_out,
+                                                           VkDeviceSize& range_out,
+                                                           uint32_t& offset_in_range_out) const {
+  const auto& limits = GetVulkanDevice()->properties();
+  // A power of two by the spec.
+  VkDeviceSize alignment = std::max(VkDeviceSize(4), limits.minStorageBufferOffsetAlignment);
+  offset_out = scaled_start & ~(alignment - 1);
+  offset_in_range_out = uint32_t(scaled_start - offset_out);
+  range_out = rex::align(VkDeviceSize(offset_in_range_out) + scaled_length, VkDeviceSize(4));
+  return range_out <= limits.maxStorageBufferRange;
+}
+
+void VulkanCommandProcessor::DestroyOnDemandReadbackBuffer() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  if (ondemand_readback_mapping_ && ondemand_readback_memory_ != VK_NULL_HANDLE) {
+    dfn.vkUnmapMemory(device, ondemand_readback_memory_);
+  }
+  ondemand_readback_mapping_ = nullptr;
+  if (ondemand_readback_buffer_ != VK_NULL_HANDLE) {
+    dfn.vkDestroyBuffer(device, ondemand_readback_buffer_, nullptr);
+    ondemand_readback_buffer_ = VK_NULL_HANDLE;
+  }
+  if (ondemand_readback_memory_ != VK_NULL_HANDLE) {
+    dfn.vkFreeMemory(device, ondemand_readback_memory_, nullptr);
+    ondemand_readback_memory_ = VK_NULL_HANDLE;
+  }
+  ondemand_readback_buffer_size_ = 0;
+}
