+uint32_t RenderTargetCache::GetHostOutputClamp(xenos::ColorRenderTargetFormat format,
+                                               uint32_t blend_control, float clamp_out[4]) {
+  clamp_out[0] = clamp_out[1] = clamp_out[2] = clamp_out[3] = 0.0f;
+  if (!IsHostOutputClampFormat(format)) {
+    return 0;
+  }
+  uint32_t keep_mask_low, keep_mask_high;
+  GetPSIColorFormatInfo(format, 0b1111, clamp_out[0], clamp_out[1], clamp_out[2], clamp_out[3],
+                        keep_mask_low, keep_mask_high);
+  // Not 1 * source + 0 * destination, as in the FSI blending path.
+  if ((blend_control & 0x1FFF1FFF) != 0x00010001 &&
+      !REXCVAR_GET(host_rt_output_clamp_blended)) {
+    // The largest finite float16 keeps Inf out of the host blending.
+    uint32_t format_flags = AddPSIColorFormatFlags(format);
+    if (!(format_flags & kPSIColorFormatFlag_FixedPointColor)) {
+      clamp_out[0] = -65504.0f;
+      clamp_out[2] = 65504.0f;
+    }
+    if (!(format_flags & kPSIColorFormatFlag_FixedPointAlpha)) {
+      clamp_out[1] = -65504.0f;
+      clamp_out[3] = 65504.0f;
+    }
+  }
+  return kPSIColorFormatFlag_HostOutputClamp;
+}
