+        if (i == page_last >> 6 && (page_last & 63) != 63) {
+          mask &= (uint64_t(1) << ((page_last & 63) + 1)) - 1;
+        }
+        uint32_t bit;
+        while (rex::bit_scan_forward(mask, &bit)) {
+          mask &= mask - 1;
+          uint32_t page = (i << 6) + bit;
+          if (!speculative_runs_.empty() &&
+              speculative_runs_.back().first + speculative_runs_.back().second == page) {
+            ++speculative_runs_.back().second;
+          } else {
+            speculative_runs_.emplace_back(page, 1);
+          }
+        }
+      }
+    }
+  }
+  const size_t page_size = size_t(1) << page_size_log2_;
+  for (const std::pair<uint32_t, uint32_t>& run : speculative_runs_) {
+    // Arm the write watch before comparing, so a CPU write after the
+    // comparison invalidates the page again.
+    MakeRangeValid(run.first << page_size_log2_, run.second << page_size_log2_, false);
+    for (uint32_t page = run.first; page < run.first + run.second; ++page) {
+      auto it = speculative_shadow_.find(page);
+      if (it == speculative_shadow_.end() ||
+          std::memcmp(it->second.get(), memory().TranslatePhysical(page << page_size_log2_),
+                      page_size)) {
+        auto global_lock = global_critical_region_.Acquire();
+        system_page_flags_valid_[page >> 6] &= ~(uint64_t(1) << (page & 63));
+      }
+    }
+  }
+}
+
+void SharedMemory::CollectSpeculativeRanges() {
+  // Pages following each upload in its 64-page block that are also invalid
+  // (CPU-side invalidation happens at this granularity, see
+  // MemoryInvalidationCallback).
+  speculative_ranges_.clear();
+  const uint32_t page_count = kBufferSize >> page_size_log2_;
+  {
+    auto global_lock = global_critical_region_.Acquire();
+    for (size_t i = 0; i < upload_ranges_.size(); ++i) {
+      uint32_t start = upload_ranges_[i].first + upload_ranges_[i].second;
+      uint32_t limit = std::min((start + 63) & ~uint32_t(63), page_count);
+      if (i + 1 < upload_ranges_.size()) {
+        limit = std::min(limit, upload_ranges_[i + 1].first);
+      }
+      uint32_t end = start;
+      while (end < limit && !((system_page_flags_valid_[end >> 6] >> (end & 63)) & 1) &&
+             !IsPageSpeculative(end)) {
+        ++end;
+      }
+      if (end > start) {
+        speculative_ranges_.emplace_back(start, end - start);
+      }
+    }
+  }
+  // Invalid pages may also be never-allocated guest memory: only keep the
+  // allocated, readable prefix of each range (checked outside the global
+  // critical region, the guest heap has its own lock).
+  memory::BaseHeap* heap = memory().GetPhysicalHeap();
+  size_t kept = 0;
+  for (const std::pair<uint32_t, uint32_t>& range : speculative_ranges_) {
+    uint32_t length = 0;
+    while (length < range.second) {
+      uint32_t address = (range.first + length) << page_size_log2_;
+      if (heap->QueryRangeAccess(address, address + ((uint32_t(1) << page_size_log2_) - 1)) ==
+          rex::memory::PageAccess::kNoAccess) {
+        break;
+      }
+      ++length;
+    }
+    if (length && EnsureHostGpuMemoryAllocated(range.first << page_size_log2_,
+                                               length << page_size_log2_)) {
+      speculative_ranges_[kept++] = std::make_pair(range.first, length);
+    }
+  }
+  speculative_ranges_.resize(kept);
 }
 
