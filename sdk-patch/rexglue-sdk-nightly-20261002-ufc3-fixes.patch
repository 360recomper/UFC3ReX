+// Flattens a config table the way ApplyTomlTable keys it, keeping each value
+// as TOML text so SaveConfig can write it back unchanged.
+void CollectTomlText(const toml::table& table, const std::string& prefix,
+                     std::vector<std::pair<std::string, std::string>>& out) {
+  for (const auto& [key, value] : table) {
+    std::string full_key = prefix.empty() ? std::string(key) : prefix + "_" + std::string(key);
+    if (value.is_table()) {
+      CollectTomlText(*value.as_table(), full_key, out);
+    } else if (!value.is_array()) {
+      std::ostringstream text;
+      value.visit([&text](const auto& node) { text << node; });
+      out.emplace_back(std::move(full_key), text.str());
+    }
+  }
+}
