+namespace {
+
+struct BlackFrameDetector {
+  std::mutex mutex;
+  // Recent samples for the detection line.
+  static constexpr size_t kHistorySize = 24;
+  struct Sample {
+    uint64_t frame;
+    float mean;
+    float black_fraction;
+  };
+  Sample history[kHistorySize] = {};
+  size_t history_count = 0;
+  uint64_t last_bright_frame = 0;
+  uint32_t dark_run = 0;
+  uint32_t bright_run = 0;
+  // Whether the dark run started right after a bright sample.
+  bool dark_run_sudden = false;
+  bool in_black = false;
+  uint64_t black_first_frame = 0;
+  uint32_t black_count = 0;
+  uint32_t black_dumps = 0;
+  bool recovered_dump_wanted = false;
+  // Armed: starts at the next swap.
+  const char* armed_kind = nullptr;
+  uint64_t armed_sample_frame = 0;
+  uint32_t dump_index = 0;
+  std::atomic<bool> dump_active{false};
+  std::atomic<uint32_t> dump_lines{0};
+  std::atomic<uint32_t> dump_float_readbacks{0};
+  const char* dump_kind = nullptr;
+  uint64_t dump_frame = 0;
+  // The last resolve during a dump.
+  bool resolve_valid = false;
+  BlackFrameDumpResolve resolve = {};
+
+  // black_frame_detect_arm_ps. The frame whose draws are being issued (the
+  // next swap ends it).
+  uint64_t draw_frame = 1;
+  uint64_t last_arm_frame = 0;
+  bool armed = false;
+  bool dark_run_armed = false;
+  // Which watched shaders drew in each recent frame (bit = list index).
+  static constexpr size_t kMaskHistorySize = 256;
+  struct FrameMask {
+    uint64_t frame;
+    uint32_t mask;
+  };
+  FrameMask masks[kMaskHistorySize] = {};
+  // Lines of the frames while armed, so the frames before a detected black
+  // can be dumped. Lines go here while recording; under ring_mutex (taken
+  // after mutex when both are needed).
+  static constexpr size_t kRingSize = 24;
+  static constexpr size_t kRingFrameMaxLines = 8000;
+  struct RingFrame {
+    uint64_t frame = 0;
+    bool truncated = false;
+    std::vector<std::string> lines;
+  };
+  std::mutex ring_mutex;
+  RingFrame ring[kRingSize];
+  std::atomic<bool> recording{false};
+};
+
+BlackFrameDetector& GetBlackFrameDetector() {
+  static BlackFrameDetector detector;
+  return detector;
+}
+
+const std::vector<uint64_t>& GetBlackFrameArmShaders() {
+  static const std::vector<uint64_t> shaders = []() {
+    std::vector<uint64_t> parsed;
+    const std::string& value = REXCVAR_GET(black_frame_detect_arm_ps);
+    size_t position = 0;
+    while (position < value.size() && parsed.size() < 32) {
+      size_t end = value.find_first_of(",; ", position);
+      if (end == std::string::npos) {
+        end = value.size();
+      }
+      if (end > position) {
+        uint64_t hash = std::strtoull(value.substr(position, end - position).c_str(), nullptr, 16);
+        if (hash) {
+          parsed.push_back(hash);
+        }
+      }
+      position = end + 1;
+    }
+    if (!parsed.empty()) {
+      std::string list;
+      for (size_t i = 0; i < parsed.size(); ++i) {
+        list += fmt::format(" {}:{:016X}", i, parsed[i]);
+      }
+      REXGPU_INFO("black_frame_detect_arm_ps: armed by{} (mask bit: hash), for {} frames", list,
+                  REXCVAR_GET(black_frame_detect_arm_frames));
+    }
+    return parsed;
+  }();
+  return shaders;
+}
+
+uint32_t GetBlackFrameMask(const BlackFrameDetector& detector, uint64_t frame) {
+  const BlackFrameDetector::FrameMask& entry =
+      detector.masks[frame % BlackFrameDetector::kMaskHistorySize];
+  return entry.frame == frame ? entry.mask : 0;
+}
+
+// Logs a kept frame as part of the current dump; mutex held.
+void DumpBlackFrameRingFrame(BlackFrameDetector& detector, uint64_t frame, const char* kind) {
+  std::lock_guard<std::mutex> ring_lock(detector.ring_mutex);
+  const BlackFrameDetector::RingFrame& entry =
+      detector.ring[frame % BlackFrameDetector::kRingSize];
+  if (!frame || entry.frame != frame) {
+    REXGPU_WARN("Black frame dump {}: {} frame {} was not kept (not armed then, or too old)",
+                detector.dump_index, kind, frame);
+    return;
+  }
+  REXGPU_WARN("Black frame dump {} {} (frame {}, watched mask {:X}): begin, {} lines{}",
+              detector.dump_index, kind, frame, GetBlackFrameMask(detector, frame),
+              entry.lines.size(), entry.truncated ? " (truncated)" : "");
+  for (size_t i = 0; i < entry.lines.size(); ++i) {
+    REXGPU_WARN("Black frame dump {} {} #{}: {}", detector.dump_index, kind, i, entry.lines[i]);
+  }
+  REXGPU_WARN("Black frame dump {} {} (frame {}): end", detector.dump_index, kind, frame);
+}
+
+// A frame with 85% of its samples black is a dark frame (the HUD may stay
+// visible). A bright frame has a mean above kBlackFrameBrightMean.
+constexpr float kBlackFrameDarkFraction = 0.85f;
+constexpr float kBlackFrameBrightMean = 0.08f;
+constexpr uint32_t kBlackFrameDarkRun = 10;
+constexpr uint32_t kBlackFrameRecoverRun = 10;
+// A dark run that starts more than this many samples after the last bright
+// one is a fade (to a loading screen), not a sudden black.
+constexpr uint64_t kBlackFrameSuddenFrames = 8;
+constexpr uint32_t kBlackFrameDumpMaxLines = 20000;
+
+}  // namespace
+
+bool IsBlackFrameDetectEnabled() { return REXCVAR_GET(black_frame_detect); }
+
+void OnBlackFrameSample(uint64_t frame, float mean_luminance, float black_fraction) {
+  BlackFrameDetector& detector = GetBlackFrameDetector();
+  std::lock_guard<std::mutex> lock(detector.mutex);
+  detector.history[detector.history_count % BlackFrameDetector::kHistorySize] = {
+      frame, mean_luminance, black_fraction};
+  ++detector.history_count;
+  bool arm_list = !GetBlackFrameArmShaders().empty();
+  auto history_string = [&]() {
+    std::string history;
+    size_t count = std::min(detector.history_count, BlackFrameDetector::kHistorySize);
+    for (size_t i = detector.history_count - count; i < detector.history_count; ++i) {
+      const BlackFrameDetector::Sample& sample =
+          detector.history[i % BlackFrameDetector::kHistorySize];
+      history += fmt::format(" {}:{:.3f}/{:.2f}", sample.frame, sample.mean, sample.black_fraction);
+      if (arm_list) {
+        history += fmt::format("/{:X}", GetBlackFrameMask(detector, sample.frame));
+      }
+    }
+    return history;
+  };
+  if (black_fraction >= kBlackFrameDarkFraction) {
+    if (!detector.dark_run) {
+      detector.dark_run_sudden = detector.last_bright_frame &&
+                                 frame - detector.last_bright_frame <= kBlackFrameSuddenFrames;
+      // Samples are a few frames late, so a watched draw after the first dark
+      // frame also counts.
+      detector.dark_run_armed =
+          !arm_list ||
+          (detector.last_arm_frame &&
+           detector.last_arm_frame +
+                   uint64_t(std::max(REXCVAR_GET(black_frame_detect_arm_frames), 0)) >=
+               frame);
+    }
+    ++detector.dark_run;
+    detector.bright_run = 0;
+    if (!detector.in_black && detector.dark_run_sudden &&
+        detector.dark_run >= kBlackFrameDarkRun) {
+      detector.in_black = true;
+      detector.black_first_frame = frame - (detector.dark_run - 1);
+      ++detector.black_count;
+      bool dump =
+          detector.dark_run_armed &&
+          detector.black_dumps < uint32_t(std::max(REXCVAR_GET(black_frame_detect_dumps), 0));
+      REXGPU_WARN(
+          "Black frame {} at frame {} (black since frame {}, last bright frame {}){}; recent "
+          "frame:mean/black fraction{}{}",
+          detector.black_count, frame, detector.black_first_frame, detector.last_bright_frame,
+          !detector.dark_run_armed
+              ? ", no watched pass drew near it: not dumped"
+              : (dump ? (arm_list ? ", dumping the last bright frame, the first black frame and "
+                                    "the next frame"
+                                  : ", dumping the next frame")
+                      : ", dump cap reached"),
+          arm_list ? "/watched mask" : "", history_string());
+      if (dump && !detector.armed_kind) {
+        ++detector.black_dumps;
+        detector.recovered_dump_wanted = true;
+        detector.armed_kind = "black";
+        detector.armed_sample_frame = frame;
+        if (arm_list) {
+          // The dump index of the coming "next frame" dump.
+          ++detector.dump_index;
+          DumpBlackFrameRingFrame(detector, detector.last_bright_frame, "last bright");
+          DumpBlackFrameRingFrame(detector, detector.black_first_frame, "first black");
+          --detector.dump_index;
+        }
+      }
+    }
+    return;
+  }
+  if (detector.dark_run >= kBlackFrameDarkRun && !detector.dark_run_sudden) {
+    // Not dumped, but shows a black screen that came on slowly, if any.
+    static uint32_t fade_logs_left = 256;
+    if (fade_logs_left) {
+      --fade_logs_left;
+      REXGPU_INFO("Gradual black: {} dark frames up to frame {} (last bright frame {})",
+                  detector.dark_run, frame, detector.last_bright_frame);
+    }
+  }
+  detector.dark_run = 0;
+  if (mean_luminance < kBlackFrameBrightMean) {
+    detector.bright_run = 0;
+    return;
+  }
+  detector.last_bright_frame = frame;
+  ++detector.bright_run;
+  if (detector.in_black && detector.bright_run >= kBlackFrameRecoverRun) {
+    detector.in_black = false;
+    bool dump = detector.recovered_dump_wanted;
+    REXGPU_WARN(
+        "Black frame {} ended at frame {} after {} frames{}; recent frame:mean/black fraction{}",
+        detector.black_count, frame, frame - detector.black_first_frame,
+        dump ? ", dumping the next frame" : "", history_string());
+    if (dump && !detector.armed_kind) {
+      detector.recovered_dump_wanted = false;
+      detector.armed_kind = "recovered";
+      detector.armed_sample_frame = frame;
+    }
+  }
+}
+
+void OnBlackFrameSwap(uint64_t frame) {
+  BlackFrameDetector& detector = GetBlackFrameDetector();
+  std::lock_guard<std::mutex> lock(detector.mutex);
+  if (!GetBlackFrameArmShaders().empty()) {
+    // The draws so far belong to this frame; the ones after the swap to the next.
+    uint64_t next_frame = frame + 1;
+    uint64_t arm_frames = uint64_t(std::max(REXCVAR_GET(black_frame_detect_arm_frames), 0));
+    if (detector.armed && frame > detector.last_arm_frame + arm_frames) {
+      detector.armed = false;
+      static uint32_t disarm_logs_left = 256;
+      if (disarm_logs_left) {
+        --disarm_logs_left;
+        REXGPU_INFO("black_frame_detect: watched passes last drew at frame {}, disarmed at frame {}",
+                    detector.last_arm_frame, frame);
+      }
+    }
+    detector.draw_frame = next_frame;
+    std::lock_guard<std::mutex> ring_lock(detector.ring_mutex);
+    detector.recording = detector.armed;
+    BlackFrameDetector::RingFrame& entry =
+        detector.ring[next_frame % BlackFrameDetector::kRingSize];
+    entry.frame = next_frame;
+    entry.truncated = false;
+    entry.lines.clear();
+  }
+  if (detector.dump_active) {
+    detector.dump_active = false;
+    REXGPU_WARN("Black frame dump {} ({}, frame {}): end, {} lines", detector.dump_index,
+                detector.dump_kind, detector.dump_frame, detector.dump_lines.load());
+  }
+  if (detector.armed_kind) {
+    ++detector.dump_index;
+    detector.dump_kind = detector.armed_kind;
+    detector.dump_frame = frame;
+    detector.armed_kind = nullptr;
+    detector.dump_lines = 0;
+    detector.dump_float_readbacks = 0;
+    detector.resolve_valid = false;
+    REXGPU_WARN("Black frame dump {} ({}, frame {}, detected on the sample of frame {}): begin",
+                detector.dump_index, detector.dump_kind, detector.dump_frame,
+                detector.armed_sample_frame);
+    detector.dump_active = true;
+  }
+}
+
+bool IsBlackFrameDumpActive() {
+  const BlackFrameDetector& detector = GetBlackFrameDetector();
+  return detector.dump_active.load() || detector.recording.load();
+}
+
+void NoteBlackFrameDumpLine(const std::string& line) {
+  BlackFrameDetector& detector = GetBlackFrameDetector();
+  if (detector.recording) {
+    std::lock_guard<std::mutex> ring_lock(detector.ring_mutex);
+    BlackFrameDetector::RingFrame& entry =
+        detector.ring[detector.draw_frame % BlackFrameDetector::kRingSize];
+    if (entry.frame == detector.draw_frame) {
+      if (entry.lines.size() < BlackFrameDetector::kRingFrameMaxLines) {
+        entry.lines.push_back(line);
+      } else {
+        entry.truncated = true;
+      }
+    }
+  }
+  if (!detector.dump_active) {
+    return;
+  }
+  uint32_t line_index = detector.dump_lines.fetch_add(1);
+  if (line_index > kBlackFrameDumpMaxLines) {
+    return;
+  }
+  if (line_index == kBlackFrameDumpMaxLines) {
+    REXGPU_WARN("Black frame dump {}: {} lines, the rest of the frame is not logged",
+                detector.dump_index, kBlackFrameDumpMaxLines);
+    return;
+  }
+  REXGPU_WARN("Black frame dump {} #{}: {}", detector.dump_index, line_index, line);
+}
+
+void NoteBlackFrameDumpDraw(const RegisterFile& regs, const Shader* vertex_shader,
+                            const Shader* pixel_shader, bool host_rt_path) {
+  if (!IsBlackFrameDetectEnabled()) {
+    return;
+  }
+  const std::vector<uint64_t>& arm_shaders = GetBlackFrameArmShaders();
+  if (pixel_shader && !arm_shaders.empty()) {
+    uint64_t hash = pixel_shader->ucode_data_hash();
+    for (size_t i = 0; i < arm_shaders.size(); ++i) {
+      if (arm_shaders[i] != hash) {
+        continue;
+      }
+      BlackFrameDetector& detector = GetBlackFrameDetector();
+      std::lock_guard<std::mutex> lock(detector.mutex);
+      BlackFrameDetector::FrameMask& mask =
+          detector.masks[detector.draw_frame % BlackFrameDetector::kMaskHistorySize];
+      if (mask.frame != detector.draw_frame) {
+        mask.frame = detector.draw_frame;
+        mask.mask = 0;
+      }
+      mask.mask |= uint32_t(1) << i;
+      detector.last_arm_frame = detector.draw_frame;
+      if (!detector.armed) {
+        detector.armed = true;
+        static uint32_t arm_logs_left = 256;
+        if (arm_logs_left) {
+          --arm_logs_left;
+          REXGPU_INFO("black_frame_detect: armed at frame {} by PS {:016X} (bit {})",
+                      detector.draw_frame, hash, i);
+        }
+        // Keep this frame from this draw on.
+        detector.recording = true;
+      }
+      break;
+    }
+  }
+  if (!IsBlackFrameDumpActive()) {
+    return;
+  }
+  auto surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  auto window_scissor_tl = regs.Get<reg::PA_SC_WINDOW_SCISSOR_TL>();
+  auto window_scissor_br = regs.Get<reg::PA_SC_WINDOW_SCISSOR_BR>();
+  auto window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+  std::string targets =
+      GetWrittenRenderTargetsLogString(regs, pixel_shader, host_rt_path, true, nullptr);
+  NoteBlackFrameDumpLine(fmt::format(
+      "Draw: VS {:016X} PS {:016X} prim {} edram_mode {} pitch {} msaa {}{}{} scissor TL ({}, "
+      "{}) BR ({}, {}) offset_disable {} window offset ({}, {}) textures:{}{}",
+      vertex_shader ? vertex_shader->ucode_data_hash() : 0,
+      pixel_shader ? pixel_shader->ucode_data_hash() : 0,
+      uint32_t(regs.Get<reg::VGT_DRAW_INITIATOR>().prim_type),
+      uint32_t(regs.Get<reg::RB_MODECONTROL>().edram_mode), uint32_t(surface_info.surface_pitch),
+      uint32_t(surface_info.msaa_samples), targets.empty() ? " no color" : targets,
+      GetDepthLogString(regs, true), uint32_t(window_scissor_tl.tl_x),
+      uint32_t(window_scissor_tl.tl_y), uint32_t(window_scissor_br.br_x),
+      uint32_t(window_scissor_br.br_y), uint32_t(window_scissor_tl.window_offset_disable),
+      int32_t(window_offset.window_x_offset), int32_t(window_offset.window_y_offset),
+      GetTextureFetchesLogString(regs, vertex_shader, "vs "),
+      GetTextureFetchesLogString(regs, pixel_shader, "")));
+}
