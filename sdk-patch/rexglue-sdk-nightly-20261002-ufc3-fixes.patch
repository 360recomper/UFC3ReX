+bool PhysicalHeap::GetSystemPageRange(uint32_t physical_address, uint32_t length,
+                                      uint32_t& first, uint32_t& last) const {
+  // Same mapping as EnableAccessCallbacks.
+  uint32_t physical_address_offset = GetPhysicalAddress(heap_base_);
+  if (physical_address < physical_address_offset) {
+    if (physical_address_offset - physical_address >= length) {
+      return false;
+    }
+    length -= physical_address_offset - physical_address;
+    physical_address = physical_address_offset;
+  }
+  uint32_t heap_relative_address = physical_address - physical_address_offset;
+  if (heap_relative_address >= heap_size_) {
+    return false;
+  }
+  length = std::min(length, heap_size_ - heap_relative_address);
+  if (!length) {
+    return false;
+  }
+  first = (heap_relative_address + host_address_offset()) / system_page_size_;
+  last = std::min((heap_relative_address + length - 1 + host_address_offset()) / system_page_size_,
+                  system_page_count_ - 1);
+  return first <= last;
+}
+
+rex::memory::PageAccess PhysicalHeap::GetUnreadWatchedAccess(uint32_t system_page) const {
+  uint32_t guest_page_number =
+      rex::sat_sub(system_page * system_page_size_, host_address_offset()) >> page_size_shift_;
+  if (guest_page_number >= page_table_.size()) {
+    return rex::memory::PageAccess::kNoAccess;
+  }
+  rex::memory::PageAccess access = ToPageAccess(page_table_[guest_page_number].current_protect);
+  if (access == rex::memory::PageAccess::kReadWrite &&
+      (system_page_flags_[system_page >> 6].notify_on_invalidation &
+       (uint64_t(1) << (system_page & 63)))) {
+    access = rex::memory::PageAccess::kReadOnly;
+  }
+  return access;
+}
+
+bool PhysicalHeap::EnableReadWatch(uint32_t physical_address, uint32_t length) {
+  uint32_t system_page_first, system_page_last;
+  if (!GetSystemPageRange(physical_address, length, system_page_first, system_page_last)) {
+    return false;
+  }
+  uint8_t* protect_base = membase_ + heap_base_;
+  bool any_watched = false;
+  uint32_t protect_first = UINT32_MAX;
+  for (uint32_t i = system_page_first; i <= system_page_last + 1; ++i) {
+    bool protect_page = false;
+    if (i <= system_page_last) {
+      uint64_t& flags = system_page_flags_[i >> 6].notify_on_read;
+      uint64_t bit = uint64_t(1) << (i & 63);
+      if (flags & bit) {
+        any_watched = true;
+      } else if (GetUnreadWatchedAccess(i) != rex::memory::PageAccess::kNoAccess) {
+        // Inaccessible pages need real access violations - not watched.
+        flags |= bit;
+        any_watched = true;
+        protect_page = true;
+      }
+    }
+    if (protect_page) {
+      if (protect_first == UINT32_MAX) {
+        protect_first = i;
+      }
+    } else if (protect_first != UINT32_MAX) {
+      rex::memory::Protect(protect_base + size_t(protect_first) * system_page_size_,
+                           size_t(i - protect_first) * system_page_size_,
+                           rex::memory::PageAccess::kNoAccess);
+      protect_first = UINT32_MAX;
+    }
+  }
+  return any_watched;
+}
+
+void PhysicalHeap::DisableReadWatch(uint32_t physical_address, uint32_t length) {
+  uint32_t system_page_first, system_page_last;
+  if (GetSystemPageRange(physical_address, length, system_page_first, system_page_last)) {
+    ClearReadWatches(system_page_first, system_page_last, true);
+  }
+}
+
+void PhysicalHeap::ClearReadWatches(uint32_t system_page_first, uint32_t system_page_last,
+                                    bool restore_protection) {
+  // Runs of pages getting the same access share one Protect call.
+  uint8_t* protect_base = membase_ + heap_base_;
+  uint32_t run_first = UINT32_MAX;
+  rex::memory::PageAccess run_access = rex::memory::PageAccess::kNoAccess;
+  auto flush_run = [&](uint32_t run_end) {
+    if (run_first != UINT32_MAX) {
+      rex::memory::Protect(protect_base + size_t(run_first) * system_page_size_,
+                           size_t(run_end - run_first) * system_page_size_, run_access);
+      run_first = UINT32_MAX;
+    }
+  };
+  for (uint32_t i = system_page_first; i <= system_page_last; ++i) {
+    uint64_t& flags = system_page_flags_[i >> 6].notify_on_read;
+    uint64_t bit = uint64_t(1) << (i & 63);
+    if (!(flags & bit)) {
+      flush_run(i);
+      continue;
+    }
+    flags &= ~bit;
+    if (!restore_protection) {
+      continue;
+    }
+    rex::memory::PageAccess access = GetUnreadWatchedAccess(i);
+    if (run_first != UINT32_MAX && access != run_access) {
+      flush_run(i);
+    }
+    if (run_first == UINT32_MAX) {
+      run_first = i;
+      run_access = access;
+    }
+  }
+  flush_run(system_page_last + 1);
+}
+
+bool PhysicalHeap::IsReadWatched(uint32_t virtual_address) const {
+  if (virtual_address < heap_base_ || virtual_address - heap_base_ >= heap_size_) {
+    return false;
+  }
+  uint32_t system_page =
+      (virtual_address - heap_base_ + host_address_offset()) / system_page_size_;
+  if (system_page >= system_page_count_) {
+    return false;
+  }
+  return (system_page_flags_[system_page >> 6].notify_on_read &
+          (uint64_t(1) << (system_page & 63))) != 0;
+}
+
+bool PhysicalHeap::IsPhysicalPageReadWatched(uint32_t physical_address) const {
+  uint32_t system_page_first, system_page_last;
+  if (!GetSystemPageRange(physical_address, 1, system_page_first, system_page_last)) {
+    return false;
+  }
+  return (system_page_flags_[system_page_first >> 6].notify_on_read &
+          (uint64_t(1) << (system_page_first & 63))) != 0;
+}
