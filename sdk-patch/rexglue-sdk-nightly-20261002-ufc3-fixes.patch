+void CommandProcessor::WriteMemexportReadbackToGuest(uint32_t physical_address,
+                                                     const uint8_t* source,
+                                                     const uint8_t* guest_before, uint32_t size) {
+  // A stream's declared size can be far larger than what the shader writes
+  // (UFC 3's texture compressor declares 24 MB for a 4 MB texture), and the
+  // rest of the range can hold live data the CPU changed since the draw: with
+  // guest_before (guest memory at draw time), only the dwords the shader
+  // changed are written. The guest page table can't tell which bytes the game
+  // uses (skipping the uncommitted tail turned created fighters' heads black),
+  // so free pages are written too, and only host faults are avoided - the
+  // physical view is committed read-write except where the guest committed
+  // pages read-only or no-access, and a write there would crash.
+  constexpr uint64_t kPhysicalMemorySize = 0x20000000;
+  physical_address &= 0x1FFFFFFF;
+  const uint64_t end = std::min(uint64_t(physical_address) + size, kPhysicalMemorySize);
+  const uint32_t length = uint32_t(end - physical_address);
+  const uint64_t clamped = uint64_t(size) - length;
+  uint8_t* const dest = memory_->TranslatePhysical(physical_address);
+
+  if (REXCVAR_GET(memexport_readback_log)) {
+    if (memexport_readback_first_address_ == UINT32_MAX) {
+      memexport_readback_first_address_ = physical_address;
+    }
+    memexport_readback_nonzero_ +=
+        uint64_t(std::count_if(source, source + length, [](uint8_t value) { return value != 0; }));
+  }
+
+  // The first 16 readbacks log their guest state.
+  static uint32_t diagnostics_left = 16;
+  const bool log = diagnostics_left != 0;
+  if (log) {
+    --diagnostics_left;
+  }
+
+  // Diagnostics while logging: the guest state of the range.
+  uint64_t guest_free = 0, guest_reserved = 0, guest_read_only = 0;
+  if (log) {
+    memory::BaseHeap* heap = memory_->GetPhysicalHeap();
+    const uint32_t page_mask = heap->page_size() - 1;
+    uint32_t address = physical_address;
+    while (address < end) {
+      memory::HeapAllocationInfo info;
+      if (!heap->QueryRegionInfo(address, &info) || !info.region_size) {
+        break;
+      }
+      const uint32_t run_length =
+          uint32_t(std::min(uint64_t(info.region_size - (address & page_mask)), end - address));
+      if (!(info.state & memory::kMemoryAllocationCommit)) {
+        (info.state & memory::kMemoryAllocationReserve ? guest_reserved : guest_free) += run_length;
+      } else if (!(info.protect &
+                   (memory::kMemoryProtectWrite | memory::kMemoryProtectWriteCombine))) {
+        guest_read_only += run_length;
+      }
+      address += run_length;
+    }
+  }
+
+  uint64_t written = 0, unprotected = 0, skipped = 0;
+  uint32_t changed_end = 0;
+  const uintptr_t host_page_mask = uintptr_t(memory::page_size() - 1);
+  uint32_t offset = 0;
+  while (offset < length) {
+    uint8_t* const run_dest = dest + offset;
+    const uintptr_t run_page = reinterpret_cast<uintptr_t>(run_dest) & ~host_page_mask;
+    memory::PageAccess access;
+    size_t region_length;
+    if (!memory::QueryProtect(run_dest, region_length, access)) {
+      skipped += length - offset;
+      break;
+    }
+    const uint32_t run_length =
+        uint32_t(std::min(uint64_t(region_length - (reinterpret_cast<uintptr_t>(run_dest) -
+                                                    run_page)),
+                          uint64_t(length - offset)));
+    const uint8_t* const run_before = guest_before ? guest_before + offset : nullptr;
+    if (access == memory::PageAccess::kReadWrite ||
+        access == memory::PageAccess::kExecuteReadWrite) {
+      written += CopyChangedDwords(run_dest, source + offset, run_before, run_length, offset,
+                                   changed_end);
+    } else if (!run_before || std::memcmp(source + offset, run_before, run_length)) {
+      // The guest page table syncs host access under the global lock.
+      auto global_lock = rex::thread::global_critical_region::AcquireDirect();
+      memory::PageAccess old_access;
+      if (memory::Protect(run_dest, run_length, memory::PageAccess::kReadWrite, &old_access)) {
+        written += CopyChangedDwords(run_dest, source + offset, run_before, run_length, offset,
+                                     changed_end);
+        memory::Protect(run_dest, run_length, old_access);
+        unprotected += run_length;
+      } else {
+        skipped += run_length;
+      }
+    }
+    offset += run_length;
+  }
+  memexport_readback_written_ += written;
+
+  if (log) {
+    REXGPU_WARN(
+        "Memexport readback to {:08X} ({} bytes declared): wrote {} changed bytes, up to +{}; "
+        "guest pages free {}, reserved {}, read-only {}; host pages unprotected for the copy "
+        "{}, skipped {}, past 512 MB {}",
+        physical_address, size, written, changed_end, guest_free, guest_reserved,
+        guest_read_only, unprotected, skipped, clamped);
+  }
+}
+
+void CommandProcessor::TrackOnDemandResolve(uint32_t address, uint32_t length, bool scaled) {
+  constexpr uint64_t kPhysicalMemorySize = 0x20000000;
+  address &= 0x1FFFFFFF;
+  length = uint32_t(std::min(uint64_t(address) + length, kPhysicalMemorySize) - address);
+  if (!length) {
+    return;
+  }
+  uint32_t pixel_size_log2 = 0;
+  if (scaled) {
+    // The downscale works on 32x32 tiles of the destination format.
+    reg::RB_COPY_DEST_INFO copy_dest_info = register_file_->Get<reg::RB_COPY_DEST_INFO>();
+    uint32_t bits_per_pixel =
+        FormatInfo::Get(uint32_t(copy_dest_info.copy_dest_format))->bits_per_pixel;
+    switch (bits_per_pixel) {
+      case 8:
+        pixel_size_log2 = 0;
+        break;
+      case 16:
+        pixel_size_log2 = 1;
+        break;
+      case 32:
+        pixel_size_log2 = 2;
+        break;
+      case 64:
+        pixel_size_log2 = 3;
+        break;
+      default: {
+        static bool logged = false;
+        if (!logged) {
+          logged = true;
+          REXGPU_WARN("On-demand resolve readback: can't downscale {} bpp resolves, not tracked",
+                      bits_per_pixel);
+        }
+        return;
+      }
+    }
+  }
+  // A readback reads the current data, so a resolve covering an older one
+  // replaces it.
+  ondemand_resolves_.erase(
+      std::remove_if(ondemand_resolves_.begin(), ondemand_resolves_.end(),
+                     [&](const OnDemandResolve& resolve) {
+                       return resolve.address >= address &&
+                              uint64_t(resolve.address) + resolve.length <=
+                                  uint64_t(address) + length;
+                     }),
+      ondemand_resolves_.end());
+  if (!memory_->EnablePhysicalMemoryReadWatch(address, length)) {
+    // Nothing the guest can access.
+    return;
+  }
+  ondemand_resolves_.push_back({address, length, pixel_size_log2, scaled});
+
+  // Drop resolves whose pages the guest reallocated or overwrote since. The
+  // sweep walks pages under the global lock, so if most resolves are still
+  // hidden, it waits until the list has doubled instead of running on every
+  // resolve.
+  if (ondemand_resolves_.size() > ondemand_sweep_size_) {
+    const uint32_t page_size = uint32_t(rex::memory::page_size());
+    auto global_lock = rex::thread::global_critical_region::AcquireDirect();
+    ondemand_resolves_.erase(
+        std::remove_if(ondemand_resolves_.begin(), ondemand_resolves_.end(),
+                       [&](const OnDemandResolve& resolve) {
+                         uint64_t end = uint64_t(resolve.address) + resolve.length;
+                         for (uint64_t page = resolve.address & ~(page_size - 1); page < end;
+                              page += page_size) {
+                           if (memory_->IsPhysicalMemoryReadWatched(uint32_t(page))) {
+                             return false;
+                           }
+                         }
+                         return true;
+                       }),
+        ondemand_resolves_.end());
+    ondemand_sweep_size_ = std::max(size_t(1024), ondemand_resolves_.size() * 2);
+  }
+}
+
+bool CommandProcessor::OnDemandDataProviderThunk(
+    void* context, uint32_t physical_address, std::unique_lock<std::recursive_mutex> global_lock) {
+  return static_cast<CommandProcessor*>(context)->OnDemandDataProvider(physical_address,
+                                                                       std::move(global_lock));
+}
+
+bool CommandProcessor::OnDemandDataProvider(uint32_t physical_address,
+                                            std::unique_lock<std::recursive_mutex> global_lock) {
+  const bool on_gpu_thread = system::XThread::IsInThread(worker_thread_.get());
+  const bool in_interrupt = runtime::FunctionDispatcher::IsInInterrupt();
+  const char* const thread_kind =
+      on_gpu_thread ? " (GPU thread)" : (in_interrupt ? " (interrupt)" : "");
+  // Logged before anything can go wrong, so a crash shows the last step.
+  if (ondemand_request_logs_.fetch_add(1, std::memory_order_relaxed) < 32 ||
+      REXCVAR_GET(readback_resolve_ondemand_log)) {
+    REXGPU_INFO("On-demand resolve readback request: {:08X} from thread {:X}{}", physical_address,
+                rex::thread::current_thread_id(), thread_kind);
+  }
+
+  // The GPU thread faults here from a guest interrupt callback in the middle
+  // of a packet, where it can't read back, and any interrupt holds the global
+  // lock (ExecuteInterrupt) that the GPU thread needs to serve a request, so
+  // waiting would deadlock. Such an access gets the page as it is, like
+  // readback_resolve=none; the resolves stay tracked for their other pages.
+  if (on_gpu_thread || in_interrupt) {
+    if (ondemand_skip_logs_.fetch_add(1, std::memory_order_relaxed) < 16) {
+      REXGPU_WARN("On-demand readback skipped ({}): {:08X} thread {:X}",
+                  on_gpu_thread ? "GPU thread" : "interrupt", physical_address,
+                  rex::thread::current_thread_id());
+    }
+    memory_->DisablePhysicalMemoryReadWatch(physical_address, 1);
+    return true;
+  }
+
+  // The command processor thread takes the global lock to unhide the pages.
+  if (global_lock.owns_lock()) {
+    global_lock.unlock();
+  }
+  uint64_t ticket;
+  {
+    std::lock_guard<std::mutex> lock(ondemand_mutex_);
+    ondemand_requests_.push_back(physical_address);
+    ticket = ++ondemand_requested_;
+    ondemand_request_pending_.store(true, std::memory_order_release);
+  }
+  write_ptr_index_event_->Set();
+  const auto wait_start = std::chrono::steady_clock::now();
+  std::unique_lock<std::mutex> lock(ondemand_mutex_);
+  while (ondemand_served_ < ticket) {
+    if (!worker_running_) {
+      lock.unlock();
+      memory_->DisablePhysicalMemoryReadWatch(physical_address, 1);
+      return true;
+    }
+    ondemand_served_cv_.wait_for(lock, std::chrono::milliseconds(100));
+    if (ondemand_served_ < ticket &&
+        std::chrono::steady_clock::now() - wait_start > std::chrono::seconds(5)) {
+      // A case F1 doesn't know (this thread still holding the global lock the
+      // GPU thread needs): give the page back as it is rather than freeze. The
+      // queued request is still served later, for the other pages.
+      lock.unlock();
+      REXGPU_WARN(
+          "On-demand resolve readback of {:08X}: thread {:X} gave up after waiting 5 s for the "
+          "GPU thread, page given back unread",
+          physical_address, rex::thread::current_thread_id());
+      memory_->DisablePhysicalMemoryReadWatch(physical_address, 1);
+      return true;
+    }
+  }
+  const double wait_ms =
+      std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - wait_start)
+          .count();
+  ++ondemand_wait_stats_.waits;
+  ondemand_wait_stats_.ms += wait_ms;
+  ondemand_wait_stats_.max_ms = std::max(ondemand_wait_stats_.max_ms, wait_ms);
+  return true;
+}
+
+void CommandProcessor::ServiceOnDemandReadbackRequests() {
+  std::vector<uint32_t> requests;
+  uint64_t requested;
+  {
+    std::lock_guard<std::mutex> lock(ondemand_mutex_);
+    requests.swap(ondemand_requests_);
+    requested = ondemand_requested_;
+    ondemand_request_pending_.store(false, std::memory_order_relaxed);
+  }
+  ReadBackOnDemand(requests);
+  {
+    std::lock_guard<std::mutex> lock(ondemand_mutex_);
+    ondemand_served_ = requested;
+  }
+  ondemand_served_cv_.notify_all();
+}
+
+void CommandProcessor::ReadBackOnDemand(const std::vector<uint32_t>& physical_addresses) {
+  const uint32_t page_size = uint32_t(rex::memory::page_size());
+  const uint32_t page_mask = ~(page_size - 1);
+
+  using PageRange = std::pair<uint32_t, uint32_t>;
+  // Page-aligned [start, end) of a range (ends at most at 512 MB).
+  auto page_range = [&](uint32_t address, uint32_t length) {
+    return PageRange(address & page_mask,
+                     uint32_t((uint64_t(address) + length + page_size - 1) & page_mask));
+  };
+  if (physical_addresses.empty()) {
+    return;
+  }
+  const auto serve_start = std::chrono::steady_clock::now();
+
+  std::vector<uint32_t> pages;
+  pages.reserve(physical_addresses.size());
+  for (uint32_t physical_address : physical_addresses) {
+    pages.push_back(physical_address & 0x1FFFFFFF & page_mask);
+  }
+  std::sort(pages.begin(), pages.end());
+  pages.erase(std::unique(pages.begin(), pages.end()), pages.end());
+
+  // Only the resolves on the requested pages. Their neighbours stay hidden
+  // until the CPU touches them too (reading all of a chain of overlapping
+  // resolves at once is what made saving and shirt changes hitch).
+  std::vector<OnDemandResolve> picked;
+  size_t kept = 0;
+  for (size_t i = 0; i < ondemand_resolves_.size(); ++i) {
+    const OnDemandResolve& resolve = ondemand_resolves_[i];
+    PageRange range = page_range(resolve.address, resolve.length);
+    auto page_it = std::lower_bound(pages.begin(), pages.end(), range.first);
+    if (page_it != pages.end() && *page_it < range.second) {
+      picked.push_back(resolve);
+    } else {
+      ondemand_resolves_[kept++] = resolve;
+    }
+  }
+  ondemand_resolves_.resize(kept);
+
+  // A readback copies the current GPU data, not a snapshot, so the order of
+  // overlapping resolves doesn't matter, and overlapping or touching ones are
+  // read in one copy (scaled ones only along whole 32x32 downscale tiles).
+  std::sort(picked.begin(), picked.end(),
+            [](const OnDemandResolve& a, const OnDemandResolve& b) {
+              if (a.scaled != b.scaled) {
+                return a.scaled < b.scaled;
+              }
+              if (a.pixel_size_log2 != b.pixel_size_log2) {
+                return a.pixel_size_log2 < b.pixel_size_log2;
+              }
+              return a.address < b.address;
+            });
+  std::vector<OnDemandResolve> resolves;
+  for (const OnDemandResolve& resolve : picked) {
+    if (!resolves.empty()) {
+      OnDemandResolve& run = resolves.back();
+      uint64_t run_end = uint64_t(run.address) + run.length;
+      uint32_t tile_mask = (uint32_t(1024) << resolve.pixel_size_log2) - 1;
+      if (run.scaled == resolve.scaled && run.pixel_size_log2 == resolve.pixel_size_log2 &&
+          resolve.address <= run_end &&
+          (!resolve.scaled || !((run.address | run.length | resolve.address | resolve.length) &
+                                tile_mask))) {
+        run.length = uint32_t(std::max(run_end, uint64_t(resolve.address) + resolve.length) -
+                              run.address);
+        continue;
+      }
+    }
+    resolves.push_back(resolve);
+  }
+
+  if (ondemand_serve_logs_ < 32 || REXCVAR_GET(readback_resolve_ondemand_log)) {
+    ++ondemand_serve_logs_;
+    REXGPU_INFO(
+        "On-demand resolve readback: serving {} requests (first {:08X}): {} resolves in {} "
+        "copies, {} still hidden",
+        physical_addresses.size(), physical_addresses[0],
+        picked.size(), resolves.size(), ondemand_resolves_.size());
+  }
+
+  for (const OnDemandResolve& resolve : resolves) {
+    const auto start = std::chrono::steady_clock::now();
+    const uint8_t* data = ReadBackGpuRange(resolve.address, resolve.length,
+                                           resolve.pixel_size_log2, resolve.scaled);
+    if (data) {
+      // Only pages still hidden: the guest may have reallocated the others
+      // or written them outside its views (file reads) since.
+      auto global_lock = rex::thread::global_critical_region::AcquireDirect();
+      uint32_t offset = 0;
+      while (offset < resolve.length) {
+        uint32_t address = resolve.address + offset;
+        uint32_t run_length =
+            std::min(page_size - (address & (page_size - 1)), resolve.length - offset);
+        if (memory_->IsPhysicalMemoryReadWatched(address)) {
+          WriteGuestPhysical(memory_->TranslatePhysical(address), data + offset, run_length);
+        }
+        offset += run_length;
+      }
+    }
+    const double ms =
+        std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start)
+            .count();
+    OnDemandReadbackStats& stats = ondemand_stats_;
+    ++stats.readbacks;
+    stats.bytes += resolve.length;
+    stats.ms += ms;
+    stats.max_ms = std::max(stats.max_ms, ms);
+    if (!data) {
+      REXGPU_WARN("On-demand resolve readback {}: {:08X}, {} bytes{}: GPU readback failed",
+                  stats.readbacks, resolve.address, resolve.length,
+                  resolve.scaled ? ", scaled" : "");
+    } else if (stats.readbacks <= 32 || REXCVAR_GET(readback_resolve_ondemand_log)) {
+      REXGPU_INFO("On-demand resolve readback {}: {:08X}, {} bytes{}, {:.2f} ms", stats.readbacks,
+                  resolve.address, resolve.length, resolve.scaled ? ", scaled" : "", ms);
+    }
+    if (!(stats.readbacks % 64)) {
+      OnDemandWaitStats wait_stats;
+      {
+        std::lock_guard<std::mutex> lock(ondemand_mutex_);
+        wait_stats = ondemand_wait_stats_;
+      }
+      REXGPU_INFO(
+          "On-demand resolve readbacks: {} so far, {:.1f} MB, {:.0f} ms total, avg {:.2f} ms, "
+          "slowest {:.1f} ms; {} serves, avg {:.2f} ms, slowest {:.1f} ms; threads stopped {} "
+          "times, avg {:.2f} ms, slowest {:.1f} ms; {} resolves still hidden",
+          stats.readbacks, stats.bytes / 1048576.0, stats.ms, stats.ms / stats.readbacks,
+          stats.max_ms, stats.serves, stats.serves ? stats.serve_ms / stats.serves : 0.0,
+          stats.max_serve_ms, wait_stats.waits,
+          wait_stats.waits ? wait_stats.ms / wait_stats.waits : 0.0, wait_stats.max_ms,
+          ondemand_resolves_.size());
+    }
+  }
+
+  // Unhide the requested pages, and the pages of what was read back that no
+  // still hidden resolve shares (those get filled when it is read back).
+  std::vector<PageRange> hidden;
+  hidden.reserve(ondemand_resolves_.size());
+  for (const OnDemandResolve& resolve : ondemand_resolves_) {
+    hidden.push_back(page_range(resolve.address, resolve.length));
+  }
+  std::sort(hidden.begin(), hidden.end());
+  size_t hidden_count = 0;
+  for (const PageRange& range : hidden) {
+    if (hidden_count && range.first <= hidden[hidden_count - 1].second) {
+      hidden[hidden_count - 1].second = std::max(hidden[hidden_count - 1].second, range.second);
+    } else {
+      hidden[hidden_count++] = range;
+    }
+  }
+  hidden.resize(hidden_count);
+  std::vector<PageRange> unhide;
+  for (uint32_t page : pages) {
+    unhide.emplace_back(page, page + page_size);
+  }
+  for (const OnDemandResolve& resolve : resolves) {
+    PageRange range = page_range(resolve.address, resolve.length);
+    uint32_t start = range.first;
+    auto hidden_it = std::upper_bound(
+        hidden.begin(), hidden.end(), start,
+        [](uint32_t address, const PageRange& hidden_range) { return address < hidden_range.second; });
+    for (; hidden_it != hidden.end() && hidden_it->first < range.second; ++hidden_it) {
+      if (hidden_it->first > start) {
+        unhide.emplace_back(start, hidden_it->first);
+      }
+      start = std::max(start, hidden_it->second);
+    }
+    if (start < range.second) {
+      unhide.emplace_back(start, range.second);
+    }
+  }
+  for (const PageRange& range : unhide) {
+    memory_->DisablePhysicalMemoryReadWatch(range.first, range.second - range.first);
+  }
+
+  const double serve_ms =
+      std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - serve_start)
+          .count();
+  ++ondemand_stats_.serves;
+  ondemand_stats_.serve_ms += serve_ms;
+  ondemand_stats_.max_serve_ms = std::max(ondemand_stats_.max_serve_ms, serve_ms);
+}
