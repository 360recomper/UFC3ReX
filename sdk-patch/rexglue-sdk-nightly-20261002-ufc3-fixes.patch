+bool D3D12CommandProcessor::RecordResolveDownscale(ID3D12Resource* source, uint64_t source_offset,
+                                                   ID3D12Resource* dest, uint64_t dest_offset,
+                                                   uint32_t length, uint32_t pixel_size_log2,
+                                                   bool box, bool half_pixel_offset,
+                                                   bool& box_out, const char*& failure_reason) {
+  box_out = false;
+  uint32_t tile_count = length >> (10 + pixel_size_log2);
+  if (!tile_count) {
+    failure_reason = "shorter than one 32x32 tile";
+    return false;
+  }
+  ui::d3d12::util::DescriptorCpuGpuHandlePair downscale_descriptors[2];
+  if (!RequestOneUseSingleViewDescriptors(2, downscale_descriptors)) {
+    failure_reason = "no view descriptors";
+    return false;
+  }
+  uint32_t scale_area =
+      texture_cache_->draw_resolution_scale_x() * texture_cache_->draw_resolution_scale_y();
+  uint32_t tiles_length = tile_count << (10 + pixel_size_log2);
+  ID3D12Device* device = GetD3D12Provider().GetDevice();
+  ui::d3d12::util::CreateBufferRawSRV(
+      device, downscale_descriptors[0].first, source,
+      rex::align(tiles_length * scale_area, uint32_t(D3D12_RAW_UAV_SRV_BYTE_ALIGNMENT)),
+      source_offset);
+  ui::d3d12::util::CreateBufferRawUAV(
+      device, downscale_descriptors[1].first, dest,
+      rex::align(tiles_length, uint32_t(D3D12_RAW_UAV_SRV_BYTE_ALIGNMENT)), dest_offset);
+
+  box_out = box && pixel_size_log2 == 2 && resolve_downscale_box_pipeline_;
+  SetExternalPipeline(box_out ? resolve_downscale_box_pipeline_.Get()
+                              : resolve_downscale_pipeline_.Get());
+  deferred_command_list_.D3DSetComputeRootSignature(resolve_downscale_root_signature_.Get());
+  ResolveDownscaleConstants constants;
+  constants.scale_x = texture_cache_->draw_resolution_scale_x();
+  constants.scale_y = texture_cache_->draw_resolution_scale_y();
+  constants.pixel_size_log2 = pixel_size_log2;
+  constants.tile_count = tile_count;
+  constants.half_pixel_offset = half_pixel_offset ? 1u : 0u;
+  deferred_command_list_.D3DSetComputeRoot32BitConstants(
+      UINT(ResolveDownscaleRootParameter::kConstants), sizeof(constants) / sizeof(uint32_t),
+      &constants, 0);
+  deferred_command_list_.D3DSetComputeRootDescriptorTable(
+      UINT(ResolveDownscaleRootParameter::kSource), downscale_descriptors[0].second);
+  deferred_command_list_.D3DSetComputeRootDescriptorTable(
+      UINT(ResolveDownscaleRootParameter::kDestination), downscale_descriptors[1].second);
+  deferred_command_list_.D3DDispatch(tile_count, 1, 1);
+  return true;
+}
+
+TextureCache* D3D12CommandProcessor::GetReadbackTextureCache() { return texture_cache_.get(); }
+
+const uint8_t* D3D12CommandProcessor::ReadBackGpuRange(uint32_t address, uint32_t length,
+                                                       uint32_t pixel_size_log2, bool scaled,
+                                                       bool box_format,
+                                                       const char*& failure_reason) {
+  failure_reason = nullptr;
+  if (!BeginSubmission(false)) {
+    failure_reason = "couldn't begin a submission";
+    return nullptr;
+  }
+
+  const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  uint32_t size = AlignReadbackBufferSize(length);
+  if (size > ondemand_readback_buffer_size_) {
+    // The previous readback was awaited, so the old buffer is idle.
+    if (ondemand_readback_buffer_) {
+      ondemand_readback_buffer_->Unmap(0, nullptr);
+      ondemand_readback_buffer_.Reset();
+      ondemand_readback_buffer_size_ = 0;
+      ondemand_readback_mapping_ = nullptr;
+    }
+    D3D12_RESOURCE_DESC buffer_desc;
+    ui::d3d12::util::FillBufferResourceDesc(buffer_desc, size, D3D12_RESOURCE_FLAG_NONE);
+    if (FAILED(device->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesReadback, provider.GetHeapFlagCreateNotZeroed(),
+            &buffer_desc, D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+            IID_PPV_ARGS(&ondemand_readback_buffer_)))) {
+      REXGPU_ERROR("Failed to create a {} MB on-demand resolve readback buffer", size >> 20);
+      failure_reason = "couldn't create the readback buffer";
+      return nullptr;
+    }
+    D3D12_RANGE read_range = {0, size};
+    if (FAILED(ondemand_readback_buffer_->Map(0, &read_range, &ondemand_readback_mapping_))) {
+      REXGPU_ERROR("Failed to map the on-demand resolve readback buffer");
+      ondemand_readback_buffer_.Reset();
+      ondemand_readback_mapping_ = nullptr;
+      failure_reason = "couldn't map the readback buffer";
+      return nullptr;
+    }
+    ondemand_readback_buffer_size_ = size;
+  }
+
+  if (!RecordGpuRangeReadback(address, length, pixel_size_log2, scaled, box_format,
+                              ondemand_readback_buffer_.Get(), failure_reason)) {
+    return nullptr;
+  }
+  if (!AwaitAllQueueOperationsCompletion()) {
+    failure_reason = "couldn't await the GPU";
+    return nullptr;
+  }
+  return static_cast<const uint8_t*>(ondemand_readback_mapping_);
+}
+
+uint32_t D3D12CommandProcessor::RecordReadbackAhead(uint32_t address, uint32_t length,
+                                                    uint32_t pixel_size_log2, bool scaled,
+                                                    bool box_format) {
+  // Small enough to never matter for memory, large enough for a few copies
+  // of each picture in flight (a released slot is reused once its submission
+  // has completed).
+  constexpr size_t kMaxSlots = 64;
+  constexpr uint64_t kMaxTotalSize = 64 * 1024 * 1024;
+  if (!BeginSubmission(false)) {
+    return 0;
+  }
+  const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  const uint32_t size = AlignReadbackBufferSize(length);
+  const uint64_t completed_submission = GetCompletedSubmission();
+
+  // The smallest idle slot that fits, else a new one.
+  ReadbackAheadSlot* slot = nullptr;
+  for (ReadbackAheadSlot& candidate : readback_ahead_slots_) {
+    if (!candidate.in_use && candidate.submission <= completed_submission &&
+        candidate.size >= size && (!slot || candidate.size < slot->size)) {
+      slot = &candidate;
+    }
+  }
+  if (!slot) {
+    if (readback_ahead_slots_.size() >= kMaxSlots ||
+        readback_ahead_total_size_ + size > kMaxTotalSize) {
+      return 0;
+    }
+    ReadbackAheadSlot new_slot;
+    D3D12_RESOURCE_DESC buffer_desc;
+    ui::d3d12::util::FillBufferResourceDesc(buffer_desc, size, D3D12_RESOURCE_FLAG_NONE);
+    if (FAILED(device->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesReadback, provider.GetHeapFlagCreateNotZeroed(),
+            &buffer_desc, D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+            IID_PPV_ARGS(&new_slot.buffer)))) {
+      return 0;
+    }
+    D3D12_RANGE read_range = {0, size};
+    if (FAILED(new_slot.buffer->Map(0, &read_range, &new_slot.mapping))) {
+      return 0;
+    }
+    new_slot.size = size;
+    readback_ahead_total_size_ += size;
+    readback_ahead_slots_.push_back(std::move(new_slot));
+    slot = &readback_ahead_slots_.back();
+  }
+
+  const uint32_t box_bytes_before = readback_box_bytes_;
+  readback_box_bytes_ = 0;
+  const char* failure_reason = nullptr;
+  bool recorded = RecordGpuRangeReadback(address, length, pixel_size_log2, scaled, box_format,
+                                         slot->buffer.Get(), failure_reason);
+  const uint32_t box_bytes = readback_box_bytes_;
+  readback_box_bytes_ = box_bytes_before;
+  if (!recorded) {
+    return 0;
+  }
+  slot->submission = GetCurrentSubmission();
+  slot->box_bytes = box_bytes;
+  slot->in_use = true;
+  return uint32_t(slot - readback_ahead_slots_.data()) + 1;
+}
+
+const uint8_t* D3D12CommandProcessor::AwaitReadbackAhead(uint32_t slot_index,
+                                                         uint32_t& box_bytes, bool& waited,
+                                                         const char*& failure_reason) {
+  failure_reason = nullptr;
+  waited = false;
+  if (!slot_index || slot_index > readback_ahead_slots_.size()) {
+    failure_reason = "no such slot";
+    return nullptr;
+  }
+  ReadbackAheadSlot& slot = readback_ahead_slots_[slot_index - 1];
+  // Refresh how far the GPU is without waiting.
+  CheckSubmissionFence(0);
+  if (GetCompletedSubmission() < slot.submission) {
+    // Only up to the copy's submission (ends it if it is the open one).
+    waited = true;
+    CheckSubmissionFence(slot.submission);
+    if (GetCompletedSubmission() < slot.submission) {
+      failure_reason = "couldn't await the copy's submission";
+      return nullptr;
+    }
+  }
+  box_bytes = slot.box_bytes;
+  return static_cast<const uint8_t*>(slot.mapping);
+}
+
+void D3D12CommandProcessor::ReleaseReadbackAhead(uint32_t slot_index) {
+  if (slot_index && slot_index <= readback_ahead_slots_.size()) {
+    readback_ahead_slots_[slot_index - 1].in_use = false;
+  }
+}
+
+bool D3D12CommandProcessor::RecordGpuRangeReadback(uint32_t address, uint32_t length,
+                                                   uint32_t pixel_size_log2, bool scaled,
+                                                   bool box_format, ID3D12Resource* dest_buffer,
+                                                   const char*& failure_reason) {
+  failure_reason = nullptr;
+  const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  const uint32_t size = AlignReadbackBufferSize(length);
+
+  if (scaled) {
+    if (!resolve_downscale_pipeline_ || !resolve_downscale_root_signature_) {
+      failure_reason = "no downscale pipeline";
+      return false;
+    }
+    uint32_t tile_count = length >> (10 + pixel_size_log2);
+    if (!tile_count) {
+      failure_reason = "shorter than one 32x32 tile";
+      return false;
+    }
+    if (!texture_cache_->MakeScaledResolveRangeCurrent(address, length)) {
+      failure_reason = "couldn't make the scaled resolve range current";
+      return false;
+    }
+    uint32_t scaled_length = uint32_t(texture_cache_->GetCurrentScaledResolveRangeLengthScaled());
+    uint64_t scaled_address = texture_cache_->GetCurrentScaledResolveRangeStartScaled();
+    ID3D12Resource* scaled_resolve_buffer = texture_cache_->GetCurrentScaledResolveBufferResource();
+    uint64_t scaled_buffer_base =
+        uint64_t(texture_cache_->GetCurrentScaledResolveBufferIndexPublic()) << 30;
+    if (!scaled_length || !scaled_resolve_buffer || scaled_address < scaled_buffer_base) {
+      failure_reason = "no current scaled resolve buffer for the range";
+      return false;
+    }
+
+    if (size > resolve_downscale_buffer_size_) {
+      D3D12_RESOURCE_DESC buffer_desc;
+      ui::d3d12::util::FillBufferResourceDesc(buffer_desc, size,
+                                              D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS);
+      ID3D12Resource* buffer = nullptr;
+      if (FAILED(device->CreateCommittedResource(
+              &ui::d3d12::util::kHeapPropertiesDefault, provider.GetHeapFlagCreateNotZeroed(),
+              &buffer_desc, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
+              IID_PPV_ARGS(&buffer)))) {
+        REXGPU_ERROR("Failed to create a {} MB resolve downscale buffer", size >> 20);
+        failure_reason = "couldn't create the downscale buffer";
+        return false;
+      }
+      if (resolve_downscale_buffer_) {
+        resources_for_deletion_.emplace_back(GetCurrentSubmission(),
+                                             resolve_downscale_buffer_.Detach());
+      }
+      resolve_downscale_buffer_.Attach(buffer);
+      resolve_downscale_buffer_size_ = size;
+    }
+
+    // Tiles rendered at the scale are averaged, the rest (upscaled 1x data)
+    // takes the center sample.
+    std::vector<TextureCache::DownscaleSegment> segments;
+    texture_cache_->GetDownscaleSegments(address, length, pixel_size_log2, box_format, segments);
+
+    PushUAVBarrier(scaled_resolve_buffer);
+    texture_cache_->TransitionCurrentScaledResolveRange(
+        D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    SubmitBarriers();
+
+    uint32_t scale_area =
+        texture_cache_->draw_resolution_scale_x() * texture_cache_->draw_resolution_scale_y();
+    bool half_pixel_offset = REXCVAR_GET(readback_resolve_half_pixel_offset) && scale_area > 1;
+    // The segments write disjoint parts of the downscale buffer.
+    for (const TextureCache::DownscaleSegment& segment : segments) {
+      bool segment_box;
+      if (!RecordResolveDownscale(
+              scaled_resolve_buffer,
+              scaled_address - scaled_buffer_base + uint64_t(segment.offset) * scale_area,
+              resolve_downscale_buffer_.Get(), segment.offset, segment.length, pixel_size_log2,
+              segment.box, half_pixel_offset, segment_box, failure_reason)) {
+        texture_cache_->TransitionCurrentScaledResolveRange(
+            D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        return false;
+      }
+      if (segment_box) {
+        readback_box_bytes_ += segment.length;
+      }
+    }
+
+    PushUAVBarrier(resolve_downscale_buffer_.Get());
+    PushTransitionBarrier(resolve_downscale_buffer_.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+                          D3D12_RESOURCE_STATE_COPY_SOURCE);
+    SubmitBarriers();
+    deferred_command_list_.D3DCopyBufferRegion(dest_buffer, 0,
+                                               resolve_downscale_buffer_.Get(), 0, length);
+    PushTransitionBarrier(resolve_downscale_buffer_.Get(), D3D12_RESOURCE_STATE_COPY_SOURCE,
+                          D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    texture_cache_->TransitionCurrentScaledResolveRange(D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    SubmitBarriers();
+  } else {
+    shared_memory_->UseAsCopySource();
+    SubmitBarriers();
+    deferred_command_list_.D3DCopyBufferRegion(dest_buffer, 0,
+                                               shared_memory_->GetBuffer(), address, length);
+  }
+
+  return true;
+}
