+bool TextureCache::IsUpscaleFilterableFormat(xenos::TextureFormat format) {
+  switch (format) {
+    case xenos::TextureFormat::k_8_8_8_8:
+    case xenos::TextureFormat::k_8_8_8_8_A:
+    case xenos::TextureFormat::k_8_8_8_8_AS_16_16_16_16:
+      return true;
+    default:
+      return false;
+  }
+}
+
+void TextureCache::UpscaleUnscaledPages(uint32_t start_unscaled, uint32_t length_unscaled,
+                                        uint32_t pixel_size_log2, const char* what,
+                                        const UpscaleFilterSurface* filter_surfaces,
+                                        uint32_t filter_surface_count) {
+  if (!IsDrawResolutionScaled() || !length_unscaled || !REXCVAR_GET(scaled_resolve_upscale)) {
+    return;
+  }
+  perf::Scope perf_scope(perf::Bucket::kUpscale);
+  start_unscaled &= 0x1FFFFFFF;
+  length_unscaled = std::min(length_unscaled, SharedMemory::kBufferSize - start_unscaled);
+  uint32_t page_first = start_unscaled >> 12;
+  uint32_t page_last = (start_unscaled + length_unscaled - 1) >> 12;
+
+  // Find the runs of pages not marked as scaled, and mark them before uploading
+  // and upscaling, so a CPU write after the upload clears the mark again and
+  // the next use upscales the new data.
+  std::vector<std::pair<uint32_t, uint32_t>> runs;
+  uint32_t total_pages = page_last - page_first + 1;
+  uint32_t unscaled_pages = 0;
+  {
+    auto global_lock = global_critical_region_.Acquire();
+    uint32_t page = page_first;
+    while (page <= page_last) {
+      if ((scaled_resolve_pages_[page >> 5] >> (page & 31)) & 1) {
+        ++page;
+        continue;
+      }
+      uint32_t run_first = page;
+      while (page <= page_last && !((scaled_resolve_pages_[page >> 5] >> (page & 31)) & 1)) {
+        ++page;
+      }
+      runs.emplace_back(run_first, page - run_first);
+      unscaled_pages += page - run_first;
+      SetScaledResolvePages(run_first, page - 1);
+      // 1x quality until a resolve rectangle covers them.
+      ModifyPageBits(scaled_resolve_upscaled_pages_.get(), run_first, page - 1, true);
+    }
+  }
+  if (runs.empty()) {
+    return;
+  }
+
+  // Only 32bpp pixels are filtered (a guest pixel's host pixels are whole
+  // dwords then). The surfaces are sorted and must not overlap.
+  std::vector<const UpscaleFilterSurface*> surfaces;
+  if (pixel_size_log2 == 2 && REXCVAR_GET(scaled_resolve_upscale_filter)) {
+    for (uint32_t i = 0; i < filter_surface_count; ++i) {
+      const UpscaleFilterSurface& surface = filter_surfaces[i];
+      if (surface.size >= 4 && surface.width && surface.height && surface.pitch &&
+          (surface.base & 3) == 0) {
+        surfaces.push_back(&surface);
+      }
+    }
+    std::sort(surfaces.begin(), surfaces.end(),
+              [](const UpscaleFilterSurface* a, const UpscaleFilterSurface* b) {
+                return a->base < b->base;
+              });
+  }
+
+  // Runs are split into chunks of up to 2 MB (up to 98 MB scaled at 7x7) to
+  // stay within buffer view limits, but uploaded whole first, so filtering can
+  // read guest pixels across the chunk borders.
+  constexpr uint32_t kMaxChunkLength = 512 << 12;
+  uint32_t failed_pages = 0;
+  uint64_t filtered_bytes = 0;
+  const char* failure = nullptr;
+  std::vector<UpscaleSegment> segments;
+  for (const std::pair<uint32_t, uint32_t>& run : runs) {
+    uint32_t run_start = run.first << 12;
+    uint32_t run_length = run.second << 12;
+    const char* run_failure = nullptr;
+    if (!shared_memory().RequestRange(run_start, run_length)) {
+      run_failure = "couldn't upload the shared memory range";
+    } else if (!EnsureScaledResolveMemoryCommitted(run_start, run_length)) {
+      run_failure = "couldn't commit the scaled resolve memory";
+    } else {
+      for (uint32_t chunk_offset = 0; chunk_offset < run_length;
+           chunk_offset += kMaxChunkLength) {
+        uint32_t chunk_start = run_start + chunk_offset;
+        uint32_t chunk_end = chunk_start + std::min(kMaxChunkLength, run_length - chunk_offset);
+        segments.clear();
+        uint32_t position = chunk_start;
+        for (const UpscaleFilterSurface* surface : surfaces) {
+          uint32_t filter_start = std::max(position, surface->base);
+          uint32_t filter_end =
+              std::min(chunk_end, surface->base + (surface->size & ~uint32_t(3)));
+          if (filter_start >= filter_end) {
+            continue;
+          }
+          if (filter_start > position) {
+            segments.push_back({position, filter_start - position, nullptr});
+          }
+          segments.push_back({filter_start, filter_end - filter_start, surface});
+          filtered_bytes += filter_end - filter_start;
+          position = filter_end;
+        }
+        if (position < chunk_end) {
+          segments.push_back({position, chunk_end - position, nullptr});
+        }
+        if (!UpscaleRangeImpl(chunk_start, chunk_end - chunk_start, pixel_size_log2,
+                              segments.data(), uint32_t(segments.size()), run_start,
+                              run_length)) {
+          run_failure = "the backend upscale failed";
+          break;
+        }
+      }
+    }
+    if (run_failure) {
+      // Leave the pages as they were (not scaled), so a later use tries again.
+      auto global_lock = global_critical_region_.Acquire();
+      ScaledResolveGlobalWatchCallback(global_lock, run_start, run_start + run_length - 1, false);
+      failed_pages += run.second;
+      failure = run_failure;
+    }
+  }
+
+  ++upscale_call_count_;
+  upscale_bytes_ += uint64_t(unscaled_pages - failed_pages) << 12;
+  upscale_filtered_bytes_ += filtered_bytes;
+  if (failure) {
+    if (++upscale_failure_log_count_ <= 32 || REXCVAR_GET(scaled_resolve_upscale_log)) {
+      REXGPU_WARN("Scaled resolve upscale ({}) of {:08X}+{:X}, {}bpp: {} of {} pages failed ({})",
+                  what, start_unscaled, length_unscaled, 8u << pixel_size_log2, failed_pages,
+                  unscaled_pages, failure);
+    }
+  } else if (++upscale_log_count_ <= 32 || REXCVAR_GET(scaled_resolve_upscale_log)) {
+    REXGPU_INFO(
+        "Scaled resolve upscale ({}): {} of {} pages of {:08X}+{:X} were not scaled, upscaled "
+        "at {}bpp in {} runs, {} KB filtered in {} surfaces",
+        what, unscaled_pages, total_pages, start_unscaled, length_unscaled, 8u << pixel_size_log2,
+        runs.size(), filtered_bytes >> 10, surfaces.size());
+  }
+  if (!(upscale_call_count_ % 256)) {
+    REXGPU_INFO("Scaled resolve upscales: {} so far, {:.1f} MB unscaled, {:.1f} MB filtered",
+                upscale_call_count_, upscale_bytes_ / 1048576.0,
+                upscale_filtered_bytes_ / 1048576.0);
+  }
+}
+
+void TextureCache::MarkRangeAsUnscaled(uint32_t start_unscaled, uint32_t length_unscaled) {
+  if (!IsDrawResolutionScaled() || !length_unscaled ||
+      !REXCVAR_GET(scaled_resolve_memexport_unscale)) {
+    return;
+  }
+  start_unscaled &= 0x1FFFFFFF;
+  length_unscaled = std::min(length_unscaled, SharedMemory::kBufferSize - start_unscaled);
+  auto global_lock = global_critical_region_.Acquire();
+  ScaledResolveGlobalWatchCallback(global_lock, start_unscaled,
+                                   start_unscaled + length_unscaled - 1, false);
+}
+
+void TextureCache::ModifyPageBits(uint32_t* bits, uint32_t page_first, uint32_t page_last,
+                                  bool set) {
+  uint32_t block_first = page_first >> 5;
+  uint32_t block_last = page_last >> 5;
+  for (uint32_t i = block_first; i <= block_last; ++i) {
+    uint32_t mask = UINT32_MAX;
+    if (i == block_first) {
+      mask &= ~((UINT32_C(1) << (page_first & 31)) - 1);
+    }
+    if (i == block_last && (page_last & 31) != 31) {
+      mask &= (UINT32_C(1) << ((page_last & 31) + 1)) - 1;
+    }
+    if (set) {
+      bits[i] |= mask;
+    } else {
+      bits[i] &= ~mask;
+    }
+  }
+}
+
+void TextureCache::MarkResolveRectRendered(uint32_t dest_base, uint32_t pitch_tiles, uint32_t x,
+                                           uint32_t y, uint32_t width, uint32_t height,
+                                           uint32_t pixel_size_log2, bool box_safe) {
+  if (!IsDrawResolutionScaled() || !width || !height || !pitch_tiles) {
+    return;
+  }
+  dest_base &= 0x1FFFFFFF;
+  // In a tiled 2D surface, the 32x32 tiles are stored in row-major order, each
+  // in 1024 << pixel_size_log2 bytes (several 8bpp or 16bpp tiles interleave
+  // within one 4 KB page, but always consecutive ones of a row), so the pages
+  // touched by one row of tiles of the rectangle are contiguous. Pages only
+  // partly inside the rectangle count as rendered too.
+  uint32_t tile_size_log2 = 10 + pixel_size_log2;
+  uint32_t tile_x_first = x >> 5;
+  uint32_t tile_x_last = std::min((x + width - 1) >> 5, pitch_tiles - 1);
+  if (tile_x_first > tile_x_last) {
+    return;
+  }
+  uint32_t tile_y_first = y >> 5;
+  uint32_t tile_y_last = (y + height - 1) >> 5;
+  auto global_lock = global_critical_region_.Acquire();
+  for (uint32_t tile_y = tile_y_first; tile_y <= tile_y_last; ++tile_y) {
+    uint64_t row_tile = uint64_t(tile_y) * pitch_tiles;
+    uint64_t start = dest_base + ((row_tile + tile_x_first) << tile_size_log2);
+    uint64_t end = dest_base + ((row_tile + tile_x_last + 1) << tile_size_log2);
+    if (start >= SharedMemory::kBufferSize) {
+      break;
+    }
+    end = std::min(end, uint64_t(SharedMemory::kBufferSize));
+    ModifyPageBits(scaled_resolve_upscaled_pages_.get(), uint32_t(start >> 12),
+                   uint32_t((end - 1) >> 12), false);
+    ModifyPageBits(scaled_resolve_packed_pages_.get(), uint32_t(start >> 12),
+                   uint32_t((end - 1) >> 12), !box_safe);
+  }
+}
+
+void TextureCache::MarkRangeRenderedAtScale(uint32_t start_unscaled, uint32_t length_unscaled,
+                                            bool box_safe) {
+  if (!IsDrawResolutionScaled() || !length_unscaled) {
+    return;
+  }
+  start_unscaled &= 0x1FFFFFFF;
+  length_unscaled = std::min(length_unscaled, SharedMemory::kBufferSize - start_unscaled);
+  auto global_lock = global_critical_region_.Acquire();
+  ModifyPageBits(scaled_resolve_upscaled_pages_.get(), start_unscaled >> 12,
+                 (start_unscaled + length_unscaled - 1) >> 12, false);
+  ModifyPageBits(scaled_resolve_packed_pages_.get(), start_unscaled >> 12,
+                 (start_unscaled + length_unscaled - 1) >> 12, !box_safe);
+}
+
+bool TextureCache::IsResolveSourceBoxSafe(bool is_depth,
+                                          xenos::ColorRenderTargetFormat color_format) {
+  return !is_depth && color_format != xenos::ColorRenderTargetFormat::k_32_FLOAT &&
+         color_format != xenos::ColorRenderTargetFormat::k_32_32_FLOAT;
+}
+
+bool TextureCache::IsPageUpscaledFrom1x(uint32_t address_unscaled) {
+  if (!IsDrawResolutionScaled()) {
+    return false;
+  }
+  uint32_t page = (address_unscaled & 0x1FFFFFFF) >> 12;
+  uint32_t bit = UINT32_C(1) << (page & 31);
+  auto global_lock = global_critical_region_.Acquire();
+  return (scaled_resolve_pages_[page >> 5] & bit) &&
+         (scaled_resolve_upscaled_pages_[page >> 5] & bit);
+}
+
+bool TextureCache::IsRangeRenderedAtScale(uint32_t start_unscaled, uint32_t length_unscaled) {
+  if (!IsDrawResolutionScaled()) {
+    return false;
+  }
+  start_unscaled = std::min(start_unscaled, SharedMemory::kBufferSize);
+  length_unscaled = std::min(length_unscaled, SharedMemory::kBufferSize - start_unscaled);
+  if (!length_unscaled) {
+    return false;
+  }
+  uint32_t page_first = start_unscaled >> 12;
+  uint32_t page_last = (start_unscaled + length_unscaled - 1) >> 12;
+  uint32_t block_first = page_first >> 5;
+  uint32_t block_last = page_last >> 5;
+  auto global_lock = global_critical_region_.Acquire();
+  for (uint32_t i = block_first; i <= block_last; ++i) {
+    uint32_t mask = UINT32_MAX;
+    if (i == block_first) {
+      mask &= ~((UINT32_C(1) << (page_first & 31)) - 1);
+    }
+    if (i == block_last && (page_last & 31) != 31) {
+      mask &= (UINT32_C(1) << ((page_last & 31) + 1)) - 1;
+    }
+    if ((scaled_resolve_pages_[i] & mask) != mask || (scaled_resolve_upscaled_pages_[i] & mask)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool TextureCache::IsDownscaleBoxFormat(xenos::TextureFormat format) {
+  // Every byte is one 8-bit channel, whatever the endianness.
+  switch (format) {
+    case xenos::TextureFormat::k_8_8_8_8:
+    case xenos::TextureFormat::k_8_8_8_8_A:
+    case xenos::TextureFormat::k_8_8_8_8_AS_16_16_16_16:
+      return true;
+    default:
+      return false;
+  }
+}
+
+bool TextureCache::IsDownscaleBoxEnabled(uint32_t pixel_size_log2, bool box_format) const {
+  return box_format && pixel_size_log2 == 2 && IsDrawResolutionScaled() &&
+         REXCVAR_GET(scaled_resolve_downscale_box);
+}
+
+void TextureCache::GetDownscaleSegments(uint32_t start_unscaled, uint32_t length_unscaled,
+                                        uint32_t pixel_size_log2, bool box_format,
+                                        std::vector<DownscaleSegment>& segments_out) {
+  segments_out.clear();
+  uint32_t tile_size_log2 = 10 + pixel_size_log2;
+  uint32_t tile_size = UINT32_C(1) << tile_size_log2;
+  uint32_t tile_count = length_unscaled >> tile_size_log2;
+  if (!tile_count) {
+    return;
+  }
+  if (!IsDownscaleBoxEnabled(pixel_size_log2, box_format)) {
+    segments_out.push_back({0, tile_count << tile_size_log2, false});
+    return;
+  }
+  start_unscaled &= 0x1FFFFFFF;
+  auto global_lock = global_critical_region_.Acquire();
+  for (uint32_t tile = 0; tile < tile_count; ++tile) {
+    uint64_t tile_start = uint64_t(start_unscaled) + (uint64_t(tile) << tile_size_log2);
+    // Only pixels a resolve rendered at the scale are averaged. Pixels
+    // upscaled from 1x keep the center sample, the exact inverse of the
+    // upscale, so CPU round trips don't blur them. Packed data (from depth or
+    // 32-bit float sources) is never averaged.
+    bool tile_box = tile_start + tile_size <= SharedMemory::kBufferSize;
+    if (tile_box) {
+      uint32_t page_last = uint32_t((tile_start + tile_size - 1) >> 12);
+      for (uint32_t page = uint32_t(tile_start >> 12); page <= page_last; ++page) {
+        uint32_t bit = UINT32_C(1) << (page & 31);
+        if (!(scaled_resolve_pages_[page >> 5] & bit) ||
+            (scaled_resolve_upscaled_pages_[page >> 5] & bit) ||
+            (scaled_resolve_packed_pages_[page >> 5] & bit)) {
+          tile_box = false;
+          break;
+        }
+      }
+    }
+    if (!segments_out.empty() && segments_out.back().box == tile_box) {
+      segments_out.back().length += tile_size;
+    } else {
+      segments_out.push_back({tile << tile_size_log2, tile_size, tile_box});
+    }
+  }
+}
+
+void TextureCache::DownscaleScaledPagesToSharedMemory(uint32_t start_unscaled,
+                                                      uint32_t length_unscaled,
+                                                      uint32_t pixel_size_log2, bool box_format,
+                                                      const char* what) {
+  // Whole 32x32 tiles of up to 32bpp are whole pages or less, so any page run
+  // is whole tiles for the downscale shader.
+  if (!IsDrawResolutionScaled() || !length_unscaled || pixel_size_log2 > 2) {
+    return;
+  }
+  start_unscaled &= 0x1FFFFFFF;
+  length_unscaled = std::min(length_unscaled, SharedMemory::kBufferSize - start_unscaled);
+  // Fast rejection for the usual texture, which no resolve has written.
+  if (!IsRangeScaledResolved(start_unscaled, length_unscaled)) {
+    return;
+  }
+  uint32_t page_first = start_unscaled >> 12;
+  uint32_t page_last = (start_unscaled + length_unscaled - 1) >> 12;
+
+  // Only the pages a resolve rendered at the scale. Upscaled pages still hold
+  // their 1x data in shared memory (they were upscaled from it, and no resolve
+  // has touched them since), and unscaled pages are valid there.
+  // Runs are split where packed data (never averaged) starts or ends.
+  struct DownscaleRun {
+    uint32_t first;
+    uint32_t count;
+    bool packed;
+  };
+  std::vector<DownscaleRun> runs;
+  uint32_t rendered_pages = 0;
+  uint32_t packed_pages = 0;
+  {
+    auto global_lock = global_critical_region_.Acquire();
+    auto is_rendered = [this](uint32_t page) {
+      uint32_t bit = UINT32_C(1) << (page & 31);
+      return (scaled_resolve_pages_[page >> 5] & bit) &&
+             !(scaled_resolve_upscaled_pages_[page >> 5] & bit);
+    };
+    auto is_packed = [this](uint32_t page) {
+      return ((scaled_resolve_packed_pages_[page >> 5] >> (page & 31)) & 1) != 0;
+    };
+    uint32_t page = page_first;
+    while (page <= page_last) {
+      if (!is_rendered(page)) {
+        ++page;
+        continue;
+      }
+      uint32_t run_first = page;
+      bool run_packed = is_packed(page);
+      while (page <= page_last && is_rendered(page) && is_packed(page) == run_packed) {
+        ++page;
+      }
+      runs.push_back({run_first, page - run_first, run_packed});
+      rendered_pages += page - run_first;
+      if (run_packed) {
+        packed_pages += page - run_first;
+      }
+    }
+  }
+  if (runs.empty()) {
+    return;
+  }
+
+  // Every run is rendered at the scale, so all of it is averaged if the format
+  // allows, except packed data.
+  bool box = IsDownscaleBoxEnabled(pixel_size_log2, box_format);
+  constexpr uint32_t kMaxChunkLength = 512 << 12;
+  uint32_t failed_pages = 0;
+  const char* failure = nullptr;
+  for (const DownscaleRun& run : runs) {
+    uint32_t run_start = run.first << 12;
+    uint32_t run_length = run.count << 12;
+    for (uint32_t chunk_offset = 0; chunk_offset < run_length; chunk_offset += kMaxChunkLength) {
+      uint32_t chunk_length = std::min(kMaxChunkLength, run_length - chunk_offset);
+      const char* chunk_failure = nullptr;
+      if (!DownscaleRangeToSharedMemoryImpl(run_start + chunk_offset, chunk_length,
+                                            pixel_size_log2, box && !run.packed, chunk_failure)) {
+        failed_pages += (run_length - chunk_offset) >> 12;
+        failure = chunk_failure ? chunk_failure : "the backend downscale failed";
+        break;
+      }
+    }
+  }
+
+  ++downscale_call_count_;
+  downscale_bytes_ += uint64_t(rendered_pages - failed_pages) << 12;
+  if (failure) {
+    if (++downscale_failure_log_count_ <= 32 || REXCVAR_GET(scaled_resolve_upscale_log)) {
+      REXGPU_WARN(
+          "Scaled resolve downscale ({}) of {:08X}+{:X}, {}bpp: {} of {} pages failed ({}), the "
+          "1x texture reads stale data there",
+          what, start_unscaled, length_unscaled, 8u << pixel_size_log2, failed_pages,
+          rendered_pages, failure);
+    }
+  } else if (++downscale_log_count_ <= 32 || REXCVAR_GET(scaled_resolve_upscale_log)) {
+    REXGPU_INFO(
+        "Scaled resolve downscale ({}): {} of {} pages of {:08X}+{:X} were rendered at the scale, "
+        "downscaled into shared memory at {}bpp in {} runs ({}, {} packed pages center)",
+        what, rendered_pages, page_last - page_first + 1, start_unscaled, length_unscaled,
+        8u << pixel_size_log2, runs.size(), box ? "box" : "center", packed_pages);
+  }
+  if (!(downscale_call_count_ % 256)) {
+    REXGPU_INFO("Scaled resolve downscales: {} so far, {:.1f} MB; {} mixed textures loaded at 1x",
+                downscale_call_count_, downscale_bytes_ / 1048576.0, mixed_texture_count_);
+  }
+}
