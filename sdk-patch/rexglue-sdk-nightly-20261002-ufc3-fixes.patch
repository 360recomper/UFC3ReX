+void Memory::ProvidePhysicalMemoryData(uint32_t virtual_address, uint32_t length) {
+  if (!length) {
+    return;
+  }
+  BaseHeap* heap = LookupHeap(virtual_address);
+  if (!heap || heap->heap_type() != memory::HeapType::kGuestPhysical) {
+    return;
+  }
+  auto physical_heap = static_cast<PhysicalHeap*>(heap);
+  const uint32_t page_size = system_page_size_;
+  uint64_t end = uint64_t(virtual_address) + length;
+  for (uint64_t address = virtual_address & ~(page_size - 1); address < end;
+       address += page_size) {
+    auto lock = global_critical_region_.Acquire();
+    // Each call fills a whole resolve, usually covering the following pages.
+    while (physical_heap->IsReadWatched(uint32_t(address))) {
+      uint32_t physical_address = physical_heap->GetPhysicalAddress(uint32_t(address));
+      if (!physical_memory_data_provider_) {
+        DisablePhysicalMemoryReadWatch(physical_address, 1);
+        break;
+      }
+      physical_memory_data_provider_(physical_memory_data_provider_context_, physical_address,
+                                     std::move(lock));
+      lock = global_critical_region_.Acquire();
+    }
+  }
+}
