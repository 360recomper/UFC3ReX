+
+void SharedMemory::ValidateSpeculativePages(
+    const std::vector<std::pair<uint32_t, uint32_t>>& ranges) {
+  // Find the speculatively uploaded pages in the requested ranges, scanning
+  // whole 64-page blocks (requests can span the entire buffer).
+  speculative_runs_.clear();
+  {
+    auto global_lock = global_critical_region_.Acquire();
+    for (const std::pair<uint32_t, uint32_t>& range : ranges) {
+      uint32_t page_first = range.first >> page_size_log2_;
+      uint32_t page_last = (range.first + range.second - 1) >> page_size_log2_;
+      for (uint32_t i = page_first >> 6; i <= page_last >> 6; ++i) {
+        uint64_t mask = page_speculative_[i] & ~system_page_flags_valid_[i];
+        if (!mask) {
+          continue;
+        }
+        if (i == page_first >> 6) {
+          mask &= ~((uint64_t(1) << (page_first & 63)) - 1);
+        }
+        if (i == page_last >> 6 && (page_last & 63) != 63) {
+          mask &= (uint64_t(1) << ((page_last & 63) + 1)) - 1;
+        }
+        uint32_t bit;
+        while (rex::bit_scan_forward(mask, &bit)) {
+          mask &= mask - 1;
+          uint32_t page = (i << 6) + bit;
+          if (!speculative_runs_.empty() &&
+              speculative_runs_.back().first + speculative_runs_.back().second == page) {
+            ++speculative_runs_.back().second;
+          } else {
+            speculative_runs_.emplace_back(page, 1);
+          }
+        }
+      }
+    }
+  }
+  const size_t page_size = size_t(1) << page_size_log2_;
+  for (const std::pair<uint32_t, uint32_t>& run : speculative_runs_) {
+    // Arm the write watch before comparing, so a CPU write after the
+    // comparison invalidates the page again.
+    MakeRangeValid(run.first << page_size_log2_, run.second << page_size_log2_, false);
+    for (uint32_t page = run.first; page < run.first + run.second; ++page) {
+      auto it = speculative_shadow_.find(page);
+      if (it == speculative_shadow_.end() ||
+          std::memcmp(it->second.get(), memory().TranslatePhysical(page << page_size_log2_),
+                      page_size)) {
+        auto global_lock = global_critical_region_.Acquire();
+        system_page_flags_valid_[page >> 6] &= ~(uint64_t(1) << (page & 63));
+      }
+    }
+  }
