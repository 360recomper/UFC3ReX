+  NegativeOriginDrawRebase& operator=(const NegativeOriginDrawRebase&) = delete;
+
+ private:
+  static constexpr uint32_t kSavedRegisterCount = 9;
+  RegisterFile& regs_;
+  bool applied_ = false;
+  uint32_t saved_[kSavedRegisterCount];
