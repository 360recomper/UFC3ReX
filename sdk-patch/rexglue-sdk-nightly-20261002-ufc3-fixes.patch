+void CommandProcessor::NoteMemexportReadback(std::chrono::steady_clock::time_point start,
+                                             uint32_t declared_size) {
+  const double ms =
+      std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+  const uint64_t written = memexport_readback_written_;
+  memexport_readback_written_ = 0;
+  MemexportReadbackStats& stats = memexport_readback_stats_;
+  ++stats.calls;
+  stats.declared_bytes += declared_size;
+  stats.written_bytes += written;
+  stats.ms += ms;
+  stats.max_ms = std::max(stats.max_ms, ms);
+  if (REXCVAR_GET(memexport_readback_log)) {
+    REXGPU_INFO(
+        "Memexport readback {}: to {:08X}, {} bytes declared, {} written ({} non-zero), "
+        "{:.2f} ms",
+        stats.calls, memexport_readback_first_address_, declared_size, written,
+        memexport_readback_nonzero_, ms);
+  }
+  memexport_readback_first_address_ = UINT32_MAX;
+  memexport_readback_nonzero_ = 0;
+  if (!(stats.calls % 32)) {
+    REXGPU_INFO(
+        "Memexport readbacks: {} so far, {:.1f} MB declared, {:.1f} MB written, {:.0f} ms total, "
+        "slowest {:.1f} ms",
+        stats.calls, stats.declared_bytes / 1048576.0, stats.written_bytes / 1048576.0, stats.ms,
+        stats.max_ms);
+  }
+}
