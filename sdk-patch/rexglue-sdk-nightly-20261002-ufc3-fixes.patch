+constexpr char kResolveDownscaleBoxShaderSource[] = R"glsl(
+#version 460
+// 32bpp 8-bit-per-channel only. In the scaled resolve buffer, the host pixels
+// of each guest pixel are stored contiguously, so the 1x pixel is the per-byte
+// rounded average of scale_x * scale_y consecutive dwords - like an MSAA
+// resolve of the pixel, instead of one aliased sample.
+layout(local_size_x = 32, local_size_y = 32, local_size_z = 1) in;
+layout(push_constant) uniform ResolveDownscaleConstants {
+  uint xe_downscale_scale_x;
+  uint xe_downscale_scale_y;
+  uint xe_downscale_pixel_size_log2;
+  uint xe_downscale_tile_count;
+  uint xe_downscale_source_offset_bytes;
+  uint xe_downscale_half_pixel_offset;
