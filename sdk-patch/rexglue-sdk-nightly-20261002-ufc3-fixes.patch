diff --git a/src/graphics/shaders/resolve_downscale_box.cs.glsl b/src/graphics/shaders/resolve_downscale_box.cs.glsl
new file mode 100644
index 0000000..dda3f72
--- /dev/null
+++ b/src/graphics/shaders/resolve_downscale_box.cs.glsl
@@ -0,0 +1,42 @@
+#version 460
+
+// Reference source: the build doesn't compile it - vulkan/command_processor.cpp
+// holds a copy that is compiled at runtime with glslang.
+//
+// Box variant of resolve_downscale (same constants and bindings), 32bpp
+// 8-bit-per-channel only. In the scaled resolve buffer, the host pixels of each
+// guest pixel are stored contiguously, so the 1x pixel is the per-byte rounded
+// average of scale_x * scale_y consecutive dwords - like an MSAA resolve of the
+// pixel, instead of one aliased sample.
+
+layout(local_size_x = 32, local_size_y = 32, local_size_z = 1) in;
+layout(push_constant) uniform ResolveDownscaleConstants {
+  uint xe_downscale_scale_x;
+  uint xe_downscale_scale_y;
+  uint xe_downscale_pixel_size_log2;
+  uint xe_downscale_tile_count;
+  uint xe_downscale_source_offset_bytes;
+  uint xe_downscale_half_pixel_offset;
+};
+layout(std430, set = 0, binding = 0) readonly buffer SourceBuffer {
+  uint data[];
+} xe_resolve_source;
+layout(std430, set = 0, binding = 1) writeonly buffer DestBuffer {
+  uint data[];
+} xe_resolve_dest;
+void main() {
+  uint tile_index = gl_WorkGroupID.x;
+  if (tile_index >= xe_downscale_tile_count) {
+    return;
+  }
+  uint pixel = tile_index * 1024u + gl_LocalInvocationIndex;
+  uint scale_area = xe_downscale_scale_x * xe_downscale_scale_y;
+  uint source_dword = (xe_downscale_source_offset_bytes >> 2u) + pixel * scale_area;
+  uvec4 sum = uvec4(0u);
+  for (uint i = 0u; i < scale_area; ++i) {
+    sum += (uvec4(xe_resolve_source.data[source_dword + i]) >> uvec4(0u, 8u, 16u, 24u)) & 0xFFu;
+  }
+  uvec4 average = (sum + (scale_area >> 1u)) / scale_area;
+  xe_resolve_dest.data[pixel] =
+      average.x | (average.y << 8u) | (average.z << 16u) | (average.w << 24u);
+}
