+/**
+ * @file        draw_trace.h
+ * @brief       trace_draw_ps: per-draw shader constants of chosen pixel shaders
+ *              over a few frames (which constants differ between the draws of
+ *              one shader, e.g. per-mesh lighting of a skinned model).
+ */
+
+#pragma once
+
+#include <rex/graphics/register_file.h>
+
+namespace rex::graphics {
+class Shader;
+}
+
+namespace rex::graphics::draw_trace {
+
+// Command processor thread, at draw time (after the shaders are analyzed).
+// Logs the draw while a capture runs and its pixel shader is listed in
+// trace_draw_ps.
+void NoteDraw(const RegisterFile& regs, const Shader* vertex_shader, const Shader* pixel_shader);
+
+// Command processor thread, once per guest swap: ends a captured frame (prints
+// its per-shader diff summary) and decides whether the next one is captured.
+void OnFrame();
+
+}  // namespace rex::graphics::draw_trace
diff --git a/include/rex/graphics/util/perf_summary.h b/include/rex/graphics/util/perf_summary.h
new file mode 100644
index 0000000..c9d1360
--- /dev/null
+++ b/include/rex/graphics/util/perf_summary.h
@@ -0,0 +1,92 @@
+/**
+ * @file        perf_summary.h
+ * @brief       perf_second_summary: where the GPU thread's time goes, per second
+ *              and per slow frame (hitch hunting at render scale > 1).
+ */
+
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+#include <source_location>
+
+namespace rex::graphics::perf {
+
+// Each bucket is time spent inside one path (any thread, so they can overlap).
+enum class Bucket : uint32_t {
+  // GPU thread serving on-demand resolve readbacks (incl. its GPU waits).
+  kOnDemandReadback,
+  // Guest threads stopped on an on-demand readback fault, fault to resume.
+  kOnDemandStall,
+  // Readback-ahead copies the serve awaited (part of kOnDemandReadback).
+  kReadbackAheadWait,
+  kUpscale,
+  kDownscale,
+  kMemexportReadback,
+  kTextureLoad,
+  kPipelineCreation,
+  kRtTransfer,
+  kResolve,
+  kSwap,
+  // Every AwaitAllQueueOperationsCompletion (also by caller in the summary).
+  kAwaitAll,
+  kCount,
+};
+
+// perf_second_summary is on.
+bool IsEnabled();
+
+void Add(Bucket bucket, std::chrono::steady_clock::duration duration);
+
+class Scope {
+ public:
+  explicit Scope(Bucket bucket) : bucket_(bucket), enabled_(IsEnabled()) {
+    if (enabled_) {
+      start_ = std::chrono::steady_clock::now();
+    }
+  }
+  ~Scope() {
+    if (enabled_) {
+      Add(bucket_, std::chrono::steady_clock::now() - start_);
+    }
+  }
+  Scope(const Scope&) = delete;
+  Scope& operator=(const Scope&) = delete;
+
+ private:
+  Bucket bucket_;
+  bool enabled_;
+  std::chrono::steady_clock::time_point start_;
+};
+
+// One AwaitAllQueueOperationsCompletion, attributed to its call site.
+void AddAwaitAll(const std::source_location& caller, std::chrono::steady_clock::duration duration);
+
+// Times an AwaitAllQueueOperationsCompletion body.
+class AwaitAllScope {
+ public:
+  explicit AwaitAllScope(const std::source_location& caller)
+      : caller_(caller), enabled_(IsEnabled()) {
+    if (enabled_) {
+      start_ = std::chrono::steady_clock::now();
+    }
+  }
+  ~AwaitAllScope() {
+    if (enabled_) {
+      AddAwaitAll(caller_, std::chrono::steady_clock::now() - start_);
+    }
+  }
+  AwaitAllScope(const AwaitAllScope&) = delete;
+  AwaitAllScope& operator=(const AwaitAllScope&) = delete;
+
+ private:
+  std::source_location caller_;
+  bool enabled_;
+  std::chrono::steady_clock::time_point start_;
+};
+
+// Command processor thread, once per guest swap: logs a line for a frame
+// (swap to swap) slower than perf_slow_frame_ms, and the summary every second.
+void OnFrame();
+
+}  // namespace rex::graphics::perf
