+void VulkanSharedMemory::RangeReadByGpu(uint32_t start, uint32_t length) {
+  if (!hoist_ || start >= kBufferSize) {
+    return;
+  }
+  length = std::min(length, kBufferSize - start);
+  if (!length) {
+    return;
+  }
+  uint64_t submission = command_processor_.GetCurrentSubmission();
+  uint32_t page_size = uint32_t(1) << page_size_log2();
+  uint32_t range_end = start + length;
+  for (uint32_t page = start >> page_size_log2(); page <= ((range_end - 1) >> page_size_log2());
+       ++page) {
+    uint32_t page_start = page << page_size_log2();
+    uint32_t first = std::max(start, page_start) - page_start;
+    uint32_t end = std::min(range_end, page_start + page_size) - page_start;
+    if (page_read_submission_[page] == submission) {
+      page_read_first_[page] = uint16_t(std::min(uint32_t(page_read_first_[page]), first));
+      page_read_end_[page] = uint16_t(std::max(uint32_t(page_read_end_[page]), end));
+    } else {
+      page_read_submission_[page] = submission;
+      page_read_first_[page] = uint16_t(first);
+      page_read_end_[page] = uint16_t(end);
+    }
