+void ImGuiDrawer::SetGamepadInput(bool active, uint16_t buttons, int16_t lx, int16_t ly) {
+  uint64_t v = (uint64_t(active) << 63) | (uint64_t(buttons) << 32) |
+               (uint64_t(uint16_t(lx)) << 16) | uint64_t(uint16_t(ly));
+  gamepad_packed_.store(v, std::memory_order_relaxed);
+}
+
+void ImGuiDrawer::ApplyGamepadInput(ImGuiIO& io) {
+  uint64_t v = gamepad_packed_.load(std::memory_order_relaxed);
+  bool active = (v >> 63) != 0;
+  uint16_t buttons = active ? uint16_t(v >> 32) : 0;
+  int16_t lx = active ? int16_t((v >> 16) & 0xFFFF) : 0;
+  int16_t ly = active ? int16_t(v & 0xFFFF) : 0;
+  if (!active && !gamepad_prev_active_) {
+    return;
+  }
+  if (active) {
+    io.ConfigFlags |= ImGuiConfigFlags_NavEnableGamepad;
+    io.BackendFlags |= ImGuiBackendFlags_HasGamepad;
+  }
+  struct Map {
+    uint16_t mask;
+    ImGuiKey key;
+  };
+  static const Map kMap[] = {
+      {0x0001, ImGuiKey_GamepadDpadUp},    {0x0002, ImGuiKey_GamepadDpadDown},
+      {0x0004, ImGuiKey_GamepadDpadLeft},  {0x0008, ImGuiKey_GamepadDpadRight},
+      {0x1000, ImGuiKey_GamepadFaceDown},  // A = activate
+      {0x2000, ImGuiKey_GamepadFaceRight},  // B = cancel
+      {0x4000, ImGuiKey_GamepadFaceLeft},  {0x8000, ImGuiKey_GamepadFaceUp},
+      {0x0100, ImGuiKey_GamepadL1},        {0x0200, ImGuiKey_GamepadR1},
+  };
+  for (const auto& m : kMap) {
+    bool now = (buttons & m.mask) != 0;
+    bool was = (gamepad_prev_buttons_ & m.mask) != 0;
+    if (now != was) {
+      io.AddKeyEvent(m.key, now);
+    }
+  }
+  // Left stick -> analog nav axes (dead zone 25%).
+  auto axis = [](int16_t a, bool positive) {
+    float f = float(a) / 32767.0f;
+    f = positive ? f : -f;
+    return f > 0.25f ? (f - 0.25f) / 0.75f : 0.0f;
+  };
+  io.AddKeyAnalogEvent(ImGuiKey_GamepadLStickLeft, axis(lx, false) > 0, axis(lx, false));
+  io.AddKeyAnalogEvent(ImGuiKey_GamepadLStickRight, axis(lx, true) > 0, axis(lx, true));
+  io.AddKeyAnalogEvent(ImGuiKey_GamepadLStickUp, axis(ly, true) > 0, axis(ly, true));
+  io.AddKeyAnalogEvent(ImGuiKey_GamepadLStickDown, axis(ly, false) > 0, axis(ly, false));
+  gamepad_prev_buttons_ = buttons;
+  gamepad_prev_active_ = active;
+  if (!active) {
+    io.ConfigFlags &= ~ImGuiConfigFlags_NavEnableGamepad;
+  }
+}
