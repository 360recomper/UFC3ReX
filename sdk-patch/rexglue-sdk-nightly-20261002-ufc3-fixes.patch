+uint32_t GetNegativeOriginDrawRegister(uint32_t index) {
+  switch (index) {
+    case 0:
+      return XE_GPU_REG_PA_SC_WINDOW_SCISSOR_TL;
+    case 1:
+      return XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR;
+    case 2:
+      return XE_GPU_REG_PA_SC_WINDOW_OFFSET;
+    case 3:
+      return XE_GPU_REG_PA_SU_SC_MODE_CNTL;
+    case 4:
+      return XE_GPU_REG_RB_DEPTH_INFO;
+    default:
+      return reg::RB_COLOR_INFO::rt_register_indices[index - 5];
+  }
