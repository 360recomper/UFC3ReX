+namespace {
+
+// Same resolution as ReXApp: user_data_root cvar, else ..\saves next to the exe's folder.
+std::filesystem::path ResolveSavesDir() {
+  std::string cvar_path = rex::cvar::GetFlagByName("user_data_root");
+  std::error_code ec;
+  if (!cvar_path.empty())
+    return std::filesystem::path(cvar_path);
+  auto portable = (rex::filesystem::GetExecutableFolder() / ".." / "saves").lexically_normal();
+  if (std::filesystem::is_directory(portable, ec))
+    return portable;
+  return {};
+}
+
+// Copy a save folder tree, leaving out the shader cache (large, rebuilt on demand).
+bool CopySaves(const std::filesystem::path& from, const std::filesystem::path& to,
+               std::string* error) {
+  std::error_code ec;
+  std::filesystem::create_directories(to, ec);
+  for (auto& entry : std::filesystem::directory_iterator(from, ec)) {
+    if (entry.path().filename() == "cache")
+      continue;
+    std::filesystem::copy(entry.path(), to / entry.path().filename(),
+                          std::filesystem::copy_options::recursive |
+                              std::filesystem::copy_options::overwrite_existing,
+                          ec);
+    if (ec) {
+      *error = ec.message();
+      return false;
+    }
+  }
+  return true;
+}
+
