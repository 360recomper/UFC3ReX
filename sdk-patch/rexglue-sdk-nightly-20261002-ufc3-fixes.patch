+    float scale = 1.0f;
+    IntegerTextureFetchMode mode = GetIntegerTextureFetchMode();
+    if (mode != IntegerTextureFetchMode::kOff) {
+      if (format == 24 || format == 25 || format == 26) {
+        scale = 65535.0f;
+      } else if (mode == IntegerTextureFetchMode::kAll) {
+        if (format == 2 || format == 6 || format == 8 || format == 9 || format == 10 ||
