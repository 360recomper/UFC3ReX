+void PhysicalHeap::InvalidateNewAllocation(uint32_t address, uint32_t size) {
+  // GPU-side copies of physical memory are dropped when the CPU writes to
+  // watched pages, but pages can be watched only while allocated. A draw can
+  // make the GPU consider unallocated memory up to date (a memexport stream
+  // declared larger than what it writes, for instance - UFC 3's GPU texture
+  // compressor declares 24 MB for a 4 MB texture), and the CPU writes after
+  // the memory is allocated would then never reach the GPU. The contents of
+  // a new allocation are new to the GPU, so drop its copy of the range. The
+  // pages aren't watched, so TriggerCallbacks would skip them - notify the
+  // physical memory invalidation callbacks directly.
+  uint32_t physical_address = GetPhysicalAddress(address);
+  auto global_lock = global_critical_region_.Acquire();
