+bool VulkanTextureCache::UpscaleRangeImpl(uint32_t start_unscaled, uint32_t length_unscaled,
+                                          uint32_t pixel_size_log2,
+                                          const UpscaleSegment* segments, uint32_t segment_count,
+                                          uint32_t valid_start, uint32_t valid_length) {
+  if (resolve_upscale_pipeline_ == VK_NULL_HANDLE || scaled_resolve_buffer_ == VK_NULL_HANDLE) {
+    return false;
+  }
+  uint64_t start_scaled, length_scaled;
+  if (!GetScaledResolveRange(start_unscaled, length_unscaled, 0, start_scaled, length_scaled)) {
+    return false;
+  }
+  if (!length_scaled) {
+    return true;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  if (length_scaled > vulkan_device->properties().maxStorageBufferRange) {
+    return false;
+  }
+  VkDescriptorSet descriptor_set = command_processor_.AllocateSingleTransientDescriptor(
+      VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferPairCompute);
+  if (descriptor_set == VK_NULL_HANDLE) {
+    return false;
+  }
+  // The source is the whole valid range if it fits in one binding, so filtering
+  // can read guest pixels next to the range, otherwise only the range.
+  uint32_t source_start = start_unscaled;
+  uint32_t source_length = length_unscaled;
+  if (valid_start <= start_unscaled &&
+      valid_start + valid_length >= start_unscaled + length_unscaled &&
+      valid_length <= vulkan_device->properties().maxStorageBufferRange) {
+    source_start = valid_start;
+    source_length = valid_length;
+  }
+  // Both offsets are page-aligned (the scaled one is a multiple of the
+  // unscaled one), more than minStorageBufferOffsetAlignment can be.
+  VulkanSharedMemory& vulkan_shared_memory = static_cast<VulkanSharedMemory&>(shared_memory());
+  VkDescriptorBufferInfo buffer_infos[2];
+  buffer_infos[0].buffer = vulkan_shared_memory.buffer();
+  buffer_infos[0].offset = source_start;
+  buffer_infos[0].range = source_length;
+  buffer_infos[1].buffer = scaled_resolve_buffer_;
+  buffer_infos[1].offset = start_scaled;
+  buffer_infos[1].range = length_scaled;
+  VkWriteDescriptorSet descriptor_writes[2] = {};
+  for (uint32_t i = 0; i < 2; ++i) {
+    descriptor_writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    descriptor_writes[i].dstSet = descriptor_set;
+    descriptor_writes[i].dstBinding = i;
+    descriptor_writes[i].descriptorCount = 1;
+    descriptor_writes[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+    descriptor_writes[i].pBufferInfo = &buffer_infos[i];
+  }
+  dfn.vkUpdateDescriptorSets(device, 2, descriptor_writes, 0, nullptr);
+
+  vulkan_shared_memory.Use(VulkanSharedMemory::Usage::kRead);
+  // Ordered after earlier resolves to the buffer, and the resolve or the
+  // texture load after this is ordered after it.
+  UseScaledResolveBufferForWrite(start_scaled, length_scaled);
+  command_processor_.BindExternalComputePipeline(resolve_upscale_pipeline_);
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                         resolve_upscale_pipeline_layout_, 0, 1, &descriptor_set,
+                                         0, nullptr);
+  ResolveUpscaleConstants constants = {};
+  constants.scale_area = draw_resolution_scale_x() * draw_resolution_scale_y();
+  constants.pixel_size_log2 = pixel_size_log2;
+  constants.source_offset_bytes = start_unscaled - source_start;
+  constants.scale_x = draw_resolution_scale_x();
+  constants.scale_y = draw_resolution_scale_y();
+  constants.valid_first = 0;
+  constants.valid_end = source_length;
+  command_processor_.SubmitBarriers(true);
+  constexpr uint32_t kGroupSize = 64;
+  constexpr uint32_t kMaxGroupCount = 65535;
+  // The segments write disjoint dwords, no barriers needed between them.
+  for (uint32_t i = 0; i < segment_count; ++i) {
+    const UpscaleSegment& segment = segments[i];
+    uint32_t dword_begin =
+        uint32_t((uint64_t(segment.start - start_unscaled) * constants.scale_area) >> 2);
+    uint32_t dword_end = uint32_t(
+        (uint64_t(segment.start + segment.length - start_unscaled) * constants.scale_area) >> 2);
+    constants.dest_dword_count = dword_end;
+    constants.filter = segment.surface ? 1 : 0;
+    if (segment.surface) {
+      constants.surface_offset_bytes = int32_t(segment.surface->base) - int32_t(source_start);
+      constants.surface_pitch = segment.surface->pitch;
+      constants.surface_width = segment.surface->width;
+      constants.surface_height = segment.surface->height;
+      constants.surface_tiled = segment.surface->tiled ? 1 : 0;
+    }
+    for (uint32_t dword_first = dword_begin; dword_first < dword_end;
+         dword_first += kGroupSize * kMaxGroupCount) {
+      constants.dest_dword_first = dword_first;
+      command_buffer.CmdVkPushConstants(resolve_upscale_pipeline_layout_,
+                                        VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(constants),
+                                        &constants);
+      command_buffer.CmdVkDispatch(
+          std::min((dword_end - dword_first + (kGroupSize - 1)) / kGroupSize, kMaxGroupCount), 1,
+          1);
+    }
+  }
+  return true;
+}
