+void LogIntegerTextureFetches(const RegisterFile& regs, const Shader& shader) {
+  if (!REXCVAR_GET(integer_fetch_log)) {
+    return;
+  }
+  // Bounded so a game cycling through texture sizes can't grow this forever.
+  constexpr size_t kMaxLogged = 512;
+  static std::mutex logged_mutex;
+  static std::unordered_set<std::string> logged;
+  for (const Shader::TextureBinding& binding : shader.texture_bindings()) {
+    xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(binding.fetch_constant);
+    if (!fetch.num_format) {
+      continue;
+    }
+    uint32_t width = 0, height = 0, depth = 0;
+    switch (fetch.dimension) {
+      case xenos::DataDimension::k1D:
+        width = fetch.size_1d.width + 1;
+        height = 1;
+        depth = 1;
+        break;
+      case xenos::DataDimension::k3D:
+        width = fetch.size_3d.width + 1;
+        height = fetch.size_3d.height + 1;
+        depth = fetch.size_3d.depth + 1;
+        break;
+      default:
+        width = fetch.size_2d.width + 1;
+        height = fetch.size_2d.height + 1;
+        depth = fetch.size_2d.stack_depth + 1;
+        break;
+    }
+    uint32_t format = uint32_t(fetch.format);
+    std::string key = fmt::format("{:016X}/{}/{}/{}{}{}{}/{}x{}x{}", shader.ucode_data_hash(),
+                                  binding.fetch_constant, format, uint32_t(fetch.sign_x),
+                                  uint32_t(fetch.sign_y), uint32_t(fetch.sign_z),
+                                  uint32_t(fetch.sign_w), width, height, depth);
+    {
+      std::lock_guard<std::mutex> lock(logged_mutex);
+      if (logged.size() >= kMaxLogged || !logged.insert(key).second) {
+        continue;
